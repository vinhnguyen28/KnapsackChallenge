<UserControl x:Class="KnapsackChallenge.UI.Features.Auth.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <!-- =========================================================
         Bo cuc 2 cot - DOI XUNG voi LoginView de khong bi "nhay"
         khi dieu huong. Wordmark + illustration ben trai, form ben phai.

         KHAC BIET voi LoginView:
           - Nen ngoai dung BrushBackgroundAlt (#E4DDC8 - be dam hon)
             de nguoi dung nhan ra ngay dang o man Dang ky chu khong
             phai Dang nhap.
           - Chi co ErrorBanner (RegisterViewModel khong co InfoMessage).

         LUU Y QUAN TRONG:
           - PasswordBox x:Name="txtPassword" va "txtConfirmPassword"
             PHAI giu dung ten + su kien PasswordChanged vi
             RegisterView.xaml.cs push gia tri sang ViewModel
             (PasswordBox khong Binding truc tiep duoc).
         ========================================================= -->
    <Grid Background="{DynamicResource BrushBackgroundAlt}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="440"/>
        </Grid.ColumnDefinitions>

        <!-- =========================================================
             COT TRAI - BRAND (cung bo cuc voi LoginView)
             ========================================================= -->
        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="72,0,40,0">

            <Path Data="{DynamicResource IllustrationKnapsack}"
                  Stroke="{DynamicResource BrushInkMuted}"
                  StrokeThickness="2"
                  Fill="Transparent"
                  Stretch="Uniform"
                  Width="150" Height="150"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,32"/>

            <TextBlock Text="KNAPSACK"
                       FontFamily="{DynamicResource FontMono}"
                       FontSize="32"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushInk}"/>

            <TextBlock Text="CHALLENGE"
                       FontFamily="{DynamicResource FontMono}"
                       FontSize="12"
                       FontWeight="Regular"
                       Foreground="{DynamicResource BrushInkMuted}"
                       Margin="0,2,0,0"/>

            <Rectangle Height="1" Width="64"
                       Fill="{DynamicResource BrushRule}"
                       HorizontalAlignment="Left"
                       Margin="0,24,0,24"/>

            <TextBlock Text="Tao tai khoan de bat dau chinh phuc cac bo de ba lo."
                       FontFamily="{DynamicResource FontSans}"
                       FontSize="14"
                       Foreground="{DynamicResource BrushInkMuted}"
                       TextWrapping="Wrap"
                       MaxWidth="380"
                       HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- =========================================================
             COT PHAI - FORM DANG KY
             ========================================================= -->
        <Border Grid.Column="1"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushRule}"
                BorderThickness="1,0,0,0">
            <StackPanel VerticalAlignment="Center" Margin="44,0">

                <TextBlock Text="Dang ky"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushInk}"/>

                <Rectangle Height="1"
                           Fill="{DynamicResource BrushRule}"
                           Margin="0,14,0,24"/>

                <!-- Tai khoan -->
                <TextBlock Text="Tai khoan"
                           Style="{DynamicResource FieldLabel}"/>
                <TextBox Style="{DynamicResource DarkTextBox}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Tag="username"/>

                <!-- Mat khau - event handler Password_Changed do code-behind gan,
                     KHONG doi ten -->
                <TextBlock Text="Mat khau"
                           Style="{DynamicResource FieldLabel}"
                           Margin="0,14,0,6"/>
                <PasswordBox x:Name="txtPassword"
                             Style="{DynamicResource InputPasswordBox}"
                             PasswordChanged="Password_Changed"/>

                <!-- Nhap lai mat khau -->
                <TextBlock Text="Nhap lai mat khau"
                           Style="{DynamicResource FieldLabel}"
                           Margin="0,14,0,6"/>
                <PasswordBox x:Name="txtConfirmPassword"
                             Style="{DynamicResource InputPasswordBox}"
                             PasswordChanged="ConfirmPassword_Changed"/>

                <!-- =========================================================
                     KHU VUC THONG BAO - CHIEU CAO CO DINH
                     Giong LoginView: bao ve nut "Dang ky" khoi bi day
                     khi banner xuat hien.
                     Chi co ErrorBanner (RegisterViewModel khong co InfoMessage).
                     ========================================================= -->
                <Grid MinHeight="54" Margin="0,16,0,0">
                    <Border Style="{DynamicResource ErrorBanner}"
                            Margin="0"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="12"
                                   Foreground="{DynamicResource BrushDanger}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>

                <!-- Hanh dong chinh -->
                <Button Content="Dang ky"
                        Command="{Binding RegisterCommand}"
                        Style="{DynamicResource ButtonPrimary}"
                        Margin="0,8,0,0"/>

                <!-- Quay lai dang nhap -->
                <Button Content="Da co tai khoan? Quay lai dang nhap"
                        Command="{Binding BackToLoginCommand}"
                        Style="{DynamicResource ButtonGhost}"
                        Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>