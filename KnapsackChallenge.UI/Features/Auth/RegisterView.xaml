<UserControl x:Class="KnapsackChallenge.UI.Features.Auth.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <!-- =========================================================
         Bố cục 2 cột — ĐỐI XỨNG với LoginView để không bị "nhảy"
         khi điều hướng. Wordmark + illustration bên trái, form bên phải.

         LƯU Ý QUAN TRỌNG:
           - PasswordBox x:Name="txtPassword" và "txtConfirmPassword"
             PHẢI giữ đúng tên + sự kiện PasswordChanged vì
             RegisterView.xaml.cs push giá trị sang ViewModel
             (PasswordBox không Binding trực tiếp được).
           - RegisterViewModel KHÔNG có InfoMessage, chỉ có ErrorMessage,
             nên chỉ dùng ErrorBanner.
         ========================================================= -->
    <Grid Background="{DynamicResource BrushBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="440"/>
        </Grid.ColumnDefinitions>

        <!-- =========================================================
             CỘT TRÁI — BRAND (giống LoginView để đồng bộ nhận diện)
             ========================================================= -->
        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="72,0,40,0">

            <Path Data="{DynamicResource IllustrationKnapsack}"
                  Stroke="{DynamicResource BrushInkMuted}"
                  StrokeThickness="2"
                  Fill="Transparent"
                  Stretch="Uniform"
                  Width="150" Height="150"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,32"/>

            <TextBlock Text="KNAPSACK"
                       FontFamily="{DynamicResource FontMono}"
                       FontSize="32"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushInk}"/>

            <TextBlock Text="CHALLENGE"
                       FontFamily="{DynamicResource FontMono}"
                       FontSize="12"
                       FontWeight="Regular"
                       Foreground="{DynamicResource BrushInkMuted}"
                       Margin="0,2,0,0"/>

            <Rectangle Height="1" Width="64"
                       Fill="{DynamicResource BrushRule}"
                       HorizontalAlignment="Left"
                       Margin="0,24,0,24"/>

            <TextBlock Text="Tạo tài khoản để bắt đầu chinh phục các bộ đề ba lô."
                       FontFamily="{DynamicResource FontSans}"
                       FontSize="14"
                       Foreground="{DynamicResource BrushInkMuted}"
                       TextWrapping="Wrap"
                       MaxWidth="380"
                       HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- =========================================================
             CỘT PHẢI — FORM ĐĂNG KÝ
             ========================================================= -->
        <Border Grid.Column="1"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushRule}"
                BorderThickness="1,0,0,0">
            <StackPanel VerticalAlignment="Center" Margin="44,0">

                <TextBlock Text="Đăng ký"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushInk}"/>

                <Rectangle Height="1"
                           Fill="{DynamicResource BrushRule}"
                           Margin="0,14,0,24"/>

                <!-- Tài khoản -->
                <TextBlock Text="Tài khoản"
                           Style="{DynamicResource FieldLabel}"/>
                <TextBox Style="{DynamicResource DarkTextBox}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Tag="username"/>

                <!-- Mật khẩu — event handler Password_Changed do code-behind gắn,
                     KHÔNG đổi tên -->
                <TextBlock Text="Mật khẩu"
                           Style="{DynamicResource FieldLabel}"
                           Margin="0,14,0,6"/>
                <PasswordBox x:Name="txtPassword"
                             Style="{DynamicResource InputPasswordBox}"
                             PasswordChanged="Password_Changed"/>

                <!-- Nhập lại mật khẩu -->
                <TextBlock Text="Nhập lại mật khẩu"
                           Style="{DynamicResource FieldLabel}"
                           Margin="0,14,0,6"/>
                <PasswordBox x:Name="txtConfirmPassword"
                             Style="{DynamicResource InputPasswordBox}"
                             PasswordChanged="ConfirmPassword_Changed"/>

                <!-- Chỉ có banner lỗi (RegisterViewModel không có InfoMessage) -->
                <Border Style="{DynamicResource ErrorBanner}"
                        Margin="0,16,0,0">
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="12"
                               Foreground="{DynamicResource BrushDanger}"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Hành động chính -->
                <Button Content="Đăng ký"
                        Command="{Binding RegisterCommand}"
                        Style="{DynamicResource ButtonPrimary}"
                        Margin="0,20,0,0"/>

                <!-- Quay lại đăng nhập -->
                <Button Content="Đã có tài khoản? Quay lại đăng nhập"
                        Command="{Binding BackToLoginCommand}"
                        Style="{DynamicResource ButtonGhost}"
                        Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>