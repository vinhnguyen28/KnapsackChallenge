<UserControl x:Class="KnapsackChallenge.UI.Features.Auth.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="960" PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Rectangle x:Name="BackgroundLayer" Fill="{StaticResource HomeBackdropFallback}"/>
        <Rectangle Fill="{StaticResource HomeOverlay}"/>

        <Grid x:Name="LayoutRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="BrandCol" Width="*"/>
                <ColumnDefinition x:Name="FormCol" Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="BrandPanel" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="64,0,32,0" MaxWidth="480">
                <Path Data="{DynamicResource IllustrationKnapsack}" Stroke="{StaticResource HomeTextOnDarkMuted}" StrokeThickness="2" Fill="Transparent" Stretch="Uniform" Width="140" Height="140" HorizontalAlignment="Left" Margin="0,0,0,28"/>
                <TextBlock Text="KNAPSACK" Style="{StaticResource AuthWordmark}"/>
                <TextBlock Text="CHALLENGE" Style="{StaticResource AuthBrandSubline}"/>
                <Rectangle Height="1" Width="64" Fill="{StaticResource HomeGlassBorder}" HorizontalAlignment="Left" Margin="0,22,0,20"/>
                <TextBlock Text="Tạo tài khoản để bắt đầu chinh phục các bộ đề ba lô." Style="{StaticResource AuthBrandTagline}" MaxWidth="380" Margin="0,0,0,22"/>
                <StackPanel>
                    <TextBlock Text="•   Miễn phí, không cần thanh toán" Style="{StaticResource AuthFeatureItem}"/>
                    <TextBlock Text="•   Lưu tiến độ và thành tích" Style="{StaticResource AuthFeatureItem}"/>
                    <TextBlock Text="•   Thi đấu cùng bạn bè" Style="{StaticResource AuthFeatureItem}"/>
                </StackPanel>
            </StackPanel>

            <Border x:Name="FormCard" Grid.Column="1" Width="440" Margin="0,24,32,24" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="FormTranslate"/>
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AuthCard}">
                        <Setter Property="Padding" Value="26,22"/>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <TextBlock Text="ĐĂNG KÝ" Style="{StaticResource AuthTitle}"/>
                    <TextBlock Text="Tạo tài khoản mới để bắt đầu." Style="{StaticResource AuthSubtitle}" Margin="0,4,0,0"/>
                    <Rectangle Height="1" Fill="{StaticResource HomeGlassBorder}" Margin="0,12,0,14"/>

                    <TextBlock Text="Tài khoản" Style="{StaticResource AuthFieldLabel}"/>
                    <Grid Margin="0,0,0,2">
                        <TextBox x:Name="txtUsername" Style="{StaticResource AuthTextBoxUser}" Padding="18,0,14,0" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" TextChanged="Username_TextChanged"/>
                        <Path Data="{StaticResource IconUserCircle}" Stroke="{StaticResource HomeTextOnDarkMuted}" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock x:Name="UsernamePlaceholder" Text="Nhập tài khoản (3–50 ký tự)" Foreground="{StaticResource HomeTextOnDarkMuted}" Opacity="0.6" VerticalAlignment="Center" Margin="40,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <TextBlock x:Name="UsernameHint" Text="3–50 ký tự" Style="{StaticResource AuthFieldHint}"/>

                    <Grid Margin="2,10,0,5">
                        <TextBlock Text="Mật khẩu" Style="{StaticResource AuthFieldLabel}" Margin="0"/>
                        <TextBlock x:Name="PasswordCapsWarning" Text="Caps Lock đang bật" FontFamily="{StaticResource AuthFontSans}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Foreground="#FCD34D" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>

                    <Grid>
                        <PasswordBox x:Name="txtPassword" Style="{StaticResource AuthPasswordBoxLock}" Padding="18,0,40,0"
                                     PasswordChanged="Password_Changed" GotKeyboardFocus="Password_GotKeyboardFocus" LostKeyboardFocus="Password_LostKeyboardFocus" PreviewKeyDown="Password_PreviewKeyDown" PreviewKeyUp="Password_PreviewKeyUp"/>

                        <TextBox x:Name="txtPasswordVisible" Style="{StaticResource AuthTextBoxLock}" Padding="18,0,40,0" Visibility="Collapsed"
                                 TextChanged="PasswordVisible_TextChanged" GotKeyboardFocus="Password_GotKeyboardFocus" LostKeyboardFocus="Password_LostKeyboardFocus" PreviewKeyDown="Password_PreviewKeyDown" PreviewKeyUp="Password_PreviewKeyUp"/>

                        <Path Data="{StaticResource AuthIconLock}" Stroke="{StaticResource HomeTextOnDarkMuted}" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"/>

                        <TextBlock x:Name="PasswordPlaceholder" Text="Nhập mật khẩu" Foreground="{StaticResource HomeTextOnDarkMuted}" Opacity="0.6" VerticalAlignment="Center" Margin="40,0,0,0" IsHitTestVisible="False"/>

                        <ToggleButton x:Name="btnPasswordToggle" Style="{StaticResource AuthPasswordToggleButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                      Checked="PasswordToggle_Checked" Unchecked="PasswordToggle_Unchecked" ToolTip="Hiện / ẩn mật khẩu"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="2,4,0,0">
                        <Border x:Name="StrengthBar" Width="48" Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StrengthLabel" FontFamily="{StaticResource AuthFontSans}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource HomeTextOnDarkMuted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="2,10,0,5">
                        <TextBlock Text="Nhập lại mật khẩu" Style="{StaticResource AuthFieldLabel}" Margin="0"/>
                        <TextBlock x:Name="ConfirmCapsWarning" Text="Caps Lock đang bật" FontFamily="{StaticResource AuthFontSans}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Foreground="#FCD34D" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>

                    <Grid>
                        <PasswordBox x:Name="txtConfirmPassword" Style="{StaticResource AuthPasswordBoxLock}" Padding="18,0,40,0"
                                     PasswordChanged="ConfirmPassword_Changed" GotKeyboardFocus="Password_GotKeyboardFocus" LostKeyboardFocus="Password_LostKeyboardFocus" PreviewKeyDown="Password_PreviewKeyDown" PreviewKeyUp="Password_PreviewKeyUp"/>

                        <TextBox x:Name="txtConfirmPasswordVisible" Style="{StaticResource AuthTextBoxLock}" Padding="18,0,40,0" Visibility="Collapsed"
                                 TextChanged="ConfirmPasswordVisible_TextChanged" GotKeyboardFocus="Password_GotKeyboardFocus" LostKeyboardFocus="Password_LostKeyboardFocus" PreviewKeyDown="Password_PreviewKeyDown" PreviewKeyUp="Password_PreviewKeyUp"/>

                        <Path Data="{StaticResource AuthIconLock}" Stroke="{StaticResource HomeTextOnDarkMuted}" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"/>

                        <TextBlock x:Name="ConfirmPasswordPlaceholder" Text="Nhập lại mật khẩu" Foreground="{StaticResource HomeTextOnDarkMuted}" Opacity="0.6" VerticalAlignment="Center" Margin="40,0,0,0" IsHitTestVisible="False"/>

                        <ToggleButton x:Name="btnConfirmToggle" Style="{StaticResource AuthPasswordToggleButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                      Checked="ConfirmToggle_Checked" Unchecked="ConfirmToggle_Unchecked" ToolTip="Hiện / ẩn mật khẩu"/>
                    </Grid>

                    <TextBlock x:Name="MatchLabel" Text="" FontFamily="{StaticResource AuthFontSans}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource HomeTextOnDarkMuted}" Margin="2,4,0,0"/>

                    <Grid Height="54" Margin="0,10,0,0">
                        <Border x:Name="ErrorBanner">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource AuthBannerError}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconWarning}" Width="14" Height="14" Stroke="#F87171" StrokeThickness="2.0" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding ErrorMessage}" FontFamily="{StaticResource AuthFontSans}" FontSize="{StaticResource FontSizeSmall}" Foreground="#FCA5A5" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="320"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Button Command="{Binding RegisterCommand}" Style="{StaticResource AuthPrimaryButton}" IsDefault="True" Margin="0,4,0,0">
                        <Grid>
                            <TextBlock Text="Đăng ký" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Path x:Name="BtnRegisterSpinner" Data="M 8,0 A 8,8 0 1 1 7.99,0" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="RegisterSpinnerRotate" Angle="0"/>
                                </Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="RegisterSpinnerRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.8"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>
                        </Grid>
                    </Button>

                    <Button Content="Đã có tài khoản? Quay lại đăng nhập" Command="{Binding BackToLoginCommand}" Style="{StaticResource AuthLinkButton}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>