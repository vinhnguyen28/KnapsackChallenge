<UserControl x:Class="KnapsackChallenge.UI.Features.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <!-- =========================================================
         Bo cuc 2 cot kieu "Cargo Manifest":
           - Cot trai: brand panel (wordmark mono + illustration + mo ta)
           - Cot phai: form dang nhap tren nen Surface, vien Rule ben trai
         DataContext (LoginViewModel) do MainWindow.xaml gan.
         ========================================================= -->
    <Grid Background="{DynamicResource BrushBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="440"/>
        </Grid.ColumnDefinitions>

        <!-- =========================================================
             COT TRAI - BRAND
             ========================================================= -->
        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="72,0,40,0">

            <!-- Minh hoa vector: balo, stroke manh, KHONG to mau -->
            <Path Data="{DynamicResource IllustrationKnapsack}"
                  Stroke="{DynamicResource BrushInkMuted}"
                  StrokeThickness="2"
                  Fill="Transparent"
                  Stretch="Uniform"
                  Width="150" Height="150"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,32"/>

            <!-- Wordmark: font mono, mang tinh "stamp"/"manifest" -->
            <TextBlock Text="KNAPSACK"
                       FontFamily="{DynamicResource FontMono}"
                       FontSize="32"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushInk}"/>

            <TextBlock Text="CHALLENGE"
                       FontFamily="{DynamicResource FontMono}"
                       FontSize="12"
                       FontWeight="Regular"
                       Foreground="{DynamicResource BrushInkMuted}"
                       Margin="0,2,0,0"/>

            <!-- Rule ngang ngan -->
            <Rectangle Height="1" Width="64"
                       Fill="{DynamicResource BrushRule}"
                       HorizontalAlignment="Left"
                       Margin="0,24,0,24"/>

            <TextBlock Text="Bai toan ba lo kinh dien. Chon to hop vat pham toi uu trong gioi han khoi luong."
                       FontFamily="{DynamicResource FontSans}"
                       FontSize="14"
                       Foreground="{DynamicResource BrushInkMuted}"
                       TextWrapping="Wrap"
                       MaxWidth="380"
                       HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- =========================================================
             COT PHAI - FORM DANG NHAP
             ========================================================= -->
        <Border Grid.Column="1"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushRule}"
                BorderThickness="1,0,0,0">
            <StackPanel VerticalAlignment="Center" Margin="44,0">

                <TextBlock Text="Dang nhap"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushInk}"/>

                <Rectangle Height="1"
                           Fill="{DynamicResource BrushRule}"
                           Margin="0,14,0,24"/>

                <!-- O nhap tai khoan - Binding giu nguyen -->
                <TextBlock Text="Tai khoan"
                           Style="{DynamicResource FieldLabel}"/>
                <TextBox Style="{DynamicResource DarkTextBox}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Tag="username"/>

                <!-- O mat khau - x:Name=txtPassword BAT BUOC giu vi
                     CommandParameter cua LoginCommand tham chieu qua
                     ElementName=txtPassword (PasswordBox khong Binding duoc) -->
                <TextBlock Text="Mat khau"
                           Style="{DynamicResource FieldLabel}"
                           Margin="0,16,0,6"/>
                <PasswordBox x:Name="txtPassword"
                             Style="{DynamicResource InputPasswordBox}"/>

                <!-- =========================================================
                     KHU VUC THONG BAO - CHIEU CAO CO DINH

                     Ly do: neu de banner tu an/hien tu nhien (Collapsed),
                     nut "Dang nhap" ben duoi se bi day xuong moi khi co loi
                     -> layout giat. Giai phap: boc 2 banner vao cung 1 Grid,
                     dat MinHeight co dinh = 54px (du cho 2 dong text 12px
                     + padding). Khi banner trong, Grid van giu 54px ->
                     nut khong bao gio bi day.

                     Hai banner chong len nhau trong cung o Grid, nhung
                     LoginViewModel dam bao chi 1 trong 2 co noi dung tai
                     mot thoi diem (ExecuteLogin luon reset InfoMessage = ""
                     truoc khi set ErrorMessage).
                     ========================================================= -->
                <Grid MinHeight="54" Margin="0,18,0,0">
                    <Border Style="{DynamicResource InfoBanner}"
                            Margin="0"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding InfoMessage}"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="12"
                                   Foreground="{DynamicResource BrushSuccess}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border Style="{DynamicResource ErrorBanner}"
                            Margin="0"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="12"
                                   Foreground="{DynamicResource BrushDanger}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>

                <!-- Hanh dong chinh - Accent duy nhat tren man nay -->
                <Button Content="Dang nhap"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=txtPassword}"
                        Style="{DynamicResource ButtonPrimary}"
                        Margin="0,8,0,0"/>

                <!-- Chuyen sang Dang ky -->
                <Button Content="Chua co tai khoan? Dang ky"
                        Command="{Binding RegisterCommand}"
                        Style="{DynamicResource ButtonGhost}"
                        Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>