<UserControl x:Class="KnapsackChallenge.UI.Features.Admin.SetManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="1100"
             Background="{DynamicResource BrushBackground}">

    <Grid Margin="20,16,20,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- =========================================================
             COT TRAI: form CRUD + danh sach bo de
             ========================================================= -->
        <Border Grid.Column="0"
                Style="{DynamicResource Card}"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ============ FORM ============ -->
                <StackPanel Grid.Row="0">

                    <TextBlock Text="{Binding FormTitle}"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushInk}"
                               TextWrapping="Wrap"/>

                    <Rectangle Height="1"
                               Fill="{DynamicResource BrushRule}"
                               Margin="0,10,0,14"/>

                    <!-- Ten bo de -->
                    <TextBlock Text="Tên bộ đề"
                               Style="{DynamicResource FieldLabel}"/>
                    <TextBox Style="{DynamicResource DarkTextBox}"
                             Tag="Ví dụ: Bộ đề dễ"
                             Text="{Binding SetName, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Max weight + Do kho -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Max weight"
                                       Style="{DynamicResource FieldLabel}"/>
                            <TextBox Style="{DynamicResource DarkTextBox}"
                                     Tag="0"
                                     Text="{Binding MaxWeightText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Độ khó"
                                       Style="{DynamicResource FieldLabel}"/>
                            <ComboBox Style="{DynamicResource DarkComboBox}"
                                      ItemsSource="{Binding DifficultyOptions}"
                                      SelectedItem="{Binding Difficulty, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <!-- =========================================================
                         KHU VUC THONG BAO - CHIEU CAO CO DINH (54px)
                         ========================================================= -->
                    <Grid MinHeight="54" Margin="0,14,0,0">
                        <Border Style="{DynamicResource InfoBanner}"
                                Margin="0"
                                VerticalAlignment="Top">
                            <TextBlock Text="{Binding InfoMessage}"
                                       FontFamily="{DynamicResource FontSans}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource BrushSuccess}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <Border Style="{DynamicResource ErrorBanner}"
                                Margin="0"
                                VerticalAlignment="Top">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       FontFamily="{DynamicResource FontSans}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource BrushDanger}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </Grid>

                    <!-- CRUD buttons -->
                    <Button Command="{Binding AddSetCommand}"
                            Style="{DynamicResource ButtonSecondary}"
                            Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconAdd}"
                                  Width="14" Height="14"
                                  Stroke="{Binding Foreground,
                                           RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Thêm bộ đề" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding UpdateSetCommand}"
                            Style="{DynamicResource ButtonSecondary}"
                            Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconSave}"
                                  Width="14" Height="14"
                                  Stroke="{Binding Foreground,
                                           RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Lưu thay đổi" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DeleteSetCommand}"
                            Style="{DynamicResource ButtonDanger}"
                            Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconDelete}"
                                  Width="14" Height="14"
                                  Stroke="{Binding Foreground,
                                           RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Xóa bộ đề" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Content="Làm mới form"
                            Command="{Binding ClearSetFormCommand}"
                            Style="{DynamicResource ButtonGhost}"
                            Margin="0,0,0,16"/>
                </StackPanel>

                <!-- ============ LABEL DANH SACH ============ -->
                <TextBlock Grid.Row="1"
                           Text="Danh sách bộ đề"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushInkMuted}"
                           Margin="0,0,0,8"/>

                <!-- ============ LIST BO DE ============ -->
                <Border Grid.Row="2"
                        Background="{DynamicResource BrushBackground}"
                        BorderBrush="{DynamicResource BrushRule}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="4">
                    <Grid>
                        <ListBox ItemsSource="{Binding Sets}"
                                 SelectedItem="{Binding SelectedSet, Mode=TwoWay}"
                                 Style="{DynamicResource DarkListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SetName}"
                                                       FontFamily="{DynamicResource FontSans}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock FontFamily="{DynamicResource FontMono}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource BrushInkMuted}"
                                                       Margin="0,2,0,0">
                                                <Run Text="#"/>
                                                <Run Text="{Binding Id}"/>
                                                <Run Text="  ·  Max "/>
                                                <Run Text="{Binding MaxWeight}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Stamp do kho -->
                                        <Border Grid.Column="1"
                                                Padding="6,2"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                Background="Transparent"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource BrushRule}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Difficulty}" Value="Easy">
                                                            <Setter Property="BorderBrush"
                                                                    Value="{DynamicResource BrushSuccess}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Difficulty}" Value="Medium">
                                                            <Setter Property="BorderBrush"
                                                                    Value="{DynamicResource BrushWarning}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Difficulty}" Value="Hard">
                                                            <Setter Property="BorderBrush"
                                                                    Value="{DynamicResource BrushDanger}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <TextBlock Text="{Binding Difficulty}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource MonoCaptionTextStyle}">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource BrushInkMuted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Difficulty}" Value="Easy">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource BrushSuccess}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Difficulty}" Value="Medium">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource BrushWarning}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Difficulty}" Value="Hard">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource BrushDanger}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty state: chua co bo de nao -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Sets.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Path Data="{DynamicResource IconTagStack}"
                                  Width="32" Height="32"
                                  Stroke="{DynamicResource BrushInkMuted}"
                                  StrokeThickness="1.2"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  Opacity="0.5"/>

                            <TextBlock Text="Chưa có bộ đề nào"
                                       FontFamily="{DynamicResource FontSans}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource BrushInkMuted}"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- =========================================================
             COT PHAI: 2-list picker + nut luu
             ========================================================= -->
        <Border Grid.Column="2"
                Style="{DynamicResource Card}"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============ HEADER + SUMMARY ============ -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Gán vật phẩm cho bộ đề"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushInkMuted}"/>

                        <TextBlock Text="{Binding TotalSummaryText}"
                                   FontFamily="{DynamicResource FontMono}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource BrushInk}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Badge vuot max weight - giu binding IsOverWeight + BoolToVisibility -->
                    <Border Grid.Column="1"
                            Padding="8,3"
                            BorderThickness="1"
                            CornerRadius="2"
                            Background="{DynamicResource BrushDangerSoft}"
                            BorderBrush="{DynamicResource BrushDanger}"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsOverWeight,
                                         Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Vượt max weight"
                                   FontFamily="{DynamicResource FontMono}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushDanger}"/>
                    </Border>
                </Grid>

                <!-- ============ 2-LIST PICKER ============ -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== KHO VAT PHAM (trai) ===== -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource BrushBackground}"
                            BorderBrush="{DynamicResource BrushRule}"
                            BorderThickness="1"
                            CornerRadius="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Label -->
                            <Border Grid.Row="0"
                                    BorderBrush="{DynamicResource BrushRule}"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,8">
                                <TextBlock Text="Kho vật phẩm"
                                           FontFamily="{DynamicResource FontSans}"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushInkMuted}"/>
                            </Border>

                            <!-- Search -->
                            <Border Grid.Row="1"
                                    BorderBrush="{DynamicResource BrushRule}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8">
                                <TextBox Style="{DynamicResource DarkTextBox}"
                                         Tag="Tìm..."
                                         Text="{Binding AvailableSearch, UpdateSourceTrigger=PropertyChanged}"/>
                            </Border>

                            <!-- List -->
                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding AvailableItems}"
                                     SelectedItem="{Binding AvailableSelected, Mode=TwoWay}"
                                     Style="{DynamicResource DarkListBox}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontFamily="{DynamicResource FontSans}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Column="1"
                                                       FontFamily="{DynamicResource FontMono}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource BrushInkMuted}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0">
                                                <Run Text="{Binding Weight}"/>
                                                <Run Text="kg · "/>
                                                <Run Text="{Binding Value}"/>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- ===== NUT DI CHUYEN (giua) ===== -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <Button Command="{Binding AddItemCommand}"
                                Style="{DynamicResource ButtonPrimary}"
                                Width="38" Height="32"
                                Padding="0"
                                Margin="0,0,0,6"
                                ToolTip="Thêm vật phẩm đang chọn vào bộ đề">
                            <Path Data="{DynamicResource IconChevronRight}"
                                  Width="14" Height="14"
                                  Stroke="{Binding Foreground,
                                           RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  Stretch="Uniform"/>
                        </Button>

                        <Button Command="{Binding RemoveItemCommand}"
                                Style="{DynamicResource ButtonSecondary}"
                                Width="38" Height="32"
                                Padding="0"
                                Margin="0,0,0,6"
                                ToolTip="Bỏ vật phẩm khỏi bộ đề">
                            <Path Data="{DynamicResource IconChevronLeft}"
                                  Width="14" Height="14"
                                  Stroke="{Binding Foreground,
                                           RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  Stretch="Uniform"/>
                        </Button>

                        <Button Command="{Binding AddAllCommand}"
                                Style="{DynamicResource ButtonSecondary}"
                                Width="38" Height="32"
                                Padding="0"
                                Margin="0,0,0,6"
                                ToolTip="Thêm tất cả">
                            <Path Data="{DynamicResource IconChevronRightDouble}"
                                  Width="14" Height="14"
                                  Stroke="{Binding Foreground,
                                           RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  Stretch="Uniform"/>
                        </Button>

                        <Button Command="{Binding RemoveAllCommand}"
                                Style="{DynamicResource ButtonSecondary}"
                                Width="38" Height="32"
                                Padding="0"
                                ToolTip="Bỏ tất cả">
                            <Path Data="{DynamicResource IconChevronLeftDouble}"
                                  Width="14" Height="14"
                                  Stroke="{Binding Foreground,
                                           RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  Stretch="Uniform"/>
                        </Button>
                    </StackPanel>

                    <!-- ===== VAT PHAM TRONG BO DE (phai) ===== -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource BrushBackground}"
                            BorderBrush="{DynamicResource BrushAccent}"
                            BorderThickness="1"
                            CornerRadius="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Label -->
                            <Border Grid.Row="0"
                                    BorderBrush="{DynamicResource BrushRule}"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,8">
                                <TextBlock Text="Trong bộ đề"
                                           FontFamily="{DynamicResource FontSans}"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushAccent}"/>
                            </Border>

                            <!-- Search -->
                            <Border Grid.Row="1"
                                    BorderBrush="{DynamicResource BrushRule}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8">
                                <TextBox Style="{DynamicResource DarkTextBox}"
                                         Tag="Tìm..."
                                         Text="{Binding SelectedSearch, UpdateSourceTrigger=PropertyChanged}"/>
                            </Border>

                            <!-- List -->
                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding SelectedItems}"
                                     SelectedItem="{Binding SelectedSelected, Mode=TwoWay}"
                                     Style="{DynamicResource DarkListBox}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontFamily="{DynamicResource FontSans}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Column="1"
                                                       FontFamily="{DynamicResource FontMono}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource BrushInkMuted}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0">
                                                <Run Text="{Binding Weight}"/>
                                                <Run Text="kg · "/>
                                                <Run Text="{Binding Value}"/>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ NUT LUU (action chinh cua man) ============ -->
                <Button Grid.Row="2"
                        Command="{Binding SaveItemsCommand}"
                        Style="{DynamicResource ButtonPrimary}"
                        Margin="0,16,0,0"
                        Padding="16,11">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource IconSave}"
                              Width="14" Height="14"
                              Stroke="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"/>
                        <TextBlock Text="Lưu danh sách vật phẩm cho bộ đề"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>