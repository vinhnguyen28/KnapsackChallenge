<UserControl x:Class="KnapsackChallenge.UI.Features.Admin.SetManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1100"
             Background="Transparent">

    <UserControl.Resources>

        <!-- ===== COMBOBOX dark theme ===== -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F2331"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2760"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{StaticResource InputBg}"
                                                BorderBrush="{StaticResource CardBorder}"
                                                BorderThickness="1" CornerRadius="9">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,12,0"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{StaticResource TextMuted}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#3A4157"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush"
                                                        Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,30,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border Background="{StaticResource CardBg}"
                                        BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="220">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== LIST BOX dark ===== -->
        <Style x:Key="DarkListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                        <Setter Property="Padding" Value="12,9"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="Transparent"
                                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#1F2331"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2A2760"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Nút chuyển item (>>, <<) ===== -->
        <Style x:Key="MoveButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             CỘT TRÁI: form + danh sách bộ đề
             ============================================================ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Form -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding FormTitle}" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource TextMain}" TextWrapping="Wrap"/>
                    <Border Height="3" Width="36" CornerRadius="2" HorizontalAlignment="Left"
                            Background="{StaticResource PrimaryGradient}" Margin="0,10,0,20"/>

                    <TextBlock Text="TÊN BỘ ĐỀ" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"
                             Tag="Ví dụ: Bộ đề dễ"
                             Text="{Binding SetName, UpdateSourceTrigger=PropertyChanged}"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MAX WEIGHT" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Tag="0"
                                     Text="{Binding MaxWeightText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ĐỘ KHÓ" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding DifficultyOptions}"
                                      SelectedItem="{Binding Difficulty, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource InfoBanner}">
                        <TextBlock Text="{Binding InfoMessage}" Foreground="#34D399"
                                   FontSize="13" TextWrapping="Wrap"/>
                    </Border>
                    <Border Style="{StaticResource ErrorBanner}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#F87171"
                                   FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <Button Content="＋  Thêm mới" Command="{Binding AddSetCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource PrimaryGradient}"/>
                    <Button Content="✓  Lưu thay đổi" Command="{Binding UpdateSetCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource SuccessGradient}"
                            Margin="0,10,0,0"/>
                    <Button Content="✕  Xóa bộ đề" Command="{Binding DeleteSetCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="#2C1217" BorderBrush="#7F2A38" BorderThickness="1"
                            Foreground="#F87171" Margin="0,10,0,0"/>
                    <Button Content="Làm mới form" Command="{Binding ClearSetFormCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="Transparent"
                            Foreground="{StaticResource TextMuted}" FontWeight="Normal"
                            Margin="0,10,0,20" Padding="8"/>
                </StackPanel>

                <!-- Danh sách bộ đề -->
                <TextBlock Grid.Row="1" Text="DANH SÁCH BỘ ĐỀ"
                           FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>

                <Border Grid.Row="2" Background="{StaticResource InputBg}"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                        CornerRadius="10" Padding="6">
                    <Grid>
                        <ListBox ItemsSource="{Binding Sets}"
                                 SelectedItem="{Binding SelectedSet, Mode=TwoWay}"
                                 Style="{StaticResource DarkListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding SetName}" FontWeight="SemiBold"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}"
                                                       Margin="0,2,0,0">
                                                <Run Text="#"/>
                                                <Run Text="{Binding Id}"/>
                                                <Run Text="  •  Max "/>
                                                <Run Text="{Binding MaxWeight}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="6" Padding="7,3"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1F2331"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Difficulty}" Value="Easy">
                                                            <Setter Property="Background" Value="#0F2A22"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Difficulty}" Value="Medium">
                                                            <Setter Property="Background" Value="#2A2410"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Difficulty}" Value="Hard">
                                                            <Setter Property="Background" Value="#2C1217"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Difficulty}" FontSize="10"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Difficulty}" Value="Easy">
                                                                <Setter Property="Foreground" Value="#34D399"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Difficulty}" Value="Medium">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Difficulty}" Value="Hard">
                                                                <Setter Property="Foreground" Value="#F87171"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Sets.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="📋" FontSize="32" HorizontalAlignment="Center" Opacity="0.5"/>
                            <TextBlock Text="Chưa có bộ đề nào" Foreground="{StaticResource TextMuted}"
                                       FontSize="13" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================
             CỘT PHẢI: 2-list picker
             ============================================================ -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header + stats -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="GÁN VẬT PHẨM CHO BỘ ĐỀ"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource TextMuted}"/>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding TotalSummaryText}"
                                   FontSize="14" Foreground="{StaticResource TextMain}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>

                        <Border Grid.Column="1" CornerRadius="8" Padding="10,5"
                                Background="#2C1217" BorderBrush="#5A1F2A" BorderThickness="1"
                                Visibility="{Binding IsOverWeight, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="⚠  Vượt max weight!" FontSize="11"
                                       FontWeight="SemiBold" Foreground="#FCA5A5"/>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- 2 list picker -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Kho vật phẩm -->
                    <Border Grid.Column="0" Background="{StaticResource InputBg}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="10" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="📦  KHO VẬT PHẨM"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>

                            <TextBox Grid.Row="1" Style="{StaticResource DarkTextBox}"
                                     Tag="🔍 Tìm..." Margin="0,0,0,10"
                                     Text="{Binding AvailableSearch, UpdateSourceTrigger=PropertyChanged}"/>

                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding AvailableItems}"
                                     SelectedItem="{Binding AvailableSelected, Mode=TwoWay}"
                                     Style="{StaticResource DarkListBox}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMuted}"
                                                       VerticalAlignment="Center">
                                                <Run Text="{Binding Weight}"/>
                                                <Run Text="kg  •  "/>
                                                <Run Text="{Binding Value}"/>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Nút di chuyển -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <Button Content="⟩" Command="{Binding AddItemCommand}"
                                Style="{StaticResource MoveButton}"
                                Background="{StaticResource PrimaryGradient}"
                                ToolTip="Thêm vật phẩm đang chọn vào bộ đề"/>
                        <Button Content="⟨" Command="{Binding RemoveItemCommand}"
                                Style="{StaticResource MoveButton}"
                                Background="#1F2331"
                                ToolTip="Bỏ vật phẩm khỏi bộ đề"/>
                        <Button Content="≫" Command="{Binding AddAllCommand}"
                                Style="{StaticResource MoveButton}"
                                Background="#1F2331"
                                ToolTip="Thêm tất cả"/>
                        <Button Content="≪" Command="{Binding RemoveAllCommand}"
                                Style="{StaticResource MoveButton}"
                                Background="#1F2331"
                                ToolTip="Bỏ tất cả"/>
                    </StackPanel>

                    <!-- Vật phẩm trong bộ đề -->
                    <Border Grid.Column="2" Background="{StaticResource InputBg}"
                            BorderBrush="{StaticResource Accent}" BorderThickness="1"
                            CornerRadius="10" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="✓  TRONG BỘ ĐỀ"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentCyan}" Margin="0,0,0,10"/>

                            <TextBox Grid.Row="1" Style="{StaticResource DarkTextBox}"
                                     Tag="🔍 Tìm..." Margin="0,0,0,10"
                                     Text="{Binding SelectedSearch, UpdateSourceTrigger=PropertyChanged}"/>

                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding SelectedItems}"
                                     SelectedItem="{Binding SelectedSelected, Mode=TwoWay}"
                                     Style="{StaticResource DarkListBox}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMuted}"
                                                       VerticalAlignment="Center">
                                                <Run Text="{Binding Weight}"/>
                                                <Run Text="kg  •  "/>
                                                <Run Text="{Binding Value}"/>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Nút lưu -->
                <Button Grid.Row="2" Content="💾  Lưu danh sách vật phẩm cho bộ đề"
                        Command="{Binding SaveItemsCommand}"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource SuccessGradient}"
                        Margin="0,16,0,0" Padding="16,12"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>