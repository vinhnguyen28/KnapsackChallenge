<UserControl x:Class="KnapsackChallenge.UI.Features.Admin.MainAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:admin="clr-namespace:KnapsackChallenge.UI.Features.Admin"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="{StaticResource AppBackgroundBrush}">

    <UserControl.Resources>
        <!-- Ánh xạ ViewModel -> View cho vùng nội dung bên phải -->
        <DataTemplate DataType="{x:Type admin:ItemManagementViewModel}">
            <admin:ItemManagementView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type admin:PlayerManagementViewModel}">
            <admin:PlayerManagementView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type admin:BanLogViewModel}">
            <admin:BanLogView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type admin:SetManagementViewModel}">
                <admin:SetManagementView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type admin:PlaceholderViewModel}">
            <admin:PlaceholderView />
        </DataTemplate>

        <!-- Style cho mục navbar -->
        <Style x:Key="NavListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Margin"  Value="8,2"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F2331"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2760"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Border Grid.Row="0" Background="#0F1119" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="0,0,0,1" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="42" Height="42" CornerRadius="11"
                        Background="{StaticResource PrimaryGradient}">
                    <Border.Effect>
                        <DropShadowEffect Color="#7C6CF5" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                    </Border.Effect>
                    <TextBlock Text="🎒" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Knapsack Admin" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextMain}"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0">
                        <Run Text="Xin chào,"/>
                        <Run Text="{Binding AdminUsername, Mode=OneWay}"
                             Foreground="{StaticResource AccentCyan}" FontWeight="SemiBold"/>
                        <Run Text="(Admin)"/>
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="2"
                        Command="{Binding LogoutCommand}"
                        Style="{StaticResource ModernButton}"
                        Background="Transparent"
                        BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1"
                        Foreground="{StaticResource TextMuted}"
                        FontWeight="Normal"
                        Padding="14,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⎋ " FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Đăng xuất" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ==================== BODY ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== NAVBAR DỌC ===== -->
            <Border Grid.Column="0" Background="#10121B"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="ĐIỀU HƯỚNG"
                               Foreground="#5B6376"
                               FontSize="10" FontWeight="Bold"
                               Margin="20,20,0,10"/>

                    <ListBox ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource NavListBoxItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="16" Width="28"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ===== VÙNG NỘI DUNG ===== -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentPage}"
                            Margin="0"/>
        </Grid>
    </Grid>
</UserControl>