<Window x:Class="KnapsackChallenge.UI.Features.Admin.Dialogs.BanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ban người chơi"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Border ngoai: bo goc 2px, vien Rule, bong rat nhe (chi cho dialog) -->
    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushRule}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12"
                              ShadowDepth="2"
                              Opacity="0.25"
                              Color="Black"/>
        </Border.Effect>

        <StackPanel Margin="22,18,22,18">

            <!-- Title + rule manh -->
            <TextBlock Text="Ban người chơi"
                       FontFamily="{DynamicResource FontSans}"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushInk}"/>

            <Rectangle Height="1"
                       Fill="{DynamicResource BrushRule}"
                       Margin="0,10,0,16"/>

            <!-- Nguoi choi bi ban -->
            <TextBlock Text="Người chơi"
                       Style="{DynamicResource FieldLabel}"/>
            <TextBlock x:Name="TargetUsernameText"
                       FontFamily="{DynamicResource FontMono}"
                       FontSize="{DynamicResource FontSizeBody}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushInk}"
                       Margin="0,0,0,14"/>

            <!-- Ly do ban -->
            <TextBlock Text="Lý do ban (bắt buộc, 5–500 ký tự)"
                       Style="{DynamicResource FieldLabel}"/>

            <!-- x:Name + TextChanged event giu nguyen -->
            <TextBox x:Name="ReasonBox"
                     Style="{DynamicResource InputTextArea}"
                     Height="100"
                     MaxLength="500"
                     TextChanged="ReasonBox_TextChanged"/>

            <!-- Counter + Error chong len nhau (giu nguyen layout cu) -->
            <Grid Margin="0,4,0,14">
                <TextBlock x:Name="ErrorText"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource BrushDanger}"
                           HorizontalAlignment="Left"
                           Visibility="Collapsed"/>

                <TextBlock x:Name="CounterText"
                           Text="0/500"
                           FontFamily="{DynamicResource FontMono}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushInkMuted}"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- Nut -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Hủy"
                        Click="Cancel_Click"
                        Style="{DynamicResource ButtonSecondary}"/>

                <Button Grid.Column="2"
                        Content="Xác nhận ban"
                        Click="Confirm_Click"
                        Style="{DynamicResource ButtonDanger}"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>