<Window x:Class="KnapsackChallenge.UI.Features.Admin.Dialogs.BanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ban người chơi"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Ô nhập NHIỀU DÒNG (khác DarkTextBox vốn dành cho 1 dòng) -->
        <Style x:Key="DarkTextArea" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentCyan}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{StaticResource InputBg}"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3A4157"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource CardBg}" CornerRadius="14" Margin="20"
            BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <StackPanel Margin="26">
            <TextBlock Text="🚫  Ban người chơi" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextMain}"/>
            <Border Height="3" Width="36" CornerRadius="2" HorizontalAlignment="Left"
                    Background="{StaticResource PrimaryGradient}" Margin="0,10,0,20"/>

            <TextBlock Text="Người chơi:" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="TargetUsernameText" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentCyan}" Margin="0,0,0,18"/>

            <TextBlock Text="LÝ DO BAN (bắt buộc, 5-500 ký tự)"
                       Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="ReasonBox"
                     Style="{StaticResource DarkTextArea}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="110"
                     MaxLength="500"
                     VerticalScrollBarVisibility="Auto"
                     TextChanged="ReasonBox_TextChanged"/>

            <Grid Margin="0,4,0,14">
                <TextBlock x:Name="CounterText" Text="0/500" FontSize="11"
                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#F87171"
                           HorizontalAlignment="Left" Visibility="Collapsed"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Hủy" Click="Cancel_Click"
                        Style="{StaticResource ModernButton}"
                        Background="Transparent" BorderThickness="1"
                        BorderBrush="{StaticResource CardBorder}"
                        Foreground="{StaticResource TextMuted}"/>
                <Button Grid.Column="2" Content="Xác nhận ban" Click="Confirm_Click"
                        Style="{StaticResource ModernButton}"
                        Background="#7F1D1D" Foreground="#FCA5A5"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>