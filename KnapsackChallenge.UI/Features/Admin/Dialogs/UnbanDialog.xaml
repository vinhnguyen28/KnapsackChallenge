<Window x:Class="KnapsackChallenge.UI.Features.Admin.Dialogs.UnbanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bỏ ban người chơi"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushRule}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12"
                              ShadowDepth="2"
                              Opacity="0.15"
                              Color="Black"/>
        </Border.Effect>

        <StackPanel Margin="22,18,22,18">

            <TextBlock Text="Bỏ ban người chơi"
                       FontFamily="{DynamicResource FontSans}"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushInk}"/>

            <Rectangle Height="1"
                       Fill="{DynamicResource BrushRule}"
                       Margin="0,10,0,16"/>

            <TextBlock Text="Bạn sắp bỏ ban cho"
                       Style="{DynamicResource FieldLabel}"/>
            <TextBlock x:Name="TargetUsernameText"
                       FontFamily="{DynamicResource FontMono}"
                       FontSize="{DynamicResource FontSizeBody}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushInk}"
                       Margin="0,0,0,14"/>

            <TextBlock Text="Ghi chú (tùy chọn, tối đa 500 ký tự)"
                       Style="{DynamicResource FieldLabel}"/>

            <TextBox x:Name="NoteBox"
                     Style="{DynamicResource DarkTextBox}"
                     MaxLength="500"
                     Margin="0,0,0,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Hủy"
                        Click="Cancel_Click"
                        Style="{DynamicResource ButtonSecondary}"/>

                <Button Grid.Column="2"
                        Content="Xác nhận bỏ ban"
                        Click="Confirm_Click"
                        Style="{DynamicResource ButtonPrimary}"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>