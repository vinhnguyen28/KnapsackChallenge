<Window x:Class="KnapsackChallenge.UI.Features.Admin.Dialogs.UnbanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bỏ ban người chơi"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource CardBg}" CornerRadius="14" Margin="20"
            BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <StackPanel Margin="26">
            <TextBlock Text="✓  Bỏ ban người chơi" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextMain}"/>
            <Border Height="3" Width="36" CornerRadius="2" HorizontalAlignment="Left"
                    Background="{StaticResource SuccessGradient}" Margin="0,10,0,20"/>

            <TextBlock Text="Bạn sắp bỏ ban cho:" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="TargetUsernameText" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentCyan}" Margin="0,0,0,16"/>

            <TextBlock Text="GHI CHÚ (tùy chọn, tối đa 500 ký tự)"
                       Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NoteBox"
                     Style="{StaticResource DarkTextBox}"
                     MaxLength="500"
                     Margin="0,0,0,18"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Hủy" Click="Cancel_Click"
                        Style="{StaticResource ModernButton}"
                        Background="Transparent" BorderThickness="1"
                        BorderBrush="{StaticResource CardBorder}"
                        Foreground="{StaticResource TextMuted}"/>
                <Button Grid.Column="2" Content="Xác nhận bỏ ban" Click="Confirm_Click"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource SuccessGradient}"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>