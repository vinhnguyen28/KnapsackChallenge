<Window x:Class="KnapsackChallenge.UI.Features.Admin.Dialogs.AchievementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thành tích người chơi"
        Width="760" Height="600"
        MinWidth="600" MinHeight="480"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource CardBg}" CornerRadius="14" Margin="20"
            BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="📊  Thành tích người chơi" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextMain}"/>
                    <TextBlock x:Name="UsernameText" FontSize="14"
                               Foreground="{StaticResource AccentCyan}"
                               FontWeight="SemiBold" Margin="0,6,0,0"/>
                </StackPanel>
                <Button Content="✕" Click="Close_Click"
                        Style="{StaticResource ModernButton}"
                        Background="Transparent" Foreground="{StaticResource TextMuted}"
                        Padding="12,6" FontSize="14"
                        HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>

            <Border Grid.Row="0" Height="3" Width="36" CornerRadius="2" HorizontalAlignment="Left"
                    Background="{StaticResource PrimaryGradient}" Margin="0,54,0,0" VerticalAlignment="Top"/>

            <!-- Cảnh báo ban (chỉ hiện khi bị ban) -->
            <Border x:Name="BanBanner" Grid.Row="1"
                    Background="#2C1217" BorderBrush="#5A1F2A" BorderThickness="1"
                    CornerRadius="8" Padding="12,9" Margin="0,18,0,6"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="BanHeaderText" FontWeight="SemiBold"
                               Foreground="#FCA5A5" FontSize="13"/>
                    <TextBlock x:Name="BanReasonText" Foreground="#F87171" FontSize="12"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Thông tin chung -->
            <TextBlock Grid.Row="2" x:Name="GeneralInfoText" FontSize="12"
                       Foreground="{StaticResource TextMuted}" Margin="0,10,0,14" TextWrapping="Wrap"/>

            <!-- Thẻ thống kê -->
            <UniformGrid Grid.Row="3" Rows="1" Columns="5" VerticalAlignment="Top" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="TỔNG VÁN" FontSize="10"
                                   Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TotalGamesText" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextMain}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="12,10" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="ĐÃ NỘP" FontSize="10"
                                   Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SubmittedText" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource AccentCyan}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="12,10" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="CAO NHẤT" FontSize="10"
                                   Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HighestText" FontSize="20" FontWeight="Bold"
                                   Foreground="#34D399" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="12,10" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="TRUNG BÌNH" FontSize="10"
                                   Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AverageText" FontSize="20" FontWeight="Bold"
                                   Foreground="#FBBF24" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="12,10" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="TỔNG ĐIỂM" FontSize="10"
                                   Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TotalScoreText" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextMain}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Danh sách ván gần đây -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="VÁN CHƠI GẦN ĐÂY" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="GamesGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  CanUserAddRows="False"
                                  CanUserResizeRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  RowHeight="38"
                                  FontSize="13"
                                  Foreground="{StaticResource TextMain}"
                                  ColumnHeaderStyle="{StaticResource DarkColumnHeader}"
                                  RowStyle="{StaticResource DarkRow}"
                                  CellStyle="{StaticResource DarkCell}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MÃ PHÒNG" Binding="{Binding RoomCode}" Width="110"/>
                                <DataGridTextColumn Header="BỘ ĐỀ" Binding="{Binding SetName}" Width="*"/>
                                <DataGridTextColumn Header="ĐỘ KHÓ" Binding="{Binding Difficulty}" Width="90"/>
                                <DataGridTextColumn Header="ĐIỂM" Binding="{Binding TotalScore}" Width="70"/>
                                <DataGridTextColumn Header="CÂN NẶNG" Binding="{Binding TotalWeight}" Width="90"/>
                                <DataGridTextColumn Header="MAX" Binding="{Binding MaxWeight}" Width="70"/>
                                <DataGridTextColumn Header="NỘP" Binding="{Binding IsSubmitted}" Width="60"/>
                                <DataGridTextColumn Header="NGÀY CHƠI"
                                                    Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}"
                                                    Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="🗒" FontSize="36" HorizontalAlignment="Center" Opacity="0.5"/>
                            <TextBlock Text="Chưa có thành tích" Foreground="{StaticResource TextMuted}"
                                       FontSize="14" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>