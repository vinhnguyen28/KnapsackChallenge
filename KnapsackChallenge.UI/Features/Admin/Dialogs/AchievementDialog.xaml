<Window x:Class="KnapsackChallenge.UI.Features.Admin.Dialogs.AchievementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thành tích người chơi"
        Width="780" Height="620"
        MinWidth="640" MinHeight="500"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushRule}"
            BorderThickness="1"
            CornerRadius="2"
            Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12"
                              ShadowDepth="2"
                              Opacity="0.15"
                              Color="Black"/>
        </Border.Effect>

        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- =========================================================
                 HEADER: title + ten user (mono) + nut dong
                 ========================================================= -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Thành tích người chơi"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushInk}"/>

                    <!-- Code-behind gan UsernameText.Text - giu nguyen -->
                    <TextBlock x:Name="UsernameText"
                               FontFamily="{DynamicResource FontMono}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource BrushInkMuted}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Click="Close_Click"
                        Style="{DynamicResource ButtonGhost}"
                        Padding="8,6"
                        VerticalAlignment="Top"
                        ToolTip="Đóng">
                    <Path Data="{DynamicResource IconClose}"
                          Width="12" Height="12"
                          Stroke="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6"
                          Stretch="Uniform"/>
                </Button>
            </Grid>

            <!-- =========================================================
                 BAN BANNER (an mac dinh, code-behind bat khi bi ban)
                 ========================================================= -->
            <Border x:Name="BanBanner"
                    Grid.Row="1"
                    Background="{DynamicResource BrushDangerSoft}"
                    BorderBrush="{DynamicResource BrushDanger}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="12,9"
                    Margin="0,14,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="BanHeaderText"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeBody}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushDanger}"/>
                    <TextBlock x:Name="BanReasonText"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource BrushDanger}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- =========================================================
                 THONG TIN CHUNG (code-behind gan)
                 ========================================================= -->
            <TextBlock x:Name="GeneralInfoText"
                       Grid.Row="2"
                       FontFamily="{DynamicResource FontMono}"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushInkMuted}"
                       Margin="0,12,0,12"
                       TextWrapping="Wrap"/>

            <!-- =========================================================
                 STAT STRIP: 5 muc ngan bang duong ke doc
                 Thay 5 the roi. So dung mono, label sentence case.
                 ========================================================= -->
            <Border Grid.Row="3"
                    Background="{DynamicResource BrushBackground}"
                    BorderBrush="{DynamicResource BrushRule}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="12,8">
                        <TextBlock Text="Tổng ván"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushInkMuted}"/>
                        <TextBlock x:Name="TotalGamesText"
                                   FontFamily="{DynamicResource FontMono}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushInk}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Rectangle Grid.Column="1" Width="1"
                               Fill="{DynamicResource BrushRule}"
                               Margin="0,6"/>

                    <StackPanel Grid.Column="2" Margin="12,8">
                        <TextBlock Text="Đã nộp"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushInkMuted}"/>
                        <TextBlock x:Name="SubmittedText"
                                   FontFamily="{DynamicResource FontMono}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushInk}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Rectangle Grid.Column="3" Width="1"
                               Fill="{DynamicResource BrushRule}"
                               Margin="0,6"/>

                    <StackPanel Grid.Column="4" Margin="12,8">
                        <TextBlock Text="Cao nhất"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushInkMuted}"/>
                        <TextBlock x:Name="HighestText"
                                   FontFamily="{DynamicResource FontMono}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushInk}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Rectangle Grid.Column="5" Width="1"
                               Fill="{DynamicResource BrushRule}"
                               Margin="0,6"/>

                    <StackPanel Grid.Column="6" Margin="12,8">
                        <TextBlock Text="Trung bình"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushInkMuted}"/>
                        <TextBlock x:Name="AverageText"
                                   FontFamily="{DynamicResource FontMono}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushInk}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Rectangle Grid.Column="7" Width="1"
                               Fill="{DynamicResource BrushRule}"
                               Margin="0,6"/>

                    <StackPanel Grid.Column="8" Margin="12,8">
                        <TextBlock Text="Tổng điểm"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushInkMuted}"/>
                        <TextBlock x:Name="TotalScoreText"
                                   FontFamily="{DynamicResource FontMono}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushInk}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =========================================================
                 BANG VAN CHOI GAN DAY
                 ========================================================= -->
            <Border Grid.Row="4"
                    Background="{DynamicResource BrushBackground}"
                    BorderBrush="{DynamicResource BrushRule}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource BrushRule}"
                            BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <TextBlock Text="Ván chơi gần đây"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushInkMuted}"/>
                    </Border>

                    <Grid Grid.Row="1">
                        <!-- x:Name + binding giu nguyen -->
                        <DataGrid x:Name="GamesGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  CanUserAddRows="False"
                                  CanUserResizeRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  RowHeight="34"
                                  FontSize="{DynamicResource FontSizeBody}"
                                  Foreground="{DynamicResource BrushInk}"
                                  ColumnHeaderStyle="{DynamicResource GridColumnHeader}"
                                  RowStyle="{DynamicResource GridRow}"
                                  CellStyle="{DynamicResource GridCell}">
                            <DataGrid.Columns>

                                <DataGridTextColumn Header="MÃ PHÒNG"
                                                    Binding="{Binding RoomCode}"
                                                    Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource MutedCellText}">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="BỘ ĐỀ"
                                                    Binding="{Binding SetName}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="ĐỘ KHÓ"
                                                    Binding="{Binding Difficulty}"
                                                    Width="80"
                                                    ElementStyle="{StaticResource MutedCellText}"/>

                                <DataGridTextColumn Header="ĐIỂM"
                                                    Binding="{Binding TotalScore}"
                                                    Width="60"
                                                    ElementStyle="{StaticResource RightCellText}"/>

                                <DataGridTextColumn Header="CÂN NẶNG"
                                                    Binding="{Binding TotalWeight}"
                                                    Width="80"
                                                    ElementStyle="{StaticResource RightCellText}"/>

                                <DataGridTextColumn Header="MAX"
                                                    Binding="{Binding MaxWeight}"
                                                    Width="60"
                                                    ElementStyle="{StaticResource RightCellText}"/>

                                <DataGridTextColumn Header="NỘP"
                                                    Binding="{Binding IsSubmitted}"
                                                    Width="60"
                                                    ElementStyle="{StaticResource MutedCellText}"/>

                                <DataGridTextColumn Header="NGÀY CHƠI"
                                                    Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}"
                                                    Width="130"
                                                    ElementStyle="{StaticResource MutedCellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty state (code-behind bat khi RecentGames.Count == 0) -->
                        <StackPanel x:Name="EmptyPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                            <Path Data="{DynamicResource IconBanLogs}"
                                  Width="36" Height="36"
                                  Stroke="{DynamicResource BrushInkMuted}"
                                  StrokeThickness="1.2"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  Opacity="0.5"/>
                            <TextBlock Text="Chưa có thành tích"
                                       FontFamily="{DynamicResource FontSans}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource BrushInkMuted}"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>