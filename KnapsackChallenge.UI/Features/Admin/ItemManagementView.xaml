<UserControl x:Class="KnapsackChallenge.UI.Features.Admin.ItemManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="Transparent">

    <!-- DataContext (ItemManagementViewModel) do MainAdminViewModel.CurrentPage cung cấp. -->
    <!-- Style/brush dùng chung đặt trong App.xaml. -->

    <Grid Margin="24,20,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ===== DANH SÁCH ===== -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Margin="0,0,0,14"
                         Style="{StaticResource DarkTextBox}"
                         Tag="🔍  Tìm vật phẩm theo tên..."
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <Grid Grid.Row="1">
                    <DataGrid ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              CanUserResizeColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="44"
                              FontSize="14"
                              Foreground="{StaticResource TextMain}"
                              ColumnHeaderStyle="{StaticResource DarkColumnHeader}"
                              RowStyle="{StaticResource DarkRow}"
                              CellStyle="{StaticResource DarkCell}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"
                                                ElementStyle="{StaticResource MutedCellText}"/>
                            <DataGridTextColumn Header="TÊN VẬT PHẨM" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="KHỐI LƯỢNG" Binding="{Binding Weight}" Width="110"
                                                ElementStyle="{StaticResource RightCellText}"/>
                            <DataGridTextColumn Header="GIÁ TRỊ" Binding="{Binding Value}" Width="110"
                                                ElementStyle="{StaticResource RightCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Trạng thái trống -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="📦" FontSize="40" HorizontalAlignment="Center" Opacity="0.5"/>
                        <TextBlock Text="Chưa có vật phẩm nào" Foreground="{StaticResource TextMuted}"
                                   FontSize="14" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== FORM ===== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource TextMain}" TextWrapping="Wrap"/>
                <Border Height="3" Width="36" CornerRadius="2" HorizontalAlignment="Left"
                        Background="{StaticResource PrimaryGradient}" Margin="0,10,0,22"/>

                <TextBlock Text="TÊN VẬT PHẨM" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,16"
                         Tag="Ví dụ: Kim cương"
                         Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="KHỐI LƯỢNG" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource DarkTextBox}" Tag="0"
                                 Text="{Binding WeightText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="GIÁ TRỊ" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource DarkTextBox}" Tag="0"
                                 Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource InfoBanner}">
                    <TextBlock Text="{Binding InfoMessage}" Foreground="#34D399" FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>

                <Border Style="{StaticResource ErrorBanner}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#F87171" FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>

                <Button Content="＋  Thêm mới" Command="{Binding AddCommand}"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource PrimaryGradient}"/>

                <Button Content="✓  Lưu thay đổi" Command="{Binding UpdateCommand}"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource SuccessGradient}"
                        Margin="0,10,0,0"/>

                <Button Content="✕  Xóa vật phẩm" Command="{Binding DeleteCommand}"
                        Style="{StaticResource ModernButton}"
                        Background="#2C1217" BorderBrush="#7F2A38" BorderThickness="1"
                        Foreground="#F87171" Margin="0,10,0,0"/>

                <Button Content="Làm mới form" Command="{Binding ClearCommand}"
                        Style="{StaticResource ModernButton}"
                        Background="Transparent"
                        Foreground="{StaticResource TextMuted}" FontWeight="Normal"
                        Margin="0,10,0,0" Padding="8"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>