<UserControl x:Class="KnapsackChallenge.UI.Views.ItemManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <!-- DataContext (ItemManagementViewModel) được gán từ MainWindow.xaml -->

    <UserControl.Resources>

        <!-- ===== BẢNG MÀU ===== -->
        <SolidColorBrush x:Key="CardBg" Color="#171A23"/>
        <SolidColorBrush x:Key="CardBorder" Color="#262B3A"/>
        <SolidColorBrush x:Key="InputBg" Color="#0F1219"/>
        <SolidColorBrush x:Key="TextMain" Color="#E8EAF0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8B93A7"/>
        <SolidColorBrush x:Key="Accent" Color="#7C6CF5"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#22D3EE"/>

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7C6CF5" Offset="0"/>
            <GradientStop Color="#4F8CFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#10B981" Offset="0"/>
            <GradientStop Color="#059669" Offset="1"/>
        </LinearGradientBrush>

        <!-- ===== Ô NHẬP LIỆU (có placeholder qua thuộc tính Tag) ===== -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentCyan}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{StaticResource InputBg}"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="9">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                                <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="#5B6376"
                                           Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3A4157"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== NÚT BẤM ===== -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== THANH CUỘN MỎNG (cả dọc lẫn ngang) ===== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="tb" Background="#3A4157" CornerRadius="4" Margin="2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="tb" Property="Background" Value="#586081"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== DATAGRID ===== -->
        <Style x:Key="DarkColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
        </Style>

        <Style x:Key="DarkRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1F2331"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A2760"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MutedCellText" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
        <Style x:Key="RightCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ===== NHÃN CỦA Ô NHẬP ===== -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <!-- ===== THẺ (CARD) ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== BANNER THÔNG BÁO (tự ẩn khi không có nội dung) ===== -->
        <Style x:Key="Banner" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="InfoBanner" TargetType="Border" BasedOn="{StaticResource Banner}">
            <Setter Property="Background" Value="#0F2A22"/>
            <Setter Property="BorderBrush" Value="#12503E"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding InfoMessage}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding InfoMessage}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ErrorBanner" TargetType="Border" BasedOn="{StaticResource Banner}">
            <Setter Property="Background" Value="#2C1217"/>
            <Setter Property="BorderBrush" Value="#5A1F2A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <!-- Nền gradient tối -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B0D13" Offset="0"/>
                <GradientStop Color="#12151F" Offset="0.6"/>
                <GradientStop Color="#171430" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="48" Height="48" CornerRadius="13" Background="{StaticResource PrimaryGradient}">
                    <Border.Effect>
                        <DropShadowEffect Color="#7C6CF5" BlurRadius="20" ShadowDepth="0" Opacity="0.55"/>
                    </Border.Effect>
                    <TextBlock Text="🎒" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Quản lý vật phẩm" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextMain}"/>
                    <TextBlock Text="Thêm, sửa, xóa các vật phẩm trong kho của trò chơi"
                               FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1A1D27" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="20" Padding="14,7" Margin="0,0,10,0">
                        <TextBlock FontSize="13" Foreground="{StaticResource TextMuted}">
                            <Run Text="{Binding Items.Count, Mode=OneWay}" Foreground="{StaticResource AccentCyan}"
                                 FontWeight="Bold"/>
                            <Run Text="vật phẩm"/>
                        </TextBlock>
                    </Border>
                    <Border Background="#2A2760" CornerRadius="20" Padding="14,7">
                        <TextBlock Text="ADMIN" FontSize="12" FontWeight="Bold" Foreground="#B9B1FF"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ================= NỘI DUNG ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- ===== DANH SÁCH ===== -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0" Margin="0,0,0,14"
                                 Style="{StaticResource DarkTextBox}"
                                 Tag="🔍  Tìm vật phẩm theo tên..."
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                        <Grid Grid.Row="1">
                            <DataGrid ItemsSource="{Binding Items}"
                                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      CanUserAddRows="False"
                                      CanUserResizeRows="False"
                                      CanUserResizeColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      RowHeight="44"
                                      FontSize="14"
                                      Foreground="{StaticResource TextMain}"
                                      ColumnHeaderStyle="{StaticResource DarkColumnHeader}"
                                      RowStyle="{StaticResource DarkRow}"
                                      CellStyle="{StaticResource DarkCell}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"
                                                        ElementStyle="{StaticResource MutedCellText}"/>
                                    <DataGridTextColumn Header="TÊN VẬT PHẨM" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="KHỐI LƯỢNG" Binding="{Binding Weight}" Width="120"
                                                        ElementStyle="{StaticResource RightCellText}"/>
                                    <DataGridTextColumn Header="GIÁ TRỊ" Binding="{Binding Value}" Width="120"
                                                        ElementStyle="{StaticResource RightCellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Trạng thái trống -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="📦" FontSize="40" HorizontalAlignment="Center" Opacity="0.5"/>
                                <TextBlock Text="Chưa có vật phẩm nào" Foreground="{StaticResource TextMuted}"
                                           FontSize="14" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ===== FORM ===== -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource TextMain}" TextWrapping="Wrap"/>
                        <Border Height="3" Width="36" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{StaticResource PrimaryGradient}" Margin="0,10,0,22"/>

                        <TextBlock Text="TÊN VẬT PHẨM" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,16"
                                 Tag="Ví dụ: Kim cương"
                                 Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="KHỐI LƯỢNG" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource DarkTextBox}" Tag="0"
                                         Text="{Binding WeightText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="GIÁ TRỊ" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource DarkTextBox}" Tag="0"
                                         Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Thông báo thành công -->
                        <Border Style="{StaticResource InfoBanner}">
                            <TextBlock Text="{Binding InfoMessage}" Foreground="#34D399" FontSize="13"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Thông báo lỗi -->
                        <Border Style="{StaticResource ErrorBanner}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#F87171" FontSize="13"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <Button Content="＋  Thêm mới" Command="{Binding AddCommand}"
                                Style="{StaticResource ModernButton}" Background="{StaticResource PrimaryGradient}"/>

                        <Button Content="✓  Lưu thay đổi" Command="{Binding UpdateCommand}"
                                Style="{StaticResource ModernButton}" Background="{StaticResource SuccessGradient}"
                                Margin="0,10,0,0"/>

                        <Button Content="✕  Xóa vật phẩm" Command="{Binding DeleteCommand}"
                                Style="{StaticResource ModernButton}" Background="#2C1217"
                                BorderBrush="#7F2A38" BorderThickness="1" Foreground="#F87171"
                                Margin="0,10,0,0"/>

                        <Button Content="Làm mới form" Command="{Binding ClearCommand}"
                                Style="{StaticResource ModernButton}" Background="Transparent"
                                Foreground="{StaticResource TextMuted}" FontWeight="Normal"
                                Margin="0,10,0,0" Padding="8"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
