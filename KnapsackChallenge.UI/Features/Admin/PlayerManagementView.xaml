<UserControl x:Class="KnapsackChallenge.UI.Features.Admin.PlayerManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Tab lọc -->
        <Style x:Key="FilterTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Margin"     Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="8" Padding="14,8"
                                Background="Transparent"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F2331"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2760"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hàng bị ban: nền đỏ nhẹ -->
        <Style x:Key="PlayerRow" TargetType="DataGridRow" BasedOn="{StaticResource DarkRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBanned}" Value="True">
                    <Setter Property="Background" Value="#261015"/>
                    <Setter Property="ToolTip"
                            Value="{Binding BanReason, StringFormat='Lý do ban: {0}'}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Nút nhỏ trong DataGrid -->
        <Style x:Key="GridButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding"  Value="10,5"/>
            <Setter Property="Margin"   Value="0,0,6,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Nút hành động dạng bảng con bên trong DataGrid -->
        <Style x:Key="MiniGridButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ 4 THẺ THỐNG KÊ ============ -->
        <UniformGrid Grid.Row="0" Rows="1" Columns="4" Margin="0,0,0,18">
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TỔNG TÀI KHOẢN" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding TotalCount}" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextMain}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="ĐANG ONLINE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding OnlineCount}" FontSize="26" FontWeight="Bold"
                               Foreground="#34D399" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="ĐANG BỊ BAN" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding BannedCount}" FontSize="26" FontWeight="Bold"
                               Foreground="#F87171" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="ĐĂNG KÝ HÔM NAY" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding TodayCount}" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource AccentCyan}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ============ TOOLBAR ============ -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Style="{StaticResource DarkTextBox}"
                     Tag="🔍  Tìm theo username..."
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     MaxWidth="380" HorizontalAlignment="Left"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Đang tải..." FontSize="12"
                           Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="⟳  Làm mới"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ModernButton}"
                        Background="#1F2331" Padding="14,9"/>
            </StackPanel>
        </Grid>

        <!-- ============ TAB LỌC ============ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton Content="Tất cả"    GroupName="PF" Style="{StaticResource FilterTab}"
                         IsChecked="{Binding IsFilterAll, Mode=TwoWay}"/>
            <RadioButton Content="Online"    GroupName="PF" Style="{StaticResource FilterTab}"
                         IsChecked="{Binding IsFilterOnline, Mode=TwoWay}"/>
            <RadioButton Content="Offline"   GroupName="PF" Style="{StaticResource FilterTab}"
                         IsChecked="{Binding IsFilterOffline, Mode=TwoWay}"/>
            <RadioButton Content="Bị ban"    GroupName="PF" Style="{StaticResource FilterTab}"
                         IsChecked="{Binding IsFilterBanned, Mode=TwoWay}"/>
        </StackPanel>

        <!-- ============ BANNER LỖI / THÀNH CÔNG ============ -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"
                    MaxWidth="420">
            <Border Style="{StaticResource InfoBanner}"  Margin="0,0,0,6">
                <TextBlock Text="{Binding InfoMessage}" Foreground="#34D399" FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>
            <Border Style="{StaticResource ErrorBanner}" Margin="0,0,0,6">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#F87171" FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- ============ BẢNG NGƯỜI CHƠI ============ -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18">
            <DataGrid ItemsSource="{Binding Users}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      CanUserResizeColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="46"
                      FontSize="13"
                      Foreground="{StaticResource TextMain}"
                      ColumnHeaderStyle="{StaticResource DarkColumnHeader}"
                      RowStyle="{StaticResource PlayerRow}"
                      CellStyle="{StaticResource DarkCell}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"
                                        ElementStyle="{StaticResource MutedCellText}"/>
                    <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="180"/>
                    <DataGridTextColumn Header="ROLE" Binding="{Binding Role}" Width="80"/>

                    <!-- Trạng thái: chấm xanh/xám/đỏ + text -->
                    <DataGridTemplateColumn Header="TRẠNG THÁI" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#6B7280"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="#22C55E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsBanned}" Value="True">
                                                        <Setter Property="Fill" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Foreground" Value="#34D399"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsBanned}" Value="True">
                                                        <Setter Property="Foreground" Value="#F87171"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="NGÀY TẠO"
                                        Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}"
                                        Width="150" ElementStyle="{StaticResource MutedCellText}"/>
                    <DataGridTextColumn Header="ĐĂNG NHẬP CUỐI"
                                        Binding="{Binding LastLoginAt, StringFormat='dd/MM/yyyy HH:mm'}"
                                        Width="150" ElementStyle="{StaticResource MutedCellText}"/>

                    <DataGridTemplateColumn Header="THAO TÁC" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Xem thành tích"
                                            Style="{StaticResource MiniGridButton}"
                                            Background="#3B82F6"
                                            Command="{Binding DataContext.ViewAchievementCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>

                                    <!-- Nút Ban: ẩn khi IsBanned -->
                                    <Button Content="Ban"
                                        Background="#7F1D1D"
                                        Command="{Binding DataContext.BanCommand,
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MiniGridButton}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBanned}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Nút Unban: hiện khi IsBanned -->
                                    <Button Content="Unban"
                                        Background="#059669"
                                        Command="{Binding DataContext.UnbanCommand,
                                                     RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                        
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MiniGridButton}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBanned}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>