<UserControl x:Class="KnapsackChallenge.UI.Features.Admin.PlayerManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="1000"
             Background="{DynamicResource BrushBackground}">

    <UserControl.Resources>

        <!-- =========================================================
             Row style cho bang nguoi choi.
             LUU Y: BasedOn CHI duoc dung StaticResource, KHONG duoc
             dung DynamicResource (WPF cam).
             ========================================================= -->
        <Style x:Key="PlayerRow" TargetType="DataGridRow"
               BasedOn="{StaticResource GridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBanned}" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource BrushDangerSoft}"/>
                    <Setter Property="ToolTip"
                            Value="{Binding BanReason, StringFormat='Lý do ban: {0}'}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Nut thao tac nho trong bang - base tu ButtonMini. -->
        <Style x:Key="MiniGridButton" TargetType="Button"
               BasedOn="{StaticResource ButtonMini}">
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- =========================================================
             STAT STRIP — 4 muc ngan bang duong ke doc.
             ========================================================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushRule}"
                BorderThickness="1"
                CornerRadius="2"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="16,10">
                    <TextBlock Text="Tổng tài khoản"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushInkMuted}"/>
                    <TextBlock Text="{Binding TotalCount}"
                               FontFamily="{DynamicResource FontMono}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushInk}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1"
                           Fill="{DynamicResource BrushRule}"
                           Margin="0,8"/>

                <StackPanel Grid.Column="2" Margin="16,10">
                    <TextBlock Text="Đang online"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushInkMuted}"/>
                    <TextBlock Text="{Binding OnlineCount}"
                               FontFamily="{DynamicResource FontMono}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushInk}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Rectangle Grid.Column="3" Width="1"
                           Fill="{DynamicResource BrushRule}"
                           Margin="0,8"/>

                <StackPanel Grid.Column="4" Margin="16,10">
                    <TextBlock Text="Đang bị ban"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushInkMuted}"/>
                    <TextBlock Text="{Binding BannedCount}"
                               FontFamily="{DynamicResource FontMono}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushInk}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Rectangle Grid.Column="5" Width="1"
                           Fill="{DynamicResource BrushRule}"
                           Margin="0,8"/>

                <StackPanel Grid.Column="6" Margin="16,10">
                    <TextBlock Text="Đăng ký hôm nay"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushInkMuted}"/>
                    <TextBlock Text="{Binding TodayCount}"
                               FontFamily="{DynamicResource FontMono}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushInk}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =========================================================
             TOOLBAR
             ========================================================= -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Style="{DynamicResource DarkTextBox}"
                     Tag="Tìm theo username..."
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     MaxWidth="320"
                     HorizontalAlignment="Left"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="Đang tải..."
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource BrushInkMuted}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Visibility="{Binding IsLoading,
                                       Converter={StaticResource BoolToVisibility}}"/>

                <Button Command="{Binding RefreshCommand}"
                        Style="{DynamicResource ButtonSecondary}"
                        Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource IconRefresh}"
                              Width="14" Height="14"
                              Stroke="{DynamicResource BrushInk}"
                              StrokeThickness="1.5"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"/>
                        <TextBlock Text="Làm mới" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- =========================================================
             HANG 3: tab loc + banner
             ========================================================= -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <RadioButton Content="Tất cả" GroupName="PF"
                             Style="{DynamicResource FilterTabRadio}"
                             IsChecked="{Binding IsFilterAll, Mode=TwoWay}"/>
                <RadioButton Content="Online" GroupName="PF"
                             Style="{DynamicResource FilterTabRadio}"
                             IsChecked="{Binding IsFilterOnline, Mode=TwoWay}"/>
                <RadioButton Content="Offline" GroupName="PF"
                             Style="{DynamicResource FilterTabRadio}"
                             IsChecked="{Binding IsFilterOffline, Mode=TwoWay}"/>
                <RadioButton Content="Bị ban" GroupName="PF"
                             Style="{DynamicResource FilterTabRadio}"
                             IsChecked="{Binding IsFilterBanned, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        MaxWidth="480">
                <Border Style="{DynamicResource InfoBanner}"
                        Margin="0,0,0,4">
                    <TextBlock Text="{Binding InfoMessage}"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource BrushSuccess}"
                               TextWrapping="Wrap"/>
                </Border>
                <Border Style="{DynamicResource ErrorBanner}"
                        Margin="0">
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource BrushDanger}"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- =========================================================
             BANG NGUOI CHOI
             ========================================================= -->
        <Border Grid.Row="3"
                Style="{DynamicResource Card}"
                Padding="0">
            <DataGrid ItemsSource="{Binding Users}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      CanUserResizeColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="40"
                      FontSize="{DynamicResource FontSizeBody}"
                      Foreground="{DynamicResource BrushInk}"
                      ColumnHeaderStyle="{DynamicResource GridColumnHeader}"
                      RowStyle="{StaticResource PlayerRow}"
                      CellStyle="{DynamicResource GridCell}">
                <DataGrid.Columns>

                    <!-- ID: mono, can phai -->
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource MutedCellText}">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="USERNAME"
                                        Binding="{Binding Username}"
                                        Width="180"/>

                    <DataGridTextColumn Header="ROLE"
                                        Binding="{Binding Role}"
                                        Width="80"
                                        ElementStyle="{StaticResource MutedCellText}"/>

                    <!-- Trang thai dang "tem" -->
                    <DataGridTemplateColumn Header="TRẠNG THÁI" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Left"
                                        Padding="6,2"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Background="Transparent">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource BrushInkMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource BrushSuccess}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBanned}" Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource BrushDanger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding StatusText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource MonoCaptionTextStyle}">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource BrushInkMuted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource BrushSuccess}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsBanned}" Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource BrushDanger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="NGÀY TẠO"
                                        Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}"
                                        Width="140"
                                        ElementStyle="{StaticResource MutedCellText}"/>

                    <DataGridTextColumn Header="ĐĂNG NHẬP CUỐI"
                                        Binding="{Binding LastLoginAt, StringFormat='dd/MM/yyyy HH:mm'}"
                                        Width="140"
                                        ElementStyle="{StaticResource MutedCellText}"/>

                    <!-- Thao tac -->
                    <DataGridTemplateColumn Header="THAO TÁC" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">

                                    <Button Content="Xem thành tích"
                                            Style="{StaticResource MiniGridButton}"
                                            Command="{Binding DataContext.ViewAchievementCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>

                                    <!--
                                         Nut Ban: chi dung <Button.Style>, KHONG
                                         set Style= o attribute (tranh set 2 lan).
                                         An khi IsBanned = True.
                                    -->
                                    <Button Content="Ban"
                                            Command="{Binding DataContext.BanCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource MiniGridButton}">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource BrushDanger}"/>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource BrushOnAccent}"/>
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource BrushDanger}"/>
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBanned}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Nut Unban: hien khi IsBanned = True -->
                                    <Button Content="Unban"
                                            Command="{Binding DataContext.UnbanCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource MiniGridButton}">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource BrushSuccess}"/>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource BrushOnAccent}"/>
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource BrushSuccess}"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBanned}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>