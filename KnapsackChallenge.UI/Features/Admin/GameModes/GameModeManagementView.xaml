<UserControl x:Class="KnapsackChallenge.UI.Features.Admin.GameModeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="1000"
             Background="{DynamicResource BrushBackground}">

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header + Refresh -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Quản lý chế độ chơi"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushInk}"/>
                <TextBlock Text="Bật/tắt chế độ, giới hạn thời gian và số người tối đa."
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource BrushInkMuted}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Đang tải..."
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource BrushInkMuted}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Visibility="{Binding IsLoading,
                                       Converter={StaticResource BoolToVisibility}}"/>
                <Button Command="{Binding RefreshCommand}"
                        Style="{DynamicResource ButtonSecondary}"
                        Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource IconRefresh}"
                              Width="14" Height="14"
                              Stroke="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"/>
                        <TextBlock Text="Làm mới" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Banner thông báo -->
        <Grid Grid.Row="1" Margin="0,0,0,12" MinHeight="42">
            <Border Style="{DynamicResource InfoBanner}" Margin="0" VerticalAlignment="Top">
                <TextBlock Text="{Binding InfoMessage}"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource BrushSuccess}"
                           TextWrapping="Wrap"/>
            </Border>
            <Border Style="{DynamicResource ErrorBanner}" Margin="0" VerticalAlignment="Top">
                <TextBlock Text="{Binding ErrorMessage}"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource BrushDanger}"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>

        <!-- Danh sách chế độ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Modes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource Card}"
                                Padding="18"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Cột trái: tên + config -->
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontFamily="{DynamicResource FontSans}"
                                                   FontSize="{DynamicResource FontSizeTitle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushInk}"/>

                                        <!-- Key badge -->
                                        <Border Padding="6,2"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource BrushRule}"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ModeKeyBadge}"
                                                       Style="{StaticResource MonoCaptionTextStyle}"
                                                       Foreground="{DynamicResource BrushInkMuted}"/>
                                        </Border>
                                    </StackPanel>

                                    <Rectangle Height="1"
                                               Fill="{DynamicResource BrushRule}"
                                               Margin="0,10,0,14"/>

                                    <!-- Enabled toggle -->
                                    <CheckBox Content="Bật chế độ này"
                                              Style="{DynamicResource InputCheckBox}"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              Margin="0,0,0,12"/>

                                    <!-- Time limit -->
                                    <TextBlock Text="Giới hạn thời gian (giây; 0 = không giới hạn)"
                                               Style="{DynamicResource FieldLabel}"/>
                                    <TextBox Style="{DynamicResource DarkTextBox}"
                                             Text="{Binding TimeLimitText, UpdateSourceTrigger=PropertyChanged}"
                                             MaxWidth="220"
                                             HorizontalAlignment="Left"
                                             Tag="0"/>

                                    <!-- MaxPlayers (chỉ Multiplayer) -->
                                    <!-- v7: Cấu hình tim (chỉ Solo) -->
                                    <StackPanel Margin="0,12,0,0"
            Visibility="{Binding IsSolo,
                        Converter={StaticResource BoolToVisibility}}">

                                        <TextBlock Text="Số tim tối đa (1..999)"
               Style="{DynamicResource FieldLabel}"/>
                                        <TextBox Style="{DynamicResource DarkTextBox}"
             Text="{Binding MaxHeartsText, UpdateSourceTrigger=PropertyChanged}"
             MaxWidth="220"
             HorizontalAlignment="Left"
             Tag="25"/>

                                        <TextBlock Text="Thời gian hồi 1 tim (phút; 1..1440)"
               Style="{DynamicResource FieldLabel}"
               Margin="0,10,0,6"/>
                                        <TextBox Style="{DynamicResource DarkTextBox}"
             Text="{Binding HeartRefillMinutesText, UpdateSourceTrigger=PropertyChanged}"
             MaxWidth="220"
             HorizontalAlignment="Left"
             Tag="30"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding UpdatedInfoText}"
                                               FontFamily="{DynamicResource FontSans}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource BrushInkMuted}"
                                               Margin="0,14,0,0"/>
                                </StackPanel>

                                <!-- Cột phải: nút Save -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal"
                                            Margin="16,0,0,0">
                                    <Button Command="{Binding DataContext.SaveCommand,
                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{DynamicResource ButtonPrimary}"
                                            Padding="16,9">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{DynamicResource IconSave}"
                                                  Width="14" Height="14"
                                                  Stroke="{Binding Foreground,
                                                           RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5"
                                                  Stretch="Uniform"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"/>
                                            <TextBlock Text="Lưu" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>