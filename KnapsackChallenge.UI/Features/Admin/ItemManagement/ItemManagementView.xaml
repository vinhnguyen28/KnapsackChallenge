<UserControl x:Class="KnapsackChallenge.UI.Features.Admin.ItemManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shared="clr-namespace:KnapsackChallenge.UI.Shared"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="1200"
             Background="{DynamicResource BrushBackground}">

    <!-- DataContext (ItemManagementViewModel) do MainAdminViewModel.CurrentPage cung cap. -->

    <UserControl.Resources>

        <!-- v10: converter IconKey -> ImageSource. Đặt local để không phải
             đụng App.xaml. One-way, thread-safe, luôn trả non-null. -->
        <shared:ItemIconConverter x:Key="ItemIconConverter"/>

        <!-- Row style cho bang vat pham. Ke thua GridRow (da co vach Accent khi selected). -->
        <Style x:Key="ItemRow" TargetType="DataGridRow"
               BasedOn="{StaticResource GridRow}"/>

    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- =========================================================
             COT TRAI: bang vat pham
             ========================================================= -->
        <Border Grid.Column="0"
                Style="{DynamicResource Card}"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search bar, ngan cach voi bang bang duong rule duoi -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource BrushRule}"
                        BorderThickness="0,0,0,1"
                        Padding="12,10">
                    <TextBox Style="{DynamicResource DarkTextBox}"
                             Tag="Tìm vật phẩm theo tên..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>

                <!-- Bang + empty state chong len nhau -->
                <Grid Grid.Row="1">
                    <DataGrid ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              CanUserResizeColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="38"
                              FontSize="{DynamicResource FontSizeBody}"
                              Foreground="{DynamicResource BrushInk}"
                              ColumnHeaderStyle="{DynamicResource GridColumnHeader}"
                              RowStyle="{StaticResource ItemRow}"
                              CellStyle="{DynamicResource GridCell}">
                        <DataGrid.Columns>

                            <!-- v10: cột icon nhỏ 28x28 ở đầu bảng. -->
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding IconKey, Converter={StaticResource ItemIconConverter}}"
                                               Width="28" Height="28"
                                               Stretch="Uniform"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ID: mono, can phai -->
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding Id}"
                                                Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource MutedCellText}">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="TÊN VẬT PHẨM"
                                                Binding="{Binding Name}"
                                                Width="*"/>

                            <DataGridTextColumn Header="KHỐI LƯỢNG"
                                                Binding="{Binding Weight}"
                                                Width="100"
                                                ElementStyle="{StaticResource RightCellText}"/>

                            <DataGridTextColumn Header="GIÁ TRỊ"
                                                Binding="{Binding Value}"
                                                Width="100"
                                                ElementStyle="{StaticResource RightCellText}"/>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state - hien khi Items.Count == 0 -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Icon hop rong ve bang Path -->
                        <Path Data="{DynamicResource IconItems}"
                              Width="40" Height="40"
                              Stroke="{DynamicResource BrushInkMuted}"
                              StrokeThickness="1.2"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Opacity="0.5"/>

                        <TextBlock Text="Chưa có vật phẩm nào"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- =========================================================
             COT PHAI: form them / sua
             ========================================================= -->
        <Border Grid.Column="2"
                Style="{DynamicResource Card}"
                Padding="18"
                VerticalAlignment="Top">
            <StackPanel>

                <!-- Title + rule manh 1px -->
                <TextBlock Text="{Binding FormTitle}"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushInk}"
                           TextWrapping="Wrap"/>

                <Rectangle Height="1"
                           Fill="{DynamicResource BrushRule}"
                           Margin="0,10,0,16"/>

                <!-- Ten vat pham -->
                <TextBlock Text="Tên vật phẩm"
                           Style="{DynamicResource FieldLabel}"/>
                <TextBox Style="{DynamicResource DarkTextBox}"
                         Tag="Ví dụ: Kim cương"
                         Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Weight + Value canh nhau -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Khối lượng"
                                   Style="{DynamicResource FieldLabel}"/>
                        <TextBox Style="{DynamicResource DarkTextBox}"
                                 Tag="0"
                                 Text="{Binding WeightText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Giá trị"
                                   Style="{DynamicResource FieldLabel}"/>
                        <TextBox Style="{DynamicResource DarkTextBox}"
                                 Tag="0"
                                 Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- =========================================================
                     v10: KHU VUC CHON BIEU TUONG
                     - O xem truoc 48x48 (dung ItemIconConverter).
                     - Nut "Chon bieu tuong" mo Popup (StaysOpen=False).
                     - Nut "x" nho xoa icon (ve "default").
                     - Popup: o tim kiem + ItemsControl long nhau (Category -> WrapPanel 56x56).
                     - Icon dang chon co vien Accent + nen AccentSoft.
                     ========================================================= -->
                <TextBlock Text="Biểu tượng"
                           Style="{DynamicResource FieldLabel}"
                           Margin="0,12,0,6"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Preview 48x48 (khong bao gio trong/lo) -->
                    <Border Grid.Column="0"
                            Width="48" Height="48"
                            BorderBrush="{DynamicResource BrushRule}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Background="{DynamicResource BrushBackground}">
                        <Image Source="{Binding SelectedIconKey, Converter={StaticResource ItemIconConverter}}"
                               Width="42" Height="42"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- Nut xoa icon (nho) -->
                    <Button Grid.Column="1"
                            Command="{Binding ClearIconCommand}"
                            Style="{DynamicResource ButtonGhost}"
                            Padding="6,4"
                            Margin="4,0,0,0"
                            VerticalAlignment="Top"
                            ToolTip="Xoá biểu tượng (dùng mặc định)">
                        <Path Data="{DynamicResource IconClose}"
                              Width="10" Height="10"
                              Stroke="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              Stretch="Uniform"/>
                    </Button>

                    <!-- Nut mo popup -->
                    <Button x:Name="IconPickerButton"
                            Grid.Column="2"
                            Command="{Binding OpenIconPickerCommand}"
                            Style="{DynamicResource ButtonSecondary}"
                            Margin="8,0,0,0"
                            Padding="12,8"
                            VerticalAlignment="Stretch"
                            Content="Chọn biểu tượng"/>
                </Grid>

                <!-- Popup chon icon: StaysOpen=False de click ra ngoai tu dong dong.
                     PlacementTarget tro toi nut vua bam. Nen theo theme SANG hien co. -->
                <Popup IsOpen="{Binding IsIconPickerOpen, Mode=TwoWay}"
                       StaysOpen="False"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=IconPickerButton}"
                       VerticalOffset="4"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushRule}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10"
                            Width="360"
                            MaxHeight="440"
                            Margin="0,4,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12"
                                              ShadowDepth="2"
                                              Opacity="0.18"
                                              Color="Black"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- O tim kiem -->
                            <TextBox Grid.Row="0"
                                     Style="{DynamicResource DarkTextBox}"
                                     Tag="Tìm icon theo tên..."
                                     Text="{Binding IconSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"/>

                            <!-- Danh sach nhom icon -->
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding FilteredIcons}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <!-- Ten nhom -->
                                                <TextBlock Text="{Binding Category}"
                                                           FontFamily="{DynamicResource FontSans}"
                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushInkMuted}"
                                                           Margin="2,0,0,4"/>

                                                <!-- WrapPanel cac o 56x56 -->
                                                <ItemsControl ItemsSource="{Binding Icons}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Width="56" Height="56"
                                                                    Margin="2"
                                                                    Cursor="Hand"
                                                                    ToolTip="{Binding DisplayName}"
                                                                    Command="{Binding PickCommand}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="bd"
                                                                                BorderBrush="Transparent"
                                                                                BorderThickness="2"
                                                                                CornerRadius="4"
                                                                                Background="{DynamicResource BrushBackground}">
                                                                            <Image Source="{Binding Key,
                                                                                            Converter={StaticResource ItemIconConverter}}"
                                                                                   Width="44" Height="44"
                                                                                   Stretch="Uniform"
                                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <!-- Icon dang chon: vien Accent + nen mem -->
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter TargetName="bd" Property="BorderBrush"
                                                                                        Value="{DynamicResource BrushAccent}"/>
                                                                                <Setter TargetName="bd" Property="Background"
                                                                                        Value="{DynamicResource BrushAccentSoft}"/>
                                                                            </DataTrigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="bd" Property="BorderBrush"
                                                                                        Value="{DynamicResource BrushInkMuted}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Popup>

                <!-- =========================================================
                     KHU VUC THONG BAO - CHIEU CAO CO DINH (54px)
                     Giong Login/Register: bao ve cac nut ben duoi khoi bi day
                     khi banner xuat hien.
                     ========================================================= -->
                <Grid MinHeight="54" Margin="0,14,0,0">
                    <Border Style="{DynamicResource InfoBanner}"
                            Margin="0"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding InfoMessage}"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource BrushSuccess}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border Style="{DynamicResource ErrorBanner}"
                            Margin="0"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource BrushDanger}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>

                <!-- HANH DONG CHINH - Accent duy nhat -->
                <Button Command="{Binding AddCommand}"
                        Style="{DynamicResource ButtonPrimary}"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource IconAdd}"
                              Width="14" Height="14"
                              Stroke="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"/>
                        <TextBlock Text="Thêm mới" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding UpdateCommand}"
                        Style="{DynamicResource ButtonSecondary}"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource IconSave}"
                              Width="14" Height="14"
                              Stroke="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"/>
                        <TextBlock Text="Lưu thay đổi" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding DeleteCommand}"
                        Style="{DynamicResource ButtonDanger}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource IconDelete}"
                              Width="14" Height="14"
                              Stroke="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"/>
                        <TextBlock Text="Xóa vật phẩm" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Content="Làm mới form"
                        Command="{Binding ClearCommand}"
                        Style="{DynamicResource ButtonGhost}"
                        Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>