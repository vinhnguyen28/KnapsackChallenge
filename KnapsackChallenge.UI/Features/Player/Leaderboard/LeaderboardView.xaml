<UserControl x:Class="KnapsackChallenge.UI.Features.Player.LeaderboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="1000"
             Background="{DynamicResource BrushBackground}">

    <UserControl.Resources>
        <!-- Row style cho DataGrid EXP: top 1/2/3 đổi nền; dòng của mình ưu tiên nổi bật nhất. -->
        <Style x:Key="ExpLbRow" TargetType="DataGridRow" BasedOn="{StaticResource GridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rank}" Value="1">
                    <Setter Property="Background" Value="{DynamicResource BrushWarningSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Rank}" Value="2">
                    <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Rank}" Value="3">
                    <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                </DataTrigger>
                <!-- Đặt SAU CÙNG để thắng các DataTrigger trên khi IsMe=True. -->
                <DataTrigger Binding="{Binding IsMe}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Row style cho DataGrid theo bộ đề: cùng logic. -->
        <Style x:Key="SetLbRow" TargetType="DataGridRow" BasedOn="{StaticResource GridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rank}" Value="1">
                    <Setter Property="Background" Value="{DynamicResource BrushWarningSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Rank}" Value="2">
                    <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Rank}" Value="3">
                    <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMe}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =========================================================
             HÀNG 0: TIÊU ĐỀ + LÀM MỚI
             ========================================================= -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding BackCommand}"
                    Style="{DynamicResource ButtonSecondary}"
                    Padding="12,7"
                    Margin="0,0,14,0"
                    VerticalAlignment="Center">
                <TextBlock Text="← Trang chủ"/>
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Bảng xếp hạng"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushInk}"/>
                <TextBlock Text="Xếp theo cấp độ, hoặc theo % đạt tối ưu của từng bộ đề."
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource BrushInkMuted}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Đang tải..."
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource BrushInkMuted}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Visibility="{Binding IsLoading,
                                        Converter={StaticResource BoolToVisibility}}"/>
                <Button Command="{Binding RefreshCommand}"
                        Style="{DynamicResource ButtonSecondary}"
                        Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource IconRefresh}"
                              Width="14" Height="14"
                              Stroke="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"/>
                        <TextBlock Text="Làm mới" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- =========================================================
             HÀNG 1: 2 TAB
             ========================================================= -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton Content="🏅 Cấp độ (EXP)"
                         GroupName="LbTab"
                         Style="{DynamicResource FilterTabRadio}"
                         IsChecked="{Binding IsExpTab, Mode=TwoWay}"/>
            <RadioButton Content="🎯 Theo bộ đề"
                         GroupName="LbTab"
                         Style="{DynamicResource FilterTabRadio}"
                         IsChecked="{Binding IsSetTab, Mode=TwoWay}"/>
        </StackPanel>

        <!-- =========================================================
             HÀNG 2: THANH LỌC (chỉ hiện khi tab "Theo bộ đề")
             ========================================================= -->
        <WrapPanel Grid.Row="2"
                   Margin="0,0,0,10"
                   Visibility="{Binding IsSetTab,
                                Converter={StaticResource BoolToVisibility}}">

            <RadioButton Content="Tất cả"
                         GroupName="LbDiff"
                         Style="{DynamicResource FilterTabRadio}"
                         IsChecked="{Binding IsDiffAll, Mode=TwoWay}"/>
            <RadioButton Content="🌱 Dễ"
                         GroupName="LbDiff"
                         Style="{DynamicResource FilterTabRadio}"
                         IsChecked="{Binding IsDiffEasy, Mode=TwoWay}"/>
            <RadioButton Content="⚖️ Bình thường"
                         GroupName="LbDiff"
                         Style="{DynamicResource FilterTabRadio}"
                         IsChecked="{Binding IsDiffMedium, Mode=TwoWay}"/>
            <RadioButton Content="🔥 Khó"
                         GroupName="LbDiff"
                         Style="{DynamicResource FilterTabRadio}"
                         IsChecked="{Binding IsDiffHard, Mode=TwoWay}"/>

            <ComboBox Width="150"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      Style="{DynamicResource DarkComboBox}"
                      ItemsSource="{Binding ModeOptions}"
                      SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                      DisplayMemberPath="Label"/>

            <ComboBox Width="140"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      Style="{DynamicResource DarkComboBox}"
                      ItemsSource="{Binding TimeOptions}"
                      SelectedItem="{Binding SelectedTime, Mode=TwoWay}"
                      DisplayMemberPath="Label"/>

            <ComboBox Width="260"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      Style="{DynamicResource DarkComboBox}"
                      ItemsSource="{Binding SetOptions}"
                      SelectedItem="{Binding SelectedSetOption, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      Visibility="{Binding HasSetFilter,
                                   Converter={StaticResource BoolToVisibility}}"/>
        </WrapPanel>

        <!-- =========================================================
             HÀNG 3: BẢNG (2 DataGrid + empty state xếp chồng)
             ========================================================= -->
        <Border Grid.Row="3" Style="{DynamicResource Card}" Padding="0">
            <Grid>

                <!-- DataGrid EXP -->
                <DataGrid ItemsSource="{Binding ExpRows}"
                          Visibility="{Binding IsExpTab,
                                       Converter={StaticResource BoolToVisibility}}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          CanUserResizeRows="False"
                          CanUserResizeColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="Transparent"
                          BorderThickness="0"
                          RowHeight="38"
                          FontSize="{DynamicResource FontSizeBody}"
                          Foreground="{DynamicResource BrushInk}"
                          ColumnHeaderStyle="{DynamicResource GridColumnHeader}"
                          RowStyle="{StaticResource ExpLbRow}"
                          CellStyle="{DynamicResource GridCell}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"
                                            Binding="{Binding RankText}"
                                            Width="70"
                                            ElementStyle="{StaticResource RightCellText}"/>
                        <DataGridTextColumn Header="NGƯỜI CHƠI"
                                            Binding="{Binding Username}"
                                            Width="*"/>
                        <DataGridTextColumn Header="CẤP"
                                            Binding="{Binding LevelText}"
                                            Width="90"/>
                        <DataGridTextColumn Header="HẠNG"
                                            Binding="{Binding RankTitle}"
                                            Width="130"
                                            ElementStyle="{StaticResource MutedCellText}"/>
                        <DataGridTextColumn Header="EXP"
                                            Binding="{Binding ExpText}"
                                            Width="130"
                                            ElementStyle="{StaticResource RightCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- DataGrid theo bộ đề -->
                <DataGrid ItemsSource="{Binding SetRows}"
                          Visibility="{Binding IsSetTab,
                                       Converter={StaticResource BoolToVisibility}}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          CanUserResizeRows="False"
                          CanUserResizeColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="Transparent"
                          BorderThickness="0"
                          RowHeight="38"
                          FontSize="{DynamicResource FontSizeBody}"
                          Foreground="{DynamicResource BrushInk}"
                          ColumnHeaderStyle="{DynamicResource GridColumnHeader}"
                          RowStyle="{StaticResource SetLbRow}"
                          CellStyle="{DynamicResource GridCell}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"
                                            Binding="{Binding RankText}"
                                            Width="70"
                                            ElementStyle="{StaticResource RightCellText}"/>
                        <DataGridTextColumn Header="NGƯỜI CHƠI"
                                            Binding="{Binding Username}"
                                            Width="*"/>
                        <DataGridTextColumn Header="BỘ ĐỀ"
                                            Binding="{Binding SetName}"
                                            Width="*"
                                            ElementStyle="{StaticResource MutedCellText}"/>
                        <DataGridTextColumn Header="ĐỘ KHÓ"
                                            Binding="{Binding DifficultyText}"
                                            Width="110"
                                            ElementStyle="{StaticResource MutedCellText}"/>
                        <DataGridTextColumn Header="% TỐI ƯU"
                                            Binding="{Binding PercentText}"
                                            Width="100"
                                            ElementStyle="{StaticResource RightCellText}"/>
                        <DataGridTextColumn Header="ĐIỂM"
                                            Binding="{Binding ScoreText}"
                                            Width="100"
                                            ElementStyle="{StaticResource RightCellText}"/>
                        <DataGridTextColumn Header="THỜI GIAN"
                                            Binding="{Binding TimeText}"
                                            Width="100"
                                            ElementStyle="{StaticResource RightCellText}"/>
                        <DataGridTextColumn Header="THỜI ĐIỂM"
                                            Binding="{Binding AchievedText}"
                                            Width="150"
                                            ElementStyle="{StaticResource MutedCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state EXP -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsExpTab}" Value="True"/>
                                        <Condition Binding="{Binding ExpRows.Count}" Value="0"/>
                                        <Condition Binding="{Binding IsLoading}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Path Data="{DynamicResource IconTagStack}"
                          Width="40" Height="40"
                          Stroke="{DynamicResource BrushInkMuted}"
                          StrokeThickness="1.2"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          Opacity="0.5"/>
                    <TextBlock Text="Chưa có ai lọt bảng xếp hạng"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource BrushInkMuted}"
                               Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Empty state theo bộ đề -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSetTab}" Value="True"/>
                                        <Condition Binding="{Binding SetRows.Count}" Value="0"/>
                                        <Condition Binding="{Binding IsLoading}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Path Data="{DynamicResource IconTagStack}"
                          Width="40" Height="40"
                          Stroke="{DynamicResource BrushInkMuted}"
                          StrokeThickness="1.2"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          Opacity="0.5"/>
                    <TextBlock Text="Chưa có ai lọt bảng xếp hạng"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource BrushInkMuted}"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =========================================================
             HÀNG 4: LỖI + HẠNG CỦA BẠN
             ========================================================= -->
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <Border Style="{DynamicResource ErrorBanner}" Margin="0,0,0,8">
                <TextBlock Text="{Binding ErrorMessage}"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource BrushDanger}"
                           TextWrapping="Wrap"/>
            </Border>

            <Border Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushRule}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8">
                <TextBlock Text="{Binding MyRankText}"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeBody}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushInk}"
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>