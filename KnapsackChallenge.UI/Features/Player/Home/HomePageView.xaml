<UserControl x:Class="KnapsackChallenge.UI.Features.Player.HomePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="900"
             Background="{DynamicResource BrushBackground}">

    <UserControl.Resources>
        <!-- Nút card Home: kế thừa GameCardButton, thêm ràng buộc kích thước cho layout 3 cột. -->
        <Style x:Key="HomeActionButton"
               TargetType="Button"
               BasedOn="{StaticResource GameCardButton}">
            <Setter Property="MinWidth"  Value="140"/>
            <Setter Property="MaxWidth"  Value="320"/>
            <Setter Property="MinHeight" Value="180"/>
            <Setter Property="MaxHeight" Value="280"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="22*" MinWidth="180" MaxWidth="340"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="56*" MinWidth="320"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="22*" MinWidth="180" MaxWidth="340"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: thống kê + shortcut -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel VerticalAlignment="Top">

                <TextBlock Text="Thống kê của bạn"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushInkMuted}"
                           Margin="4,0,0,10"/>

                <Border Style="{StaticResource GameStatCard}">
                    <StackPanel>
                        <TextBlock Text="SỐ VÁN ĐÃ CHƠI"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding GamesPlayedText}"
                                   FontFamily="{DynamicResource FontMono}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushInk}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GameStatCard}">
                    <StackPanel>
                        <TextBlock Text="ĐIỂM CAO NHẤT"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding BestScoreText}"
                                   FontFamily="{DynamicResource FontMono}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushInk}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GameStatCard}">
                    <StackPanel>
                        <TextBlock Text="HẠNG HIỆN TẠI"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CurrentRankText}"
                                   FontFamily="{DynamicResource FontMono}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushAccent}"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Truy cập nhanh"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushInkMuted}"
                           Margin="4,10,0,10"/>

                <Button Style="{StaticResource ShortcutButton}"
                        Command="{Binding OpenLeaderboardCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏆" Width="24" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Xếp hạng" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ShortcutButton}"
                        Command="{Binding OpenHistoryCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📜" Width="24" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Lịch sử" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- CỘT GIỮA: welcome + 2 nút lớn -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,20,0,6">
                <TextBlock Text="{Binding WelcomeText}"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushInk}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Hãy chọn một chế độ để bắt đầu."
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource BrushInkMuted}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <UniformGrid Grid.Row="1"
                         Columns="2"
                         Rows="1"
                         MaxWidth="680"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Center">

                <Button Style="{StaticResource HomeActionButton}"
                        Command="{Binding PlaySoloCommand}">
                    <StackPanel>
                        <TextBlock Text="🎯"
                                   FontSize="44"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="CHƠI SOLO"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushInk}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Chinh phục bài toán cái túi"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding SoloStatusText}"
                                   FontFamily="{DynamicResource FontMono}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource HomeActionButton}"
                        Command="{Binding PlayMultiplayerCommand}"
                        ToolTip="Chế độ nhiều người chơi đang được phát triển.">
                    <StackPanel>
                        <TextBlock Text="🎮"
                                   FontSize="44"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="MULTIPLAYER"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushInk}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding MultiplayerSubtitle}"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Grid>

        <!-- CỘT PHẢI: top người chơi -->
        <Border Grid.Column="4"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushRule}"
                BorderThickness="1"
                CornerRadius="6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource BrushRule}"
                        BorderThickness="0,0,0,1"
                        Padding="12,10">
                    <Grid>
                        <TextBlock Text="🏆  Bảng xếp hạng"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushInk}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Đang tải..."
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   HorizontalAlignment="Right"
                                   Visibility="{Binding IsLoadingTopPlayers,
                                                Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              MaxHeight="336"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding TopPlayers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="33" Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Rank}"
                                               FontFamily="{DynamicResource FontMono}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource BrushInkMuted}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Username}"
                                               FontFamily="{DynamicResource FontSans}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource BrushInk}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="4,0,6,0"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding BestScore}"
                                               FontFamily="{DynamicResource FontMono}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushInk}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TopPlayers.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="🏆" FontSize="28" HorizontalAlignment="Center" Opacity="0.5"/>
                    <TextBlock Text="Chưa có ai lọt bảng"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushInkMuted}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource BrushRule}"
                        BorderThickness="0,1,0,0"
                        Padding="10,6">
                    <TextBlock Text="Cuộn xem tiếp tối đa 100 người"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushInkMuted}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>