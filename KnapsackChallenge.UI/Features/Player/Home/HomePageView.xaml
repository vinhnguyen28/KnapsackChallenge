<!-- KnapsackChallenge.UI/Features/Player/Home/HomePageView.xaml -->
<UserControl x:Class="KnapsackChallenge.UI.Features.Player.HomePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="691" d:DesignWidth="1095"
             Background="Transparent">

    <UserControl.Resources>

        <!-- Nút "kính" cho cột trái + cột phải -->
        <Style x:Key="HomeQuickButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource HomeTextOnDark}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{StaticResource HomeGlassFill}"
                                BorderBrush="{StaticResource HomeGlassBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource HomeGlassFillHover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút kính kiểu link cho "Xem toàn bộ bảng xếp hạng →" -->
        <Style x:Key="HomeLinkGlassButton" TargetType="Button"
               BasedOn="{StaticResource HomeQuickButton}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- =========================================================
             ProgressBar EXP
             - Track cao 16px, bo góc 8, nền xám mờ (#33000000) để
               fill vàng nổi bật rõ rệt.
             - PART_Indicator PHẢI có VerticalAlignment="Stretch" thì
               mới cao đủ track — thiếu dòng này → indicator cao 0,
               không thấy thanh chạy dù Value đúng.
             - Fill gradient vàng gold đậm, sáng dần sang phải.
             ========================================================= -->
        <Style x:Key="HomeExpProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="16"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#33000000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"/>
                            <Grid>
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        CornerRadius="8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FCD34D" Offset="0"/>
                                            <GradientStop Color="#FBBF24" Offset="0.6"/>
                                            <GradientStop Color="#F59E0B" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#FBBF24"
                                                          BlurRadius="8"
                                                          ShadowDepth="0"
                                                          Opacity="0.5"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =========================================================
             FORMAT CHUNG CHO 3 THẺ: SỐ VÁN / ĐIỂM CAO NHẤT / CẤP ĐỘ & EXP
             ========================================================= -->
        <Style x:Key="HomeStatIconBase" TargetType="Border">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HomeStatIconOrange" TargetType="Border"
               BasedOn="{StaticResource HomeStatIconBase}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FDBA74" Offset="0"/>
                        <GradientStop Color="#F97316" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF9A3D" BlurRadius="14" ShadowDepth="0" Opacity="0.6"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeStatIconGold" TargetType="Border"
               BasedOn="{StaticResource HomeStatIconBase}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FCD34D" Offset="0"/>
                        <GradientStop Color="#D97706" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FBBF24" BlurRadius="14" ShadowDepth="0" Opacity="0.6"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeStatIconPurple" TargetType="Border"
               BasedOn="{StaticResource HomeStatIconBase}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#A78BFA" Offset="0"/>
                        <GradientStop Color="#6366F1" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#7C6CFF" BlurRadius="14" ShadowDepth="0" Opacity="0.6"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Emoji trong ô icon (giữ nguyên theo yêu cầu — không đụng) -->
        <Style x:Key="HomeStatEmoji" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HomeStatLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontSans}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
            <Setter Property="Foreground" Value="{StaticResource HomeTextOnDarkMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="HomeStatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource HomeGold}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- Halo: 3 vòng sáng radial để tạo chiều sâu -->
        <RadialGradientBrush x:Key="HomeHaloOrange"
                             GradientOrigin="0.5,0.5"
                             Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#FF9A3D" Offset="0"/>
            <GradientStop Color="#00FF9A3D" Offset="1"/>
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="HomeHaloPurple"
                             GradientOrigin="0.5,0.5"
                             Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#7C6CFF" Offset="0"/>
            <GradientStop Color="#007C6CFF" Offset="1"/>
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="HomeHaloBlue"
                             GradientOrigin="0.5,0.5"
                             Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#003B82F6" Offset="1"/>
        </RadialGradientBrush>

        <!-- =========================================================
             [ĐÃ SỬA] Bổ sung cho bảng Top cấp độ.
             Thêm mới 3 gradient brush (vàng/bạc/đồng) + 2 Geometry
             (ruy băng + đĩa huy chương). Toàn bộ key có tiền tố
             "HomeTop" để không đụng key cũ trong app.
             ========================================================= -->

        <!-- Gradient đĩa huy chương VÀNG (rank 1) -->
        <LinearGradientBrush x:Key="HomeTopGoldBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FDE68A" Offset="0"/>
            <GradientStop Color="#FBBF24" Offset="0.5"/>
            <GradientStop Color="#D97706" Offset="1"/>
        </LinearGradientBrush>

        <!-- Gradient đĩa huy chương BẠC (rank 2) -->
        <LinearGradientBrush x:Key="HomeTopSilverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F1F5F9" Offset="0"/>
            <GradientStop Color="#CBD5E1" Offset="0.5"/>
            <GradientStop Color="#94A3B8" Offset="1"/>
        </LinearGradientBrush>

        <!-- Gradient đĩa huy chương ĐỒNG (rank 3) -->
        <LinearGradientBrush x:Key="HomeTopBronzeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FCD34D" Offset="0"/>
            <GradientStop Color="#F59E0B" Offset="0.5"/>
            <GradientStop Color="#92400E" Offset="1"/>
        </LinearGradientBrush>

        <!-- Geometry ruy băng (2 mảnh) — đặt trên đĩa, khung 22x22 -->
        <Geometry x:Key="HomeTopMedalRibbonGeometry">
            M5,2 L9,2 L10.5,9 L6.5,9 Z
            M17,2 L13,2 L11.5,9 L15.5,9 Z
        </Geometry>

        <!-- Geometry đĩa tròn huy chương — tâm (11,15), bán kính 6 -->
        <Geometry x:Key="HomeTopMedalDiscGeometry">
            M5,15 A6,6 0 1,1 17,15 A6,6 0 1,1 5,15 Z
        </Geometry>

    </UserControl.Resources>

    <!-- Grid gốc: 3 lớp nền (solid fallback + ảnh + overlay) + halo + nội dung -->
    <Grid>

        <!-- Lớp 1: nền gradient dự phòng khi ảnh không nạp được -->
        <Rectangle Fill="{StaticResource HomeBackdropFallback}"/>

        <!-- Lớp 2: ảnh nền (nếu file có trong Assets/Backgrounds/home-bg.jpg) -->
        <Rectangle>
            <Rectangle.Fill>
                <ImageBrush ImageSource="pack://application:,,,/Assets/Backgrounds/home-bg.jpg"
                            Stretch="UniformToFill"/>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Lớp 3: overlay tối để chữ trắng nổi lên -->
        <Rectangle Fill="{StaticResource HomeOverlay}"/>

        <!-- Halo trang trí (lệch góc) — không nhận chuột -->
        <Ellipse Width="620" Height="620"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-220,-220,0,0"
                 Fill="{StaticResource HomeHaloOrange}"
                 Opacity="0.28"
                 IsHitTestVisible="False"/>
        <Ellipse Width="520" Height="520"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-180,-180"
                 Fill="{StaticResource HomeHaloPurple}"
                 Opacity="0.28"
                 IsHitTestVisible="False"/>
        <Ellipse Width="420" Height="420"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-140,-120,0"
                 Fill="{StaticResource HomeHaloBlue}"
                 Opacity="0.22"
                 IsHitTestVisible="False"/>

        <!-- Nội dung 3 cột -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Background="Transparent">
            <Grid MinWidth="1000" MinHeight="560" Margin="28,72">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24*" MinWidth="240" MaxWidth="340"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="52*" MinWidth="420"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="24*" MinWidth="260" MaxWidth="360"/>
                </Grid.ColumnDefinitions>

                <!-- ============================================================
                     CỘT TRÁI: 3 thẻ thống kê (kính) + shortcut (kính)
                     ============================================================ -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top">

                    <!-- ============ HEADER: THỐNG KÊ CỦA BẠN ============ -->
                    <Grid Margin="2,0,2,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="28" Height="28"
                                CornerRadius="9"
                                Background="#40FF9A3D"
                                BorderBrush="#80FF9A3D"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="📈"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="THỐNG KÊ CỦA BẠN"
                                   FontFamily="{DynamicResource FontMono}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource HomeTextOnDark}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,12,0"/>

                        <Rectangle Grid.Column="2"
                                   Height="1"
                                   VerticalAlignment="Center"
                                   Opacity="0.7">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#99FF9A3D" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>

                    <!-- SỐ VÁN ĐÃ CHƠI -->
                    <Border Style="{StaticResource HomeGlassCard}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource HomeStatIconOrange}">
                                <TextBlock Text="📊" Style="{StaticResource HomeStatEmoji}"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SỐ VÁN ĐÃ CHƠI" Style="{StaticResource HomeStatLabel}"/>
                                <TextBlock Text="{Binding GamesPlayedText}" Style="{StaticResource HomeStatValue}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ĐIỂM CAO NHẤT -->
                    <Border Style="{StaticResource HomeGlassCard}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource HomeStatIconGold}">
                                <TextBlock Text="🏅" Style="{StaticResource HomeStatEmoji}"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ĐIỂM CAO NHẤT" Style="{StaticResource HomeStatLabel}"/>
                                <TextBlock Text="{Binding BestScoreText}" Style="{StaticResource HomeStatValue}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ============ CẤP ĐỘ & EXP ============ -->
                    <Border Style="{StaticResource HomeGlassCard}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon cấp độ -->
                            <Border Grid.Column="0"
                                    Style="{StaticResource HomeStatIconPurple}"
                                    VerticalAlignment="Top">
                                <Path Data="M12,17.27 L18.18,21 L16.54,13.97 L22,9.24 L14.81,8.62 L12,2 L9.19,8.62 L2,9.24 L7.46,13.97 L5.82,21 Z"
                                      Width="24" Height="24"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FEF3C7" Offset="0"/>
                                            <GradientStop Color="#FBBF24" Offset="0.5"/>
                                            <GradientStop Color="#F59E0B" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                    <Path.Effect>
                                        <DropShadowEffect Color="#FBBF24"
                                                          BlurRadius="10"
                                                          ShadowDepth="0"
                                                          Opacity="0.85"/>
                                    </Path.Effect>
                                </Path>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="CẤP ĐỘ &amp; EXP" Style="{StaticResource HomeStatLabel}"/>
                                <TextBlock Text="{Binding LevelBadge}" Style="{StaticResource HomeStatValue}"/>

                                <Grid Margin="0,10,0,4">
                                    <ProgressBar Style="{StaticResource HomeExpProgressBar}"
                                                 Value="{Binding ExpProgressPercent, Mode=OneWay}"/>

                                    <TextBlock Text="{Binding ExpProgressPercent, StringFormat={}{0:0}%}"
                                               FontFamily="{DynamicResource FontMono}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="Black"
                                                              BlurRadius="4"
                                                              ShadowDepth="0"
                                                              Opacity="0.85"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Grid>

                                <TextBlock Text="{Binding ExpProgressText}"
                                           FontFamily="{DynamicResource FontMono}"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{StaticResource HomeTextOnDarkMuted}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ============ HEADER: TRUY CẬP NHANH ============ -->
                    <Grid Margin="2,14,2,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="28" Height="28"
                                CornerRadius="9"
                                Background="#407C6CFF"
                                BorderBrush="#807C6CFF"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="⚡"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="TRUY CẬP NHANH"
                                   FontFamily="{DynamicResource FontMono}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource HomeTextOnDark}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,12,0"/>

                        <Rectangle Grid.Column="2"
                                   Height="1"
                                   VerticalAlignment="Center"
                                   Opacity="0.7">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#997C6CFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>

                    <Button Style="{StaticResource HomeQuickButton}"
                            Command="{Binding OpenLeaderboardCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏆" Width="24" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Xếp hạng" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource HomeQuickButton}"
                            Command="{Binding OpenHistoryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜" Width="24" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Lịch sử" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ============================================================
                     CỘT GIỮA: welcome + 2 hero button (có khe 24px ở giữa)
                     ============================================================ -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,12,0,20">
                        <TextBlock Text="{Binding WelcomeText}"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource HomeTextOnDark}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  ShadowDepth="0"
                                                  Opacity="0.6"
                                                  Color="Black"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="Hãy chọn một chế độ để bắt đầu."
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{StaticResource HomeTextOnDarkMuted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1"
                          MaxWidth="760"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ============ SOLO ============ -->
                        <Button Grid.Column="0"
                                Style="{StaticResource HomeHeroButton}"
                                Background="{StaticResource HomeSoloGradient}"
                                Command="{Binding PlaySoloCommand}">
                            <StackPanel>
                                <TextBlock Text="🎯"
                                           FontSize="56"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="CHƠI SOLO"
                                           FontFamily="{DynamicResource FontSans}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource HomeTextOnDark}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Chinh phục bài toán cái túi"
                                           FontFamily="{DynamicResource FontSans}"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{StaticResource HomeTextOnDarkMuted}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>

                                <Border HorizontalAlignment="Center"
                                        Margin="0,12,0,0"
                                        Padding="10,4"
                                        CornerRadius="10"
                                        Background="#26FFFFFF"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled,
                                                    RelativeSource={RelativeSource AncestorType=Button}}"
                                                    Value="False">
                                                    <Setter Property="Background" Value="#1A000000"/>
                                                    <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource HomeOnlineDot}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled,
                                                            RelativeSource={RelativeSource AncestorType=Button}}"
                                                            Value="False">
                                                            <Setter Property="Fill" Value="#88FFFFFF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding SoloStatusText}"
                                                   FontFamily="{DynamicResource FontSans}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource HomeTextOnDark}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled,
                                                            RelativeSource={RelativeSource AncestorType=Button}}"
                                                            Value="False">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource HomeTextOnDarkMuted}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- ============ MULTIPLAYER ============ -->
                        <Button Grid.Column="2"
                                Style="{StaticResource HomeHeroButton}"
                                Background="{StaticResource HomeMultiGradient}"
                                Command="{Binding PlayMultiplayerCommand}"
                                ToolTip="Tạo hoặc vào phòng chơi cùng người khác.">
                            <StackPanel>
                                <TextBlock Text="🎮"
                                           FontSize="56"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="MULTIPLAYER"
                                           FontFamily="{DynamicResource FontSans}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource HomeTextOnDark}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Đấu trí cùng người chơi khác"
                                           FontFamily="{DynamicResource FontSans}"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{StaticResource HomeTextOnDarkMuted}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>

                                <Border HorizontalAlignment="Center"
                                        Margin="0,12,0,0"
                                        Padding="10,4"
                                        CornerRadius="10"
                                        Background="#26FFFFFF"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled,
                                                    RelativeSource={RelativeSource AncestorType=Button}}"
                                                    Value="False">
                                                    <Setter Property="Background" Value="#1A000000"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource HomeOnlineDot}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled,
                                                            RelativeSource={RelativeSource AncestorType=Button}}"
                                                            Value="False">
                                                            <Setter Property="Fill" Value="#88FFFFFF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding MultiplayerSubtitle}"
                                                   FontFamily="{DynamicResource FontSans}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource HomeTextOnDark}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled,
                                                            RelativeSource={RelativeSource AncestorType=Button}}"
                                                            Value="False">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource HomeTextOnDarkMuted}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <!-- ============================================================
                     CỘT PHẢI: Top cấp độ (kính)
                     ============================================================ -->
                <Border Grid.Column="4"
                        Style="{StaticResource HomeGlassCard}"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource HomeGlassBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="14,10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- [ĐÃ SỬA] (a) Header: thay emoji 🏆 bằng icon cúp vector
                                         tô gradient vàng + glow vàng nhẹ, cỡ 18x18, Stretch=Uniform.
                                         Geometry tái dùng IconTrophy có sẵn trong Themes/Icons.xaml. -->
                                    <Path Data="{DynamicResource IconTrophy}"
                                          Width="18" Height="18"
                                          Stretch="Uniform"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          VerticalAlignment="Center">
                                        <Path.Stroke>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FDE68A" Offset="0"/>
                                                <GradientStop Color="#FBBF24" Offset="0.5"/>
                                                <GradientStop Color="#D97706" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Path.Stroke>
                                        <Path.Effect>
                                            <DropShadowEffect Color="#FBBF24"
                                                              BlurRadius="8"
                                                              ShadowDepth="0"
                                                              Opacity="0.65"/>
                                        </Path.Effect>
                                    </Path>

                                    <TextBlock Text="Top cấp độ"
                                               FontFamily="{DynamicResource FontSans}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource HomeTextOnDark}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Text="Đang tải..."
                                           FontFamily="{DynamicResource FontSans}"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{StaticResource HomeTextOnDarkMuted}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsLoadingTopPlayers,
                                                        Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      MaxHeight="360"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding TopPlayers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Margin="6,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMe}" Value="True">
                                                            <Setter Property="Background" Value="#4DE8590C"/>
                                                            <Setter Property="BorderBrush"
                                                                    Value="{StaticResource BrushAccent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid Height="36" Margin="8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- =========================================================
                                                     [ĐÃ SỬA] (b) Cột 0 (Rank) — DataTemplate 22x22:
                                                     - Rank >= 4: hiển thị RankText (số thường).
                                                     - Rank 1/2/3: hiển thị huy chương vector
                                                       (ruy băng + đĩa tròn + số ở giữa).
                                                     KHÔNG sửa RankText / LeaderboardText.Medal().
                                                     ========================================================= -->
                                                <Grid Grid.Column="0"
                                                      Width="22" Height="22"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center">

                                                    <!-- Số thường cho rank >= 4 -->
                                                    <TextBlock x:Name="PlainRankText"
                                                               Text="{Binding RankText}"
                                                               FontFamily="{DynamicResource FontMono}"
                                                               FontSize="{DynamicResource FontSizeSmall}"
                                                               Foreground="{StaticResource HomeTextOnDarkMuted}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>

                                                    <!-- Huy chương VÀNG — rank 1 -->
                                                    <Grid x:Name="GoldMedal"
                                                          Width="22" Height="22"
                                                          Visibility="Collapsed"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center">
                                                        <!-- Ruy băng (2 mảnh) -->
                                                        <Path Data="{StaticResource HomeTopMedalRibbonGeometry}"
                                                              Fill="#A16207"/>
                                                        <!-- Đĩa tròn — gradient vàng + glow -->
                                                        <Path Data="{StaticResource HomeTopMedalDiscGeometry}"
                                                              Fill="{StaticResource HomeTopGoldBrush}">
                                                            <Path.Effect>
                                                                <DropShadowEffect Color="#FBBF24"
                                                                                  BlurRadius="6"
                                                                                  ShadowDepth="0"
                                                                                  Opacity="0.55"/>
                                                            </Path.Effect>
                                                        </Path>
                                                        <!-- Số 1 ở giữa đĩa -->
                                                        <TextBlock Text="1"
                                                                   FontFamily="{DynamicResource FontMono}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="#7C2D12"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,5,0,0"/>
                                                    </Grid>

                                                    <!-- Huy chương BẠC — rank 2 -->
                                                    <Grid x:Name="SilverMedal"
                                                          Width="22" Height="22"
                                                          Visibility="Collapsed"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center">
                                                        <Path Data="{StaticResource HomeTopMedalRibbonGeometry}"
                                                              Fill="#64748B"/>
                                                        <Path Data="{StaticResource HomeTopMedalDiscGeometry}"
                                                              Fill="{StaticResource HomeTopSilverBrush}"/>
                                                        <TextBlock Text="2"
                                                                   FontFamily="{DynamicResource FontMono}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="#334155"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,5,0,0"/>
                                                    </Grid>

                                                    <!-- Huy chương ĐỒNG — rank 3 -->
                                                    <Grid x:Name="BronzeMedal"
                                                          Width="22" Height="22"
                                                          Visibility="Collapsed"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center">
                                                        <Path Data="{StaticResource HomeTopMedalRibbonGeometry}"
                                                              Fill="#7C2D12"/>
                                                        <Path Data="{StaticResource HomeTopMedalDiscGeometry}"
                                                              Fill="{StaticResource HomeTopBronzeBrush}"/>
                                                        <TextBlock Text="3"
                                                                   FontFamily="{DynamicResource FontMono}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="#FFFFFF"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,5,0,0"/>
                                                    </Grid>
                                                </Grid>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Username}"
                                                           FontFamily="{DynamicResource FontSans}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="4,0,6,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource HomeTextOnDark}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Rank}" Value="1">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource HomeGold}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Rank}" Value="2">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource HomeSilver}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Rank}" Value="3">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource HomeBronze}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding LevelText}"
                                                           FontFamily="{DynamicResource FontMono}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           Foreground="{StaticResource HomeTextOnDarkMuted}"
                                                           VerticalAlignment="Center"
                                                           Margin="6,0"/>

                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding ExpText}"
                                                           FontFamily="{DynamicResource FontMono}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource HomeTextOnDark}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                        <!-- [ĐÃ SỬA] DataTriggers để chuyển PlainRankText ↔ Gold/Silver/BronzeMedal -->
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Rank}" Value="1">
                                                <Setter TargetName="PlainRankText" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="GoldMedal" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Rank}" Value="2">
                                                <Setter TargetName="PlainRankText" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="SilverMedal" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Rank}" Value="3">
                                                <Setter TargetName="PlainRankText" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="BronzeMedal" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TopPlayers.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <!-- [ĐÃ SỬA] (c) Empty state: thay emoji 🏆 bằng icon cúp vector
                                 cỡ 36, màu xám-tím nhạt, Opacity 0.6, có glow nhẹ. -->
                            <Path Data="{DynamicResource IconTrophy}"
                                  Width="36" Height="36"
                                  Stretch="Uniform"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stroke="#A5A5C8"
                                  Opacity="0.6"
                                  HorizontalAlignment="Center">
                                <Path.Effect>
                                    <DropShadowEffect Color="#7C6CFF"
                                                      BlurRadius="8"
                                                      ShadowDepth="0"
                                                      Opacity="0.5"/>
                                </Path.Effect>
                            </Path>
                            <TextBlock Text="Chưa có ai lọt bảng"
                                       FontFamily="{DynamicResource FontSans}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{StaticResource HomeTextOnDarkMuted}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="{Binding MyRankLine}"
                                       FontFamily="{DynamicResource FontSans}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource HomeTextOnDark}"
                                       TextWrapping="Wrap"
                                       Margin="12,8,12,0"
                                       Visibility="{Binding HasMyRankLine,
                                                    Converter={StaticResource BoolToVisibility}}"/>

                            <Border BorderBrush="{StaticResource HomeGlassBorder}"
                                    BorderThickness="0,1,0,0"
                                    Padding="10,8"
                                    Margin="0,6,0,0">
                                <Button Command="{Binding OpenLeaderboardCommand}"
                                        Style="{StaticResource HomeLinkGlassButton}"
                                        Content="Xem toàn bộ bảng xếp hạng →"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>