<UserControl x:Class="KnapsackChallenge.UI.Features.Player.SoloGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:KnapsackChallenge.UI.Features.Player"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="900"
             Background="{DynamicResource BrushBackground}">

    <UserControl.Resources>
        <Style x:Key="CapacityBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{DynamicResource BrushRule}" CornerRadius="2"/>
                            <Rectangle x:Name="PART_Indicator"
                                       Fill="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Left"
                                       RadiusX="2" RadiusY="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOverWeight}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,14,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =========================================================
             ROW 0: 2 nút quay lại (bên trái) + Timer (bên phải)
             ========================================================= -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding GoHomeCommand}"
                    Style="{DynamicResource ButtonGhost}"
                    Padding="12,8"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{DynamicResource IconArrowLeft}"
                          Width="14" Height="14"
                          Stroke="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"/>
                    <TextBlock Text="Về trang chủ" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="1"
                    Command="{Binding ChooseAnotherSetCommand}"
                    Style="{DynamicResource ButtonSecondary}"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{DynamicResource IconRefresh}"
                          Width="14" Height="14"
                          Stroke="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"/>
                    <TextBlock Text="Chọn mức độ khác" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding TimerLabel, Mode=OneWay}"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushInkMuted}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock Text="{Binding TimerText, Mode=OneWay}"
                           FontFamily="{DynamicResource FontMono}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushInk}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- =========================================================
             ROW 1: thông tin bộ đề hiện tại
             ========================================================= -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Bộ đề hiện tại"
                       FontFamily="{DynamicResource FontSans}"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushInkMuted}"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="{Binding CurrentSetName, Mode=OneWay}"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushInk}"
                           VerticalAlignment="Center"/>
                <Border Padding="8,2"
                        BorderThickness="1"
                        CornerRadius="2"
                        Background="Transparent"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        BorderBrush="{DynamicResource BrushRule}">
                    <TextBlock Text="{Binding CurrentDifficulty, Mode=OneWay}"
                               Style="{StaticResource MonoCaptionTextStyle}"
                               Foreground="{DynamicResource BrushInkMuted}"/>
                </Border>
                <Border Padding="8,2"
                        BorderThickness="1"
                        CornerRadius="2"
                        Background="Transparent"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding SoloModeDisabled,
                                     Converter={StaticResource BoolToVisibility}}"
                        BorderBrush="{DynamicResource BrushDanger}">
                    <TextBlock Text="CHẾ ĐỘ TẠM ĐÓNG"
                               Style="{StaticResource MonoCaptionTextStyle}"
                               Foreground="{DynamicResource BrushDanger}"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- =========================================================
             ROW 2: banner thông báo
             ========================================================= -->
        <Grid Grid.Row="2" MinHeight="42" Margin="0,0,0,8">
            <Border Style="{DynamicResource InfoBanner}" Margin="0" VerticalAlignment="Top">
                <TextBlock Text="{Binding PlayInfo}"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource BrushSuccess}"
                           TextWrapping="Wrap"/>
            </Border>
            <Border Style="{DynamicResource ErrorBanner}" Margin="0" VerticalAlignment="Top">
                <TextBlock Text="{Binding PlayError}"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource BrushDanger}"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>

        <!-- =========================================================
             ROW 3: lưới vật phẩm
             ========================================================= -->
        <Border Grid.Row="3"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushRule}"
                BorderThickness="1"
                CornerRadius="2"
                Padding="6">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding GameItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="4"
                                        Width="150" Height="96"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.ToggleItemCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd"
                                                    CornerRadius="2"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource BrushRule}"
                                                    Background="{DynamicResource BrushSurface}">
                                                <Grid Margin="10,8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0"
                                                               Text="{Binding Name}"
                                                               FontFamily="{DynamicResource FontSans}"
                                                               FontSize="{DynamicResource FontSizeBody}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushInk}"
                                                               TextTrimming="CharacterEllipsis"/>

                                                    <StackPanel Grid.Row="2">
                                                        <TextBlock FontFamily="{DynamicResource FontMono}"
                                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                                   Foreground="{DynamicResource BrushInkMuted}">
                                                            <Run Text="KL: "/>
                                                            <Run Text="{Binding Weight, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock FontFamily="{DynamicResource FontMono}"
                                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                                   Foreground="{DynamicResource BrushInkMuted}">
                                                            <Run Text="GT: "/>
                                                            <Run Text="{Binding Value, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <TextBlock Grid.Row="0"
                                                               Text="✓"
                                                               FontFamily="{DynamicResource FontSans}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushSuccess}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Top"
                                                               Visibility="Collapsed"
                                                               x:Name="OptimalMark"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush"
                                                            Value="{DynamicResource BrushAccent}"/>
                                                    <Setter TargetName="bd" Property="Background"
                                                            Value="{DynamicResource BrushAccentSoft}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOptimal}" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush"
                                                            Value="{DynamicResource BrushSuccess}"/>
                                                    <Setter TargetName="OptimalMark" Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasGame}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Path Data="{DynamicResource IconBackpack}"
                          Width="44" Height="44"
                          Stroke="{DynamicResource BrushInkMuted}"
                          StrokeThickness="1.2"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          Opacity="0.5"/>
                    <TextBlock Text="Đang tải bộ đề..."
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource BrushInkMuted}"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =========================================================
             ROW 4: thanh sức chứa
             ========================================================= -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ProgressBar Grid.Row="0"
                         Style="{StaticResource CapacityBar}"
                         Value="{Binding CapacityPercent, Mode=OneWay}"/>

            <Grid Grid.Row="1" Margin="0,6,0,0">
                <TextBlock Text="{Binding CapacityText, Mode=OneWay}"
                           FontFamily="{DynamicResource FontMono}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource BrushInk}"/>
                <TextBlock Text="Vượt sức chứa!"
                           FontFamily="{DynamicResource FontMono}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushDanger}"
                           HorizontalAlignment="Right"
                           Visibility="{Binding IsOverWeight,
                                        Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Grid>

        <!-- =========================================================
             ROW 5: hành động / kết quả
             ========================================================= -->
        <Grid Grid.Row="5" Margin="0,14,0,0" MinHeight="68">
            <Grid x:Name="PlayActions">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasResult}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding ResetCommand}"
                            Style="{DynamicResource ButtonSecondary}"
                            Padding="16,10"
                            Margin="0,0,8,0"
                            Content="Làm lại"/>
                    <Button Command="{Binding SubmitCommand}"
                            Style="{DynamicResource ButtonPrimary}"
                            Padding="20,10"
                            Content="Nộp bài"/>
                </StackPanel>
            </Grid>

            <Border x:Name="ResultPanel"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushRule}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="16,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasResult}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Result.StarText, Mode=OneWay}"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="26"
                                   Foreground="{DynamicResource BrushAccent}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Xếp hạng"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock FontFamily="{DynamicResource FontMono}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource BrushInk}">
                            <Run Text="Điểm của bạn: "/>
                            <Run Text="{Binding Result.Score, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text=" / Tối ưu: "/>
                            <Run Text="{Binding Result.OptimalValue, Mode=OneWay}"/>
                            <Run Text=" ("/>
                            <Run Text="{Binding Result.OptimalPercent, StringFormat={}{0:0.0}, Mode=OneWay}"/>
                            <Run Text="%)"/>
                        </TextBlock>
                        <TextBlock FontFamily="{DynamicResource FontMono}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   Margin="0,4,0,0">
                            <Run Text="Khối lượng: "/>
                            <Run Text="{Binding Result.TotalWeight, Mode=OneWay}"/>
                            <Run Text=" / "/>
                            <Run Text="{Binding Result.MaxWeight, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Command="{Binding PlayAgainCommand}"
                                Style="{DynamicResource ButtonSecondary}"
                                Padding="14,9"
                                Margin="0,0,8,0"
                                Content="Chơi lại"/>
                        <Button Command="{Binding ChooseAnotherSetCommand}"
                                Style="{DynamicResource ButtonPrimary}"
                                Padding="14,9"
                                Content="Chọn mức độ khác"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>