<UserControl x:Class="KnapsackChallenge.UI.Features.Player.MainPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:player="clr-namespace:KnapsackChallenge.UI.Features.Player"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="900"
             Background="{DynamicResource BrushBackground}">

    <UserControl.Resources>
        <!-- DataTemplate ViewModel -> View cho vùng nội dung. -->
        <DataTemplate DataType="{x:Type player:HomePageViewModel}">
            <player:HomePageView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type player:SetSelectionViewModel}">
            <player:SetSelectionView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type player:SoloGameViewModel}">
            <player:SoloGameView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type player:LeaderboardViewModel}">
            <player:LeaderboardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type player:HistoryViewModel}">
            <player:HistoryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type player:PlayerPlaceholderViewModel}">
            <player:PlayerPlaceholderView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type player:LobbyViewModel}">
            <player:LobbyView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type player:MultiplayerRoomViewModel}">
            <player:MultiplayerRoomView />
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushRule}"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <Grid Height="52">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="KNAPSACK"
                               FontFamily="{DynamicResource FontMono}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushInk}"
                               VerticalAlignment="Center"/>

                    <Rectangle Width="1" Height="18"
                               Fill="{DynamicResource BrushRule}"
                               Margin="14,0"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding SelectedNavItem.Title}"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource BrushInkMuted}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="10,4"
                            BorderThickness="1"
                            CornerRadius="2"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BrushDanger}"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <TextBlock Text="{Binding HeartsBadge}"
                                   FontFamily="{DynamicResource FontMono}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushDanger}"/>
                    </Border>

                    <Border Padding="10,4"
                            BorderThickness="1"
                            CornerRadius="2"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BrushAccent}"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                        <TextBlock Text="{Binding RankBadge}"
                                   FontFamily="{DynamicResource FontMono}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushAccent}"/>
                    </Border>

                    <TextBlock Text="{Binding PlayerUsername, Mode=OneWay}"
                               FontFamily="{DynamicResource FontMono}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource BrushInkMuted}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"/>

                    <Button x:Name="SettingsButton"
                            Command="{Binding ToggleSettingsCommand}"
                            Style="{DynamicResource ButtonGhost}"
                            Padding="8,6"
                            ToolTip="Cài đặt">
                        <Path Data="{DynamicResource IconSettings}"
                              Width="16" Height="16"
                              Stroke="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              Stretch="Uniform"
                              VerticalAlignment="Center"/>
                    </Button>

                    <Popup IsOpen="{Binding IsSettingsOpen, Mode=TwoWay}"
                           StaysOpen="False"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=SettingsButton}"
                           HorizontalOffset="-160"
                           VerticalOffset="4"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushRule}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="4"
                                MinWidth="200"
                                Margin="0,4,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="2"
                                                  Opacity="0.2"
                                                  Color="Black"/>
                            </Border.Effect>

                            <StackPanel>
                                <Button Command="{Binding ShowProfileCommand}"
                                        Style="{DynamicResource MenuPopupItem}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="👤" Width="22" FontSize="14"/>
                                        <TextBlock Text="Hồ sơ" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ShowEnterCodeCommand}"
                                        Style="{DynamicResource MenuPopupItem}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎁" Width="22" FontSize="14"/>
                                        <TextBlock Text="Nhập code" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ShowSocialCommand}"
                                        Style="{DynamicResource MenuPopupItem}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🌐" Width="22" FontSize="14"/>
                                        <TextBlock Text="Mạng xã hội" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Rectangle Height="1"
                                           Fill="{DynamicResource BrushRule}"
                                           Margin="6,4"/>

                                <Button Command="{Binding LogoutCommand}"
                                        Style="{DynamicResource MenuPopupLogoutItem}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🚪" Width="22" FontSize="14"/>
                                        <TextBlock Text="Đăng xuất" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY: chỉ ContentControl -->
        <Grid Grid.Row="1">
            <ContentControl Content="{Binding CurrentPage}"/>
        </Grid>
    </Grid>
</UserControl>