<UserControl x:Class="KnapsackChallenge.UI.Features.Player.MainPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:player="clr-namespace:KnapsackChallenge.UI.Features.Player"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="900"
             Background="{DynamicResource BrushBackground}">

    <UserControl.Resources>
        <!-- DataTemplate ViewModel -> View cho vùng nội dung. -->
        <DataTemplate DataType="{x:Type player:HomePageViewModel}">
            <player:HomePageView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type player:SetSelectionViewModel}">
            <player:SetSelectionView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type player:SoloGameViewModel}">
            <player:SoloGameView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type player:LeaderboardViewModel}">
            <player:LeaderboardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type player:HistoryViewModel}">
            <player:HistoryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type player:PlayerPlaceholderViewModel}">
            <player:PlayerPlaceholderView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type player:LobbyViewModel}">
            <player:LobbyView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type player:MultiplayerRoomViewModel}">
            <player:MultiplayerRoomView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type player:MultiplayerGameViewModel}">
            <player:MultiplayerGameView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type player:MultiplayerResultViewModel}">
            <player:MultiplayerResultView />
        </DataTemplate>

        <!-- =========================================================
             HEADER ICON BUTTON
             - 36x36, ControlTemplate hình tròn (Border CornerRadius=18)
             - Background HeaderPillFill, hover HeaderPillFillHover
             - Icon bánh răng vẽ BẰNG FILL (không Stroke), tự xoay
               0 -> 45 độ trong 0.25s khi hover, trả về 0 khi rời chuột
             - Focus visual bị loại bỏ để không có viền xấu
             ========================================================= -->
        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource HeaderPillFill}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                CornerRadius="18"
                                Background="{TemplateBinding Background}">
                            <Path x:Name="iconPath"
                                  Data="{DynamicResource IconGear}"
                                  Fill="{DynamicResource HeaderIcon}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="GearRotate" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource HeaderPillFillHover}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GearRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="45"
                                                             Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GearRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="0"
                                                             Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- =========================================================
         LAYOUT
         - ContentControl TRẢI CẢ 2 ROW (Grid.RowSpan=2): để nền của
           trang (ví dụ ảnh nền + overlay của HomePageView) phủ lên
           toàn bộ vùng nội dung, kể cả dải phía trên nơi header nằm.
         - Header nổi lên trên bằng Panel.ZIndex=1, nền Transparent
           nên thấy xuyên qua được nền ảnh của trang.
         ========================================================= -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Content phủ toàn bộ grid (RowSpan=2) → nền ảnh kéo dài
             lên tận mép trên, không còn bị "ngăn cách" bởi dải be. -->
        <ContentControl Grid.Row="0" Grid.RowSpan="2"
                        Content="{Binding CurrentPage}"/>

        <!-- Header nổi trên content. Khi IsHeaderVisible=False → Collapsed,
             không chiếm chỗ, không ảnh hưởng gì. -->
        <Border Grid.Row="0"
                Visibility="{Binding IsHeaderVisible,
                             Converter={StaticResource BoolToVisibility}}"
                Background="Transparent"
                BorderThickness="0"
                Padding="20,0"
                VerticalAlignment="Top"
                Panel.ZIndex="1">
            <Grid Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Cot trai: trong -->

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- =========================================================
                         VIÊN THUỐC TIM
                         ========================================================= -->
                    <Border Background="{DynamicResource HeaderPillFill}"
                            Padding="12,6"
                            CornerRadius="18"
                            BorderThickness="1"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            ToolTipService.InitialShowDelay="100"
                            ToolTipService.ShowDuration="60000"
                            ToolTipService.Placement="Bottom"
                            ToolTipService.VerticalOffset="6">

                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#80FF4D6D"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HeartIsLow}" Value="True">
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource HeartLow}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HeartIsEmpty}" Value="True">
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource HeartEmpty}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Border.ToolTip>
                            <ToolTip Placement="Bottom"
                                     VerticalOffset="6"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     HasDropShadow="False"
                                     DataContext="{Binding PlacementTarget.DataContext,
                                                 RelativeSource={RelativeSource Self}}">
                                <ToolTip.Template>
                                    <ControlTemplate TargetType="ToolTip">
                                        <Border Background="{DynamicResource TooltipBackground}"
                                                BorderBrush="{DynamicResource HeaderBorder}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14,12"
                                                MaxWidth="280">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12"
                                                                  ShadowDepth="2"
                                                                  Opacity="0.35"
                                                                  Color="Black"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,0,0,6">
                                                    <Path Data="{DynamicResource IconHeart}"
                                                          Fill="{DynamicResource HeartFill}"
                                                          Width="14" Height="14"
                                                          Stretch="Uniform"
                                                          VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding HeartTooltipTitle}"
                                                               FontFamily="{DynamicResource FontSans}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"
                                                               VerticalAlignment="Center"
                                                               Margin="6,0,0,0"/>
                                                </StackPanel>

                                                <TextBlock Text="{Binding HeartTooltipDescription}"
                                                           FontFamily="{DynamicResource FontSans}"
                                                           FontSize="12"
                                                           Foreground="#C7CCE0"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,6"/>

                                                <TextBlock Text="{Binding HeartRefillRuleText}"
                                                           FontFamily="{DynamicResource FontSans}"
                                                           FontSize="12"
                                                           Foreground="#C7CCE0"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,8"/>

                                                <Rectangle Height="1"
                                                           Fill="{DynamicResource HeaderBorder}"
                                                           Margin="0,0,0,8"/>

                                                <TextBlock Text="{Binding HeartCountdownText}"
                                                           FontFamily="{DynamicResource FontMono}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource HeartLow}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </ToolTip.Template>
                            </ToolTip>
                        </Border.ToolTip>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{DynamicResource IconHeart}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  RenderTransformOrigin="0.5,0.5"
                                  VerticalAlignment="Center">
                                <Path.Effect>
                                    <DropShadowEffect Color="#FF4D6D"
                                                      BlurRadius="10"
                                                      ShadowDepth="0"
                                                      Opacity="0.6"/>
                                </Path.Effect>
                                <Path.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Path.RenderTransform>
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="{DynamicResource HeartFill}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HeartIsLow}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource HeartLow}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HeartIsEmpty}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource HeartEmpty}"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Name="HeartPulseBeginStoryboard">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                From="1.0" To="1.2"
                                                                Duration="0:0:0.6"
                                                                AutoReverse="True"/>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                From="1.0" To="1.2"
                                                                Duration="0:0:0.6"
                                                                AutoReverse="True"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="HeartPulseBeginStoryboard"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <TextBlock Text="{Binding HeartCountText}"
                                       FontFamily="{DynamicResource FontMono}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HeartIsLow}" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource HeartLow}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HeartIsEmpty}" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource HeartEmpty}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Button x:Name="SettingsButton"
                            Command="{Binding ToggleSettingsCommand}"
                            Style="{StaticResource HeaderIconButton}"
                            ToolTip="Cài đặt"/>

                    <Popup IsOpen="{Binding IsSettingsOpen, Mode=TwoWay}"
                           StaysOpen="False"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=SettingsButton}"
                           HorizontalOffset="-160"
                           VerticalOffset="4"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushRule}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="4"
                                MinWidth="200"
                                Margin="0,4,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="2"
                                                  Opacity="0.2"
                                                  Color="Black"/>
                            </Border.Effect>

                            <StackPanel>
                                <Button Command="{Binding ShowProfileCommand}"
                                        Style="{DynamicResource MenuPopupItem}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="👤" Width="22" FontSize="14"/>
                                        <TextBlock Text="Hồ sơ" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ShowEnterCodeCommand}"
                                        Style="{DynamicResource MenuPopupItem}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎁" Width="22" FontSize="14"/>
                                        <TextBlock Text="Nhập code" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ShowSocialCommand}"
                                        Style="{DynamicResource MenuPopupItem}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🌐" Width="22" FontSize="14"/>
                                        <TextBlock Text="Mạng xã hội" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Rectangle Height="1"
                                           Fill="{DynamicResource BrushRule}"
                                           Margin="6,4"/>

                                <Button Command="{Binding LogoutCommand}"
                                        Style="{DynamicResource MenuPopupLogoutItem}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🚪" Width="22" FontSize="14"/>
                                        <TextBlock Text="Đăng xuất" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>