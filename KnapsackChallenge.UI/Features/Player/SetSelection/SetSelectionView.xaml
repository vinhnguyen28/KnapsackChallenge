<UserControl x:Class="KnapsackChallenge.UI.Features.Player.SetSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="900"
             Background="{DynamicResource BrushBackground}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,4">
            <TextBlock Text="Chọn mức độ"
                       FontFamily="{DynamicResource FontSans}"
                       FontSize="{DynamicResource FontSizeDisplay}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushInk}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Hệ thống sẽ chọn ngẫu nhiên một bộ đề trong mức bạn chọn."
                       FontFamily="{DynamicResource FontSans}"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource BrushInkMuted}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Banner lỗi -->
        <Border Grid.Row="1"
                Style="{DynamicResource ErrorBanner}"
                VerticalAlignment="Top"
                Margin="0,8,0,0">
            <TextBlock Text="{Binding ErrorMessage}"
                       FontFamily="{DynamicResource FontSans}"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource BrushDanger}"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- 3 thẻ mức độ -->
        <ItemsControl Grid.Row="2"
                      ItemsSource="{Binding Difficulties}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      MaxWidth="900"
                      Margin="0,8,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.ChooseDifficultyCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <!-- Kế thừa GameCardButton (có animation scale) - thêm ràng buộc
                             kích thước cho layout 3 thẻ + DataTrigger đổi màu viền theo mức. -->
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GameCardButton}">
                                <Setter Property="MinWidth"  Value="180"/>
                                <Setter Property="MaxWidth"  Value="300"/>
                                <Setter Property="MinHeight" Value="240"/>
                                <Setter Property="MaxHeight" Value="320"/>
                                <Setter Property="Margin" Value="10"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Difficulty}" Value="Easy">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushSuccess}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Difficulty}" Value="Medium">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Difficulty}" Value="Hard">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <StackPanel>
                            <TextBlock Text="{Binding Icon}"
                                       FontSize="56"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding DisplayName}"
                                       FontFamily="{DynamicResource FontSans}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushInk}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Description}"
                                       FontFamily="{DynamicResource FontSans}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource BrushInkMuted}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding CountText}"
                                       FontFamily="{DynamicResource FontMono}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource BrushInkMuted}"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Footer: nút Quay lại to gấp đôi -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,6">
            <Button Command="{Binding BackCommand}"
                    Style="{DynamicResource ButtonSecondary}"
                    Padding="40,20">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{DynamicResource IconArrowLeft}"
                          Width="22" Height="22"
                          Stroke="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"/>
                    <TextBlock Text="Quay lại"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>