<UserControl x:Class="KnapsackChallenge.UI.Features.Player.SetSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shared="clr-namespace:KnapsackChallenge.UI.Shared.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1200"
             Background="Transparent">

    <UserControl.Resources>

        <Style x:Key="GlassBackButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource HomeGlassFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HomeGlassBorder}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="32,14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HomeGlassFillHover}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =========================================================
             DifficultyCardButton — FIX GĐ6:
             Tăng độ rõ nền tint theo độ khó:
               - AccentTint.Opacity: 0.4 → 0.85
               - Gradient stop alpha: #4D (30%) → #73 (45%)
               - GradientOrigin: 0.5,0 → 0.5,0.5 (tỏa đều hơn)
             ========================================================= -->
        <Style x:Key="DifficultyCardButton" TargetType="Button">
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="MaxWidth" Value="320"/>
            <Setter Property="MinHeight" Value="280"/>
            <Setter Property="MaxHeight" Value="360"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>

                            <!-- Nền kính cơ bản -->
                            <Border x:Name="GlassBg"
                                    CornerRadius="20"
                                    BorderThickness="1.5"
                                    BorderBrush="{DynamicResource HomeGlassBorder}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1FFFFFFF" Offset="0"/>
                                        <GradientStop Color="#0DFFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Nền accent radial — FIX: rõ hơn (Opacity 0.85) -->
                            <Border x:Name="AccentTint" CornerRadius="20" Opacity="0.85">
                                <Border.Background>
                                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5"
                                                         RadiusX="1" RadiusY="1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Hover glow theo độ khó -->
                            <Border x:Name="HoverEasy" BorderThickness="2" CornerRadius="20"
                                    Opacity="0" Visibility="Collapsed" BorderBrush="#34D399">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28" ShadowDepth="0"
                                                      Color="#34D399" Opacity="0.65"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="HoverMedium" BorderThickness="2" CornerRadius="20"
                                    Opacity="0" Visibility="Collapsed" BorderBrush="#FBBF24">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28" ShadowDepth="0"
                                                      Color="#FBBF24" Opacity="0.65"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="HoverHard" BorderThickness="2" CornerRadius="20"
                                    Opacity="0" Visibility="Collapsed" BorderBrush="#F87171">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28" ShadowDepth="0"
                                                      Color="#F87171" Opacity="0.65"/>
                                </Border.Effect>
                            </Border>

                            <!-- Top accent line -->
                            <Border x:Name="TopLine"
                                    BorderThickness="0,4,0,0"
                                    CornerRadius="20"
                                    BorderBrush="Transparent"/>

                            <Grid Margin="20,26,20,22">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border x:Name="IconCircle"
                                        Grid.Row="0"
                                        Width="82" Height="82"
                                        CornerRadius="41"
                                        BorderThickness="2"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,18">
                                    <Path Width="38" Height="38"
                                          Stretch="Uniform"
                                          StrokeThickness="2.0"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource IconTarget}"/>
                                                <Setter Property="Stroke" Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Difficulty}" Value="Easy">
                                                        <Setter Property="Data" Value="{StaticResource IconLeaf}"/>
                                                        <Setter Property="Stroke" Value="#34D399"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Difficulty}" Value="Medium">
                                                        <Setter Property="Data" Value="{StaticResource IconScale}"/>
                                                        <Setter Property="Stroke" Value="#FBBF24"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Difficulty}" Value="Hard">
                                                        <Setter Property="Data" Value="{StaticResource IconFlame}"/>
                                                        <Setter Property="Stroke" Value="#F87171"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Border>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding DisplayName}"
                                           FontFamily="{DynamicResource FontSans}"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2"
                                           Text="{Binding Description}"
                                           FontFamily="{DynamicResource FontSans}"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{DynamicResource HomeTextOnDarkMuted}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,18"/>

                                <StackPanel Grid.Row="3"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,20">
                                    <Border x:Name="Lvl1" Width="32" Height="7" CornerRadius="3.5"
                                            Background="#33FFFFFF" Margin="0,0,6,0"/>
                                    <Border x:Name="Lvl2" Width="32" Height="7" CornerRadius="3.5"
                                            Background="#33FFFFFF" Margin="0,0,6,0"/>
                                    <Border x:Name="Lvl3" Width="32" Height="7" CornerRadius="3.5"
                                            Background="#33FFFFFF"/>
                                </StackPanel>

                                <Border Grid.Row="4"
                                        Background="#1AFFFFFF"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="14,5"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CountText}"
                                               FontFamily="{DynamicResource FontMono}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>
                            </Grid>
                        </Grid>

                        <ControlTemplate.Triggers>

                            <!-- DỄ -->
                            <DataTrigger Binding="{Binding Difficulty}" Value="Easy">
                                <Setter TargetName="TopLine" Property="BorderBrush" Value="#34D399"/>
                                <Setter TargetName="IconCircle" Property="BorderBrush" Value="#34D399"/>
                                <Setter TargetName="IconCircle" Property="Background" Value="#3334D399"/>
                                <Setter TargetName="IconCircle" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#34D399"
                                                          BlurRadius="18" ShadowDepth="0"
                                                          Opacity="0.55"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="HoverEasy" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Lvl1" Property="Background" Value="#34D399"/>
                                <Setter TargetName="AccentTint" Property="Background">
                                    <Setter.Value>
                                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5"
                                                             RadiusX="1" RadiusY="1">
                                            <GradientStop Color="#7334D399" Offset="0"/>
                                            <GradientStop Color="#0D34D399" Offset="0.7"/>
                                            <GradientStop Color="#00000000" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                            <!-- BÌNH THƯỜNG -->
                            <DataTrigger Binding="{Binding Difficulty}" Value="Medium">
                                <Setter TargetName="TopLine" Property="BorderBrush" Value="#FBBF24"/>
                                <Setter TargetName="IconCircle" Property="BorderBrush" Value="#FBBF24"/>
                                <Setter TargetName="IconCircle" Property="Background" Value="#33FBBF24"/>
                                <Setter TargetName="IconCircle" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FBBF24"
                                                          BlurRadius="18" ShadowDepth="0"
                                                          Opacity="0.55"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="HoverMedium" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Lvl1" Property="Background" Value="#FBBF24"/>
                                <Setter TargetName="Lvl2" Property="Background" Value="#FBBF24"/>
                                <Setter TargetName="AccentTint" Property="Background">
                                    <Setter.Value>
                                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5"
                                                             RadiusX="1" RadiusY="1">
                                            <GradientStop Color="#73FBBF24" Offset="0"/>
                                            <GradientStop Color="#0DFBBF24" Offset="0.7"/>
                                            <GradientStop Color="#00000000" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                            <!-- KHÓ -->
                            <DataTrigger Binding="{Binding Difficulty}" Value="Hard">
                                <Setter TargetName="TopLine" Property="BorderBrush" Value="#F87171"/>
                                <Setter TargetName="IconCircle" Property="BorderBrush" Value="#F87171"/>
                                <Setter TargetName="IconCircle" Property="Background" Value="#33F87171"/>
                                <Setter TargetName="IconCircle" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#F87171"
                                                          BlurRadius="18" ShadowDepth="0"
                                                          Opacity="0.55"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="HoverHard" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Lvl1" Property="Background" Value="#F87171"/>
                                <Setter TargetName="Lvl2" Property="Background" Value="#F87171"/>
                                <Setter TargetName="Lvl3" Property="Background" Value="#F87171"/>
                                <Setter TargetName="AccentTint" Property="Background">
                                    <Setter.Value>
                                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5"
                                                             RadiusX="1" RadiusY="1">
                                            <GradientStop Color="#73F87171" Offset="0"/>
                                            <GradientStop Color="#0DF87171" Offset="0.7"/>
                                            <GradientStop Color="#00000000" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverEasy"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverMedium"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverHard"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.04" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.04" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverEasy"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverMedium"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverHard"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootGrid" Property="Opacity" Value="0.9"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0.97" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="0.97" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.04" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.04" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="GlassBg" Property="BorderBrush" Value="#80FFFFFF"/>
                                <Setter TargetName="GlassBg" Property="BorderThickness" Value="2"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <shared:DifficultyBackdrop Difficulty=""/>

        <Grid Margin="24,72,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,4">
                <TextBlock Text="Chọn mức độ"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeDisplay}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource HomeTextOnDark}"
                           HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black"
                                          BlurRadius="14"
                                          ShadowDepth="0"
                                          Opacity="0.55"/>
                    </TextBlock.Effect>
                </TextBlock>

                <Border Width="48" Height="3" CornerRadius="2"
                        Background="{DynamicResource HomeGold}"
                        Margin="0,10,0,12"
                        HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#FBBF24"
                                          BlurRadius="10"
                                          ShadowDepth="0"
                                          Opacity="0.7"/>
                    </Border.Effect>
                </Border>

                <TextBlock Text="Hệ thống sẽ chọn ngẫu nhiên một bộ đề trong mức bạn chọn."
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource HomeTextOnDarkMuted}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Style="{DynamicResource DkToastError}"
                    VerticalAlignment="Top"
                    Margin="0,10,0,0"
                    Visibility="{Binding ErrorMessage,
                                 Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconWarning}"
                          Width="14" Height="14"
                          Stroke="#F87171"
                          StrokeThickness="2.0"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="#FCA5A5"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2" Text="Đang tải bộ đề..."
                       FontFamily="{DynamicResource FontSans}"
                       FontSize="{DynamicResource FontSizeHeading}"
                       Foreground="{DynamicResource HomeTextOnDarkMuted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ItemsControl Grid.Row="2"
                          ItemsSource="{Binding Difficulties}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          MaxWidth="1000"
                          Margin="0,8,0,8">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource DifficultyCardButton}"
                                Command="{Binding DataContext.ChooseDifficultyCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Opacity="0">
                            <Button.RenderTransform>
                                <TranslateTransform Y="24"/>
                            </Button.RenderTransform>
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1"
                                                             Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="24" To="0"
                                                             Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,6">
                <Button Command="{Binding BackCommand}"
                        Style="{StaticResource GlassBackButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource IconArrowLeft}"
                              Width="22" Height="22"
                              Stroke="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"/>
                        <TextBlock Text="Quay lại"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>