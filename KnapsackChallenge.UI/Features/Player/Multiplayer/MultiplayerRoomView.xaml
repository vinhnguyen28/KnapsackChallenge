<UserControl x:Class="KnapsackChallenge.UI.Features.Player.MultiplayerRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="900"
             Background="{DynamicResource BrushBackground}">

    <UserControl.Resources>
        <Style x:Key="RoomPlayerRow" TargetType="DataGridRow"
               BasedOn="{StaticResource GridRow}"/>
        <Style x:Key="MiniGridButton" TargetType="Button" BasedOn="{StaticResource ButtonMini}"/>
    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============== HEADER ============== -->
        <Border Grid.Row="0"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushRule}"
                BorderThickness="1"
                CornerRadius="2"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Mã phòng"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushInkMuted}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding RoomCode, Mode=OneWay}"
                                   FontFamily="{DynamicResource FontMono}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushInk}"
                                   VerticalAlignment="Center"/>
                        <Button Command="{Binding CopyCodeCommand}"
                                Style="{DynamicResource ButtonGhost}"
                                Padding="8,4"
                                Margin="8,0,0,0"
                                ToolTip="Copy mã phòng">
                            <TextBlock Text="Copy" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="24,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding SetName, Mode=OneWay}"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushInk}"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border Style="{DynamicResource StampNeutral}" Margin="0,0,6,0">
                            <TextBlock Text="{Binding Difficulty, Mode=OneWay}"
                                       Style="{StaticResource MonoCaptionTextStyle}"
                                       Foreground="{DynamicResource BrushInkMuted}"/>
                        </Border>
                        <Border Style="{DynamicResource StampNeutral}" Margin="0,0,6,0">
                            <TextBlock Style="{StaticResource MonoCaptionTextStyle}"
                                       Foreground="{DynamicResource BrushInkMuted}">
                                <Run Text="Max "/>
                                <Run Text="{Binding MaxWeight, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                        <Border Style="{DynamicResource StampNeutral}">
                            <TextBlock Style="{StaticResource MonoCaptionTextStyle}"
                                       Foreground="{DynamicResource BrushInkMuted}">
                                <Run Text="⏱ "/>
                                <Run Text="{Binding TimeLimitText, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Border Padding="10,5" BorderThickness="1" CornerRadius="2"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BrushAccent}"
                            HorizontalAlignment="Right">
                        <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                   Style="{StaticResource MonoCaptionTextStyle}"
                                   Foreground="{DynamicResource BrushAccent}"/>
                    </Border>
                    <TextBlock Text="{Binding CreatedAtText, Mode=OneWay}"
                               FontFamily="{DynamicResource FontMono}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushInkMuted}"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============== BANNERS + HINT ============== -->
        <Grid Grid.Row="1" MinHeight="42" Margin="0,0,0,12">
            <Border Style="{DynamicResource InfoBanner}" Margin="0" VerticalAlignment="Top">
                <TextBlock Text="{Binding InfoMessage, Mode=OneWay}"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource BrushSuccess}"
                           TextWrapping="Wrap"/>
            </Border>
            <Border Style="{DynamicResource ErrorBanner}" Margin="0" VerticalAlignment="Top">
                <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource BrushDanger}"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>

        <!-- ============== BODY ============== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- PLAYER LIST -->
            <Border Grid.Column="0" Style="{DynamicResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource BrushRule}"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">
                        <Grid>
                            <TextBlock Text="Người chơi trong phòng"
                                       FontFamily="{DynamicResource FontSans}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushInkMuted}"/>
                            <TextBlock FontFamily="{DynamicResource FontMono}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource BrushInkMuted}"
                                       HorizontalAlignment="Right">
                                <Run Text="{Binding Players.Count, Mode=OneWay}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding MaxPlayers, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Players}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              CanUserResizeColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="44"
                              FontSize="{DynamicResource FontSizeBody}"
                              Foreground="{DynamicResource BrushInk}"
                              ColumnHeaderStyle="{DynamicResource GridColumnHeader}"
                              RowStyle="{StaticResource RoomPlayerRow}"
                              CellStyle="{DynamicResource GridCell}">
                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="NGƯỜI CHƠI" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Username}"
                                                       FontFamily="{DynamicResource FontSans}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       Foreground="{DynamicResource BrushInk}"
                                                       VerticalAlignment="Center"/>
                                            <Border Padding="6,2" BorderThickness="1" CornerRadius="2"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource BrushAccent}"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding HostBadge,
                                                                 Converter={StaticResource BoolToVisibility},
                                                                 ConverterParameter=nonempty}">
                                                <TextBlock Text="HOST"
                                                           Style="{StaticResource MonoCaptionTextStyle}"
                                                           Foreground="{DynamicResource BrushAccent}"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Left"
                                                Padding="6,2" BorderThickness="1" CornerRadius="2"
                                                Background="Transparent">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource BrushInkMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                            <Setter Property="BorderBrush"
                                                                    Value="{DynamicResource BrushSuccess}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource MonoCaptionTextStyle}">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource BrushInkMuted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource BrushSuccess}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Mời ra"
                                                Style="{DynamicResource MiniGridButton}"
                                                HorizontalAlignment="Left"
                                                Command="{Binding DataContext.KickPlayerCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- HOST PANEL -->
            <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="18">
                <StackPanel>
                    <TextBlock Text="Điều khiển phòng"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushInk}"/>

                    <Rectangle Height="1" Fill="{DynamicResource BrushRule}" Margin="0,10,0,16"/>

                    <!-- Non-host: hint text -->
                    <Border Padding="12,10"
                            Background="{DynamicResource BrushSurfaceAlt}"
                            BorderBrush="{DynamicResource BrushRule}"
                            BorderThickness="1" CornerRadius="2"
                            Visibility="{Binding IsNotHost,
                                         Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding HostHintText}"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Host: change set + start -->
                    <StackPanel Visibility="{Binding IsHost,
                                             Converter={StaticResource BoolToVisibility}}">

                        <TextBlock Text="Bộ đề của phòng"
                                   Style="{DynamicResource FieldLabel}"/>

                        <ComboBox ItemsSource="{Binding AvailableSets}"
                                  SelectedItem="{Binding SelectedSet, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayText"
                                  IsEnabled="{Binding CanChangeSet}"
                                  Style="{DynamicResource DarkComboBox}"
                                  Height="34"
                                  Margin="0,0,0,8"/>

                        <Button Command="{Binding ChangeSetCommand}"
                                Content="Áp dụng bộ đề"
                                Style="{DynamicResource ButtonSecondary}"
                                Margin="0,0,0,14"/>

                        <Rectangle Height="1" Fill="{DynamicResource BrushRule}" Margin="0,0,0,14"/>

                        <TextBlock Text="{Binding HostHintText}"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <Button Command="{Binding StartGameCommand}"
                                Style="{DynamicResource ButtonPrimary}"
                                Padding="16,11">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconChevronRight}"
                                      Width="14" Height="14"
                                      Stroke="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="Bắt đầu ván" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Rectangle Height="1" Fill="{DynamicResource BrushRule}" Margin="0,18,0,14"/>

                    <Button Command="{Binding LeaveRoomCommand}"
                            Style="{DynamicResource ButtonDanger}"
                            Padding="16,11">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconLogout}"
                                  Width="14" Height="14"
                                  Stroke="{Binding Foreground,
                                           RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Rời phòng" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>