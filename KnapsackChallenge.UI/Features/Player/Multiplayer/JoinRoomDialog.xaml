<Window x:Class="KnapsackChallenge.UI.Features.Player.JoinRoomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vào phòng" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushRule}"
            BorderThickness="1" CornerRadius="10" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.2" Color="Black"/>
        </Border.Effect>

        <StackPanel Margin="22,18,22,18">
            <TextBlock Text="Vào phòng"
                       FontFamily="{DynamicResource FontSans}"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushInk}"/>

            <Rectangle Height="1" Fill="{DynamicResource BrushRule}" Margin="0,10,0,16"/>

            <TextBlock Text="Nhập mã phòng (VD: M-ABC123)" Style="{DynamicResource FieldLabel}"/>

            <TextBox x:Name="CodeBox"
                     Style="{DynamicResource DarkTextBox}"
                     MaxLength="20"
                     CharacterCasing="Upper"/>

            <Grid MinHeight="36" Margin="0,10,0,12">
                <TextBlock x:Name="ErrorText"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource BrushDanger}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Hủy"
                        Click="Cancel_Click"
                        Style="{DynamicResource ButtonSecondary}"/>

                <Button Grid.Column="2" Content="Vào phòng"
                        Click="Confirm_Click"
                        Style="{DynamicResource ButtonPrimary}"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>