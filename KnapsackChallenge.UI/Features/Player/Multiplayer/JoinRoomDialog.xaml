<Window x:Class="KnapsackChallenge.UI.Features.Player.JoinRoomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vào phòng" Width="500" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Grid>
        <Border x:Name="ShellBorder"
                Style="{StaticResource DkDialogShell}"
                SizeChanged="ShellBorder_SizeChanged">
            <Grid>
                <!-- Lớp nền tối phủ đều dialog (không đổi theo độ khó vì
                     dialog này không chọn độ khó). -->
                <Border Background="#F01A1730" IsHitTestVisible="False"/>

                <StackPanel Margin="24,18,24,22">

                    <!-- ===== TITLE BAR (kéo được) ===== -->
                    <Grid x:Name="TitleBar"
                          Background="Transparent"
                          Height="36"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Path Data="{StaticResource IconChevronRight}"
                                  Width="16" Height="16"
                                  Stroke="{StaticResource HomeGold}"
                                  StrokeThickness="1.8"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"/>
                            <TextBlock Text="Vào phòng"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource HomeTextOnDark}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource DkDialogCloseButton}"
                                Click="Close_Click"
                                ToolTip="Đóng"/>
                    </Grid>

                    <Rectangle Height="1"
                               Fill="{StaticResource HomeGlassBorder}"
                               Margin="0,10,0,18"/>

                    <!-- ===== NHẬP MÃ PHÒNG ===== -->
                    <TextBlock Text="Nhập mã phòng (VD: M-ABC123)"
                               Style="{StaticResource DkFieldLabel}"/>

                    <!-- Giữ nguyên x:Name + CharacterCasing + MaxLength + sự kiện.
                         DkTextBox dùng Tag làm placeholder. -->
                    <TextBox x:Name="CodeBox"
                             Style="{StaticResource DkTextBox}"
                             MaxLength="20"
                             CharacterCasing="Upper"
                             Tag="M-XXXXXX"/>

                    <!-- ===== VÙNG LỖI (giữ layout, không nhảy) ===== -->
                    <Grid MinHeight="34" Margin="0,12,0,14">
                        <TextBlock x:Name="ErrorText"
                                   FontFamily="{StaticResource FontSans}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="#FCA5A5"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </Grid>

                    <!-- ===== ACTIONS ===== -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Hủy"
                                Click="Cancel_Click"
                                Style="{StaticResource DkButtonSecondary}"/>

                        <Button Grid.Column="2"
                                Content="Vào phòng"
                                Click="Confirm_Click"
                                Style="{StaticResource DkButtonPrimary}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>