<UserControl x:Class="KnapsackChallenge.UI.Features.Player.MultiplayerGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shared="clr-namespace:KnapsackChallenge.UI.Shared.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1200"
             Background="Transparent">

    <UserControl.Resources>

        <!-- Capacity bar tối — fill đổi màu theo độ khó; đỏ khi vượt tải. -->
        <Style x:Key="CapacityBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track">
                            <Border CornerRadius="5" Background="#22FFFFFF"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    CornerRadius="5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF9A3D" Offset="0"/>
                                        <GradientStop Color="#FBBF24" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding DifficultyKey}" Value="Easy">
                                <Setter TargetName="PART_Indicator" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#34D399" Offset="0"/>
                                            <GradientStop Color="#10B981" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DifficultyKey}" Value="Medium">
                                <Setter TargetName="PART_Indicator" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FBBF24" Offset="0"/>
                                            <GradientStop Color="#D97706" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DifficultyKey}" Value="Hard">
                                <Setter TargetName="PART_Indicator" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#F87171" Offset="0"/>
                                            <GradientStop Color="#B91C1C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOverWeight}" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Background" Value="#F87171"/>
                                <Setter TargetName="PART_Indicator" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#F87171"
                                                          BlurRadius="12"
                                                          ShadowDepth="0"
                                                          Opacity="0.7"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Item card glass — kích thước 160x110, chọn được, badge cam khi selected. -->
        <Style x:Key="MpItemCard" TargetType="Button">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="110"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource HomeTextOnDark}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="cardBg"
                                    CornerRadius="14"
                                    BorderThickness="1.5"
                                    BorderBrush="{StaticResource HomeGlassBorder}"
                                    Background="#14FFFFFF">
                                <Grid Margin="12,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Name}"
                                               FontFamily="{DynamicResource FontSans}"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource HomeTextOnDark}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding Name}"/>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                                        <Border CornerRadius="8"
                                                Padding="7,2"
                                                BorderThickness="1"
                                                Background="#1A3B82F6"
                                                BorderBrush="#803B82F6"
                                                Margin="0,0,6,0">
                                            <TextBlock FontFamily="{DynamicResource FontMono}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#93C5FD">
                                                <Run Text="{Binding Weight, Mode=OneWay}"/>
                                                <Run Text="kg"/>
                                            </TextBlock>
                                        </Border>
                                        <Border CornerRadius="8"
                                                Padding="7,2"
                                                BorderThickness="1"
                                                Background="#26FBBF24"
                                                BorderBrush="#80FBBF24">
                                            <TextBlock FontFamily="{DynamicResource FontMono}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FCD34D">
                                                <Run Text="{Binding Value, Mode=OneWay}"/>
                                                <Run Text="đ"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Badge check khi IsSelected -->
                            <Border x:Name="selBadge"
                                    Width="24" Height="24"
                                    CornerRadius="12"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,6,6,0"
                                    Background="#FF9A3D"
                                    Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF9A3D"
                                                      BlurRadius="10"
                                                      ShadowDepth="0"
                                                      Opacity="0.85"/>
                                </Border.Effect>
                                <Path Data="{StaticResource IconCheck}"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Stroke="White"
                                      StrokeThickness="2.4"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBg" Property="Background" Value="#1FFFFFFF"/>
                                <Setter TargetName="cardBg" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="cardBg" Property="BorderBrush" Value="#FF9A3D"/>
                                <Setter TargetName="cardBg" Property="Background" Value="#26FF9A3D"/>
                                <Setter TargetName="cardBg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF9A3D"
                                                          BlurRadius="16"
                                                          ShadowDepth="0"
                                                          Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="selBadge" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Player row (side panel). -->
        <Style x:Key="GamePlayerRow" TargetType="DataGridRow"
               BasedOn="{StaticResource DkListRow}">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>

    </UserControl.Resources>

    <!-- =========================================================
         NỀN động theo độ khó + nội dung.
         ========================================================= -->
    <Grid>
        <shared:DifficultyBackdrop Difficulty="{Binding DifficultyKey}"/>

        <Grid Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 0: Header -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Banner -->
                <RowDefinition Height="*"/>
                <!-- 2: Body (items + players) -->
                <RowDefinition Height="Auto"/>
                <!-- 3: Capacity bar -->
                <RowDefinition Height="Auto"/>
                <!-- 4: Actions / Result -->
            </Grid.RowDefinitions>

            <!-- =========================================================
                 ROW 0 — HEADER: mã phòng | bộ đề + chips | đồng hồ
                 ========================================================= -->
            <Border Grid.Row="0"
                    Background="{StaticResource HomeGlassFill}"
                    BorderBrush="{StaticResource HomeGlassBorder}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20,14"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mã phòng + progress -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="MÃ PHÒNG"
                                   Style="{StaticResource DkLabel}"/>
                        <TextBlock Text="{Binding RoomCode, Mode=OneWay}"
                                   FontFamily="{DynamicResource FontMono}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource HomeTextOnDark}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding ProgressText, Mode=OneWay}"
                                   FontFamily="{DynamicResource FontMono}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{StaticResource HomeTextOnDarkMuted}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Bộ đề + chips -->
                    <StackPanel Grid.Column="1" Margin="28,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SetName, Mode=OneWay}"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource HomeTextOnDark}"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black"
                                                  BlurRadius="10"
                                                  ShadowDepth="0"
                                                  Opacity="0.45"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <!-- Chip độ khó đổi màu -->
                            <Border CornerRadius="10"
                                    Padding="10,3"
                                    BorderThickness="1"
                                    Margin="0,0,8,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#26FFFFFF"/>
                                        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DifficultyKey}" Value="Easy">
                                                <Setter Property="Background" Value="#2634D399"/>
                                                <Setter Property="BorderBrush" Value="#8034D399"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DifficultyKey}" Value="Medium">
                                                <Setter Property="Background" Value="#26FBBF24"/>
                                                <Setter Property="BorderBrush" Value="#80FBBF24"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DifficultyKey}" Value="Hard">
                                                <Setter Property="Background" Value="#26F87171"/>
                                                <Setter Property="BorderBrush" Value="#80F87171"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="12" Height="12"
                                          Stretch="Uniform"
                                          StrokeThickness="1.6"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource IconTarget}"/>
                                                <Setter Property="Stroke" Value="{StaticResource HomeTextOnDark}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DifficultyKey}" Value="Easy">
                                                        <Setter Property="Data" Value="{StaticResource IconLeaf}"/>
                                                        <Setter Property="Stroke" Value="#6EE7B7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DifficultyKey}" Value="Medium">
                                                        <Setter Property="Data" Value="{StaticResource IconTarget}"/>
                                                        <Setter Property="Stroke" Value="#FCD34D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DifficultyKey}" Value="Hard">
                                                        <Setter Property="Data" Value="{StaticResource IconFlame}"/>
                                                        <Setter Property="Stroke" Value="#FCA5A5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="{Binding Difficulty, Mode=OneWay}"
                                               FontFamily="{DynamicResource FontSans}"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource HomeTextOnDark}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DifficultyKey}" Value="Easy">
                                                        <Setter Property="Foreground" Value="#6EE7B7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DifficultyKey}" Value="Medium">
                                                        <Setter Property="Foreground" Value="#FCD34D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DifficultyKey}" Value="Hard">
                                                        <Setter Property="Foreground" Value="#FCA5A5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Chip Max weight -->
                            <Border CornerRadius="10"
                                    Padding="10,3"
                                    BorderThickness="1"
                                    Background="#1FFFFFFF"
                                    BorderBrush="#33FFFFFF">
                                <TextBlock FontFamily="{DynamicResource FontMono}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource HomeTextOnDarkMuted}">
                                    <Run Text="Max "/>
                                    <Run Text="{Binding MaxWeight, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Đồng hồ -->
                    <Border Grid.Column="2"
                            CornerRadius="14"
                            Padding="18,10"
                            BorderThickness="2"
                            Background="{StaticResource HomeGlassFill}"
                            BorderBrush="{StaticResource HomeGlassBorder}"
                            VerticalAlignment="Center"
                            MinWidth="180">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCountdown}" Value="True">
                                        <Setter Property="BorderBrush" Value="#CCFF9A3D"/>
                                        <Setter Property="Background" Value="#1FFF9A3D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconClock}"
                                  Width="26" Height="26"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource HomeTextOnDarkMuted}"
                                  StrokeThickness="1.6"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding TimerLabel, Mode=OneWay}"
                                           FontFamily="{DynamicResource FontSans}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource HomeTextOnDarkMuted}"/>
                                <TextBlock Text="{Binding TimerText, Mode=OneWay}"
                                           FontFamily="{DynamicResource FontMono}"
                                           FontSize="32"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource HomeTextOnDark}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCountdown}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFB981"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- =========================================================
                 ROW 1 — BANNER
                 ========================================================= -->
            <Grid Grid.Row="1" MinHeight="42" Margin="0,0,0,14">
                <Border Style="{StaticResource DkToastInfo}"
                        VerticalAlignment="Top"
                        Visibility="{Binding InfoMessage,
                                     Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCheck}"
                              Width="14" Height="14"
                              Stroke="#34D399"
                              StrokeThickness="2.2"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding InfoMessage, Mode=OneWay}"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="#6EE7B7"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DkToastError}"
                        VerticalAlignment="Top"
                        Visibility="{Binding ErrorMessage,
                                     Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconWarning}"
                              Width="14" Height="14"
                              Stroke="#F87171"
                              StrokeThickness="2.0"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="#FCA5A5"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- =========================================================
                 ROW 2 — BODY: items (trái) + players (phải)
                 ========================================================= -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Lưới vật phẩm trong khung glass -->
                <Border Grid.Column="0"
                        Background="{StaticResource HomeGlassFill}"
                        BorderBrush="{StaticResource HomeGlassBorder}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="2">
                        <ItemsControl ItemsSource="{Binding GameItems}"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MpItemCard}"
                                            Command="{Binding DataContext.ToggleItemCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Side panel: người chơi -->
                <Border Grid.Column="2"
                        Background="{StaticResource HomeGlassFill}"
                        BorderBrush="{StaticResource HomeGlassBorder}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource LbRowDivider}"
                                BorderThickness="0,0,0,1"
                                Padding="16,12">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlayers}"
                                      Width="16" Height="16"
                                      Stroke="{StaticResource HomeTextOnDark}"
                                      StrokeThickness="1.5"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="Người chơi"
                                           FontFamily="{DynamicResource FontSans}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource HomeTextOnDark}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Players}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserResizeRows="False"
                                  CanUserResizeColumns="False"
                                  HeadersVisibility="None"
                                  GridLinesVisibility="None"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  RowHeight="54"
                                  FontSize="{DynamicResource FontSizeBody}"
                                  Foreground="{StaticResource HomeTextOnDark}"
                                  RowStyle="{StaticResource GamePlayerRow}"
                                  CellStyle="{StaticResource DkListCell}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Avatar tròn nhỏ -->
                                                <Border Width="30" Height="30" CornerRadius="15"
                                                        Background="{StaticResource LbAvatarBg}"
                                                        BorderBrush="{StaticResource LbAvatarBorder}"
                                                        BorderThickness="1"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AvatarInitial}"
                                                               FontFamily="{DynamicResource FontSans}"
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource HomeTextOnDark}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Username}"
                                                                   FontFamily="{DynamicResource FontSans}"
                                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource HomeTextOnDark}"/>
                                                        <Border Padding="5,1"
                                                                CornerRadius="5"
                                                                BorderThickness="1"
                                                                Background="#33FF9A3D"
                                                                BorderBrush="#80FF9A3D"
                                                                Margin="6,0,0,0"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsHost}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="HOST"
                                                                       FontFamily="{DynamicResource FontMono}"
                                                                       FontSize="9"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#FFB981"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontFamily="{DynamicResource FontMono}"
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               Foreground="{StaticResource HomeTextOnDarkMuted}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- =========================================================
                 ROW 3 — CAPACITY BAR
                 ========================================================= -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ProgressBar Grid.Row="0"
                             Style="{StaticResource CapacityBar}"
                             Value="{Binding CapacityPercent, Mode=OneWay}"/>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock Text="{Binding CapacityText, Mode=OneWay}"
                               FontFamily="{DynamicResource FontMono}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{StaticResource HomeTextOnDark}"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Visibility="{Binding IsOverWeight,
                                             Converter={StaticResource BoolToVisibility}}">
                        <Path Data="{StaticResource IconWarning}"
                              Width="14" Height="14"
                              Stroke="#F87171"
                              StrokeThickness="1.8"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0"/>
                        <TextBlock Text="Vượt sức chứa!"
                                   FontFamily="{DynamicResource FontMono}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   FontWeight="SemiBold"
                                   Foreground="#FCA5A5"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- =========================================================
                 ROW 4 — ACTIONS / MY RESULT
                 ========================================================= -->
            <Grid Grid.Row="4" Margin="0,16,0,0" MinHeight="76">

                <!-- Chưa nộp -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasResult}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Command="{Binding LeaveCommand}"
                                Style="{StaticResource DkButtonSecondary}"
                                Padding="16,12"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconLogout}"
                                      Width="14" Height="14"
                                      Stroke="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="Rời phòng" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SubmitCommand}"
                                Style="{StaticResource DkButtonPrimary}"
                                Padding="22,12"
                                Content="Nộp bài"/>
                    </StackPanel>
                </Grid>

                <!-- Đã nộp: panel kết quả tạm thời -->
                <Border Background="{StaticResource HomeGlassFill}"
                        BorderBrush="{StaticResource HomeGlassBorder}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasResult}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Star + nhãn -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ResultStarText, Mode=OneWay}"
                                       FontFamily="{DynamicResource FontSans}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="#FBBF24"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Xếp hạng"
                                       FontFamily="{DynamicResource FontSans}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{StaticResource HomeTextOnDarkMuted}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Điểm/tối ưu -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <WrapPanel>
                                <Border CornerRadius="10"
                                        Padding="10,4"
                                        BorderThickness="1"
                                        Background="#26FF9A3D"
                                        BorderBrush="#80FF9A3D"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Điểm"
                                                   FontFamily="{DynamicResource FontSans}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="#FFB981"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock FontFamily="{DynamicResource FontMono}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource HomeTextOnDark}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0">
                                            <Run Text="{Binding MyResult.Score, Mode=OneWay}"/>
                                            <Run Text="/"/>
                                            <Run Text="{Binding MyResult.OptimalValue, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border CornerRadius="10"
                                        Padding="10,4"
                                        BorderThickness="1"
                                        Background="#1A34D399"
                                        BorderBrush="#8034D399">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Tối ưu"
                                                   FontFamily="{DynamicResource FontSans}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="#6EE7B7"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock FontFamily="{DynamicResource FontMono}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#34D399"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"
                                                   Text="{Binding MyResult.OptimalPercent,
                                                          Mode=OneWay,
                                                          StringFormat={}{0:0.0}%}"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="Chờ những người chơi khác nộp bài..."
                                       FontFamily="{DynamicResource FontSans}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{StaticResource HomeTextOnDarkMuted}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="3"
                                Command="{Binding LeaveCommand}"
                                Style="{StaticResource DkButtonSecondary}"
                                Padding="14,10"
                                Content="Rời phòng"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>