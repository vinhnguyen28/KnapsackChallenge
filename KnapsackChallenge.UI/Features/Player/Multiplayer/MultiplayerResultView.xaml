<UserControl x:Class="KnapsackChallenge.UI.Features.Player.MultiplayerResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="1000"
             Background="{DynamicResource BrushBackground}">

    <UserControl.Resources>
        <!-- Top 1/2/3 làm nổi bật. Dòng của chính user có vạch accent bên trái. -->
        <Style x:Key="ResultRow" TargetType="DataGridRow" BasedOn="{StaticResource GridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rank}" Value="1">
                    <Setter Property="Background" Value="{DynamicResource BrushWarningSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Rank}" Value="2">
                    <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Rank}" Value="3">
                    <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMe}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header info ván -->
        <Border Grid.Row="0"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushRule}"
                BorderThickness="1"
                CornerRadius="2"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Mã phòng"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushInkMuted}"/>
                    <TextBlock Text="{Binding RoomCode, Mode=OneWay}"
                               FontFamily="{DynamicResource FontMono}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushInk}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="28,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SetName, Mode=OneWay}"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushInk}"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border Style="{DynamicResource StampNeutral}" Margin="0,0,6,0">
                            <TextBlock Style="{StaticResource MonoCaptionTextStyle}"
                                       Foreground="{DynamicResource BrushInkMuted}">
                                <Run Text="Tối ưu: "/>
                                <Run Text="{Binding OptimalValue, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                        <Border Style="{DynamicResource StampNeutral}">
                            <TextBlock Style="{StaticResource MonoCaptionTextStyle}"
                                       Foreground="{DynamicResource BrushInkMuted}">
                                <Run Text="{Binding TotalPlayers, Mode=OneWay}"/>
                                <Run Text=" người chơi"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Hạng của bạn"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushInkMuted}"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding MyRankText, Mode=OneWay}"
                               FontFamily="{DynamicResource FontMono}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushAccent}"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding FinishedAtText, Mode=OneWay}"
                               FontFamily="{DynamicResource FontMono}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushInkMuted}"
                               HorizontalAlignment="Right"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tiêu đề -->
        <StackPanel Grid.Row="1" Margin="4,0,0,8">
            <TextBlock Text="Bảng xếp hạng cuối ván"
                       FontFamily="{DynamicResource FontSans}"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushInk}"/>
            <TextBlock Text="Xếp hạng theo điểm giảm dần, sau đó theo thời gian nộp."
                       FontFamily="{DynamicResource FontSans}"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource BrushInkMuted}"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Bảng -->
        <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Entries}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      CanUserResizeColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="40"
                      FontSize="{DynamicResource FontSizeBody}"
                      Foreground="{DynamicResource BrushInk}"
                      ColumnHeaderStyle="{DynamicResource GridColumnHeader}"
                      RowStyle="{StaticResource ResultRow}"
                      CellStyle="{DynamicResource GridCell}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#"
                                        Binding="{Binding Rank}"
                                        Width="50"
                                        ElementStyle="{StaticResource RightCellText}"/>
                    <DataGridTextColumn Header="NGƯỜI CHƠI"
                                        Binding="{Binding Username}"
                                        Width="*"/>
                    <DataGridTextColumn Header="ĐIỂM"
                                        Binding="{Binding TotalScore}"
                                        Width="90"
                                        ElementStyle="{StaticResource RightCellText}"/>
                    <DataGridTextColumn Header="CÂN NẶNG"
                                        Binding="{Binding TotalWeight}"
                                        Width="90"
                                        ElementStyle="{StaticResource RightCellText}"/>
                    <DataGridTextColumn Header="TỐI ƯU"
                                        Binding="{Binding OptimalValue}"
                                        Width="90"
                                        ElementStyle="{StaticResource RightCellText}"/>
                    <DataGridTextColumn Header="% TỐI ƯU"
                                        Binding="{Binding OptimalPercentText}"
                                        Width="100"
                                        ElementStyle="{StaticResource RightCellText}"/>
                    <DataGridTextColumn Header="THỜI GIAN"
                                        Binding="{Binding TimeText}"
                                        Width="90"
                                        ElementStyle="{StaticResource RightCellText}"/>
                    <DataGridTextColumn Header="TRẠNG THÁI"
                                        Binding="{Binding StatusText}"
                                        Width="110"
                                        ElementStyle="{StaticResource MutedCellText}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="Phòng sẽ tự đóng sau ít phút."
                       FontFamily="{DynamicResource FontSans}"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource BrushInkMuted}"
                       VerticalAlignment="Center"/>
            <Button Command="{Binding BackToLobbyCommand}"
                    Style="{DynamicResource ButtonPrimary}"
                    Padding="20,11"
                    HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{DynamicResource IconArrowLeft}"
                          Width="14" Height="14"
                          Stroke="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"/>
                    <TextBlock Text="Về Lobby" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>