<Window x:Class="KnapsackChallenge.UI.Features.Player.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushRule}"
            BorderThickness="1" CornerRadius="10" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.2" Color="Black"/>
        </Border.Effect>

        <StackPanel Margin="22,18,22,18">
            <TextBlock x:Name="TitleText"
                       FontFamily="{DynamicResource FontSans}"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushInk}"/>

            <Rectangle Height="1" Fill="{DynamicResource BrushRule}" Margin="0,10,0,16"/>

            <TextBlock x:Name="LabelText"
                       Style="{DynamicResource FieldLabel}" TextWrapping="Wrap"/>

            <TextBox x:Name="InputBox"
                     Style="{DynamicResource DarkTextBox}"
                     Margin="0,0,0,14"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Hủy"
                        Click="Cancel_Click"
                        Style="{DynamicResource ButtonSecondary}"/>

                <Button Grid.Column="2" Content="Đồng ý"
                        Click="Confirm_Click"
                        Style="{DynamicResource ButtonPrimary}"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>