<UserControl x:Class="KnapsackChallenge.UI.Features.Player.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shared="clr-namespace:KnapsackChallenge.UI.Shared.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1200"
             Background="Transparent">

    <UserControl.Resources>

        <!-- =========================================================
             LobbyRow — kế thừa DkListRow (đã có zebra 56px), thêm:
             accent bar trái 4px đổi màu theo DifficultyKey.
             ========================================================= -->
        <Style x:Key="LobbyRow" TargetType="DataGridRow"
               BasedOn="{StaticResource DkListRow}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource LbRowDivider}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Border x:Name="accentBar"
                                        Width="4"
                                        HorizontalAlignment="Left"
                                        Background="Transparent"
                                        IsHitTestVisible="False"/>
                                <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                        SnapsToDevicePixels="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource LbRowZebra}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource LbRowHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource LbRowSelected}"/>
                            </Trigger>

                            <DataTrigger Binding="{Binding DifficultyKey}" Value="Easy">
                                <Setter TargetName="accentBar" Property="Background"
                                        Value="{StaticResource DiffEasyAccent}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DifficultyKey}" Value="Medium">
                                <Setter TargetName="accentBar" Property="Background"
                                        Value="{StaticResource DiffMediumAccent}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DifficultyKey}" Value="Hard">
                                <Setter TargetName="accentBar" Property="Background"
                                        Value="{StaticResource DiffHardAccent}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =========================================================
             LobbyStatusChip — chip trạng thái: Đang chờ / Đang chơi /
             Đầy / Kết thúc. Màu đổi theo StatusKey.
             ========================================================= -->
        <Style x:Key="LobbyStatusChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <!-- Mặc định: Waiting → xanh lá -->
            <Setter Property="Background" Value="#2634D399"/>
            <Setter Property="BorderBrush" Value="#8034D399"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKey}" Value="Waiting">
                    <Setter Property="Background" Value="#2634D399"/>
                    <Setter Property="BorderBrush" Value="#8034D399"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="Playing">
                    <Setter Property="Background" Value="#26FBBF24"/>
                    <Setter Property="BorderBrush" Value="#80FBBF24"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="Full">
                    <Setter Property="Background" Value="#26F87171"/>
                    <Setter Property="BorderBrush" Value="#80F87171"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="Finished">
                    <Setter Property="Background" Value="#26FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- =========================================================
             MiniCapacityBar — thanh tiến độ mini (cột Người).
             Bo tròn, không có glow, chỉ màu theo độ khó của phòng.
             ========================================================= -->
        <Style x:Key="MiniCapacityBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track">
                            <Border CornerRadius="2" Background="#22FFFFFF"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    CornerRadius="2"
                                    Background="{StaticResource HomeGold}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding DifficultyKey}" Value="Easy">
                                <Setter TargetName="PART_Indicator" Property="Background"
                                        Value="{StaticResource DiffEasyAccent}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DifficultyKey}" Value="Medium">
                                <Setter TargetName="PART_Indicator" Property="Background"
                                        Value="{StaticResource DiffMediumAccent}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DifficultyKey}" Value="Hard">
                                <Setter TargetName="PART_Indicator" Property="Background"
                                        Value="{StaticResource DiffHardAccent}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- =========================================================
         NỀN 2 LỚP: DifficultyBackdrop (trung tính home-bg) + nội dung.
         ========================================================= -->
    <Grid>
        <shared:DifficultyBackdrop Difficulty=""/>

        <Grid Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 0: Header -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Toolbar -->
                <RowDefinition Height="Auto"/>
                <!-- 2: Filter -->
                <RowDefinition Height="Auto"/>
                <!-- 3: Banner (tách riêng — fix bug đè filter) -->
                <RowDefinition Height="*"/>
                <!-- 4: DataGrid -->
            </Grid.RowDefinitions>

            <!-- =========================================================
                 ROW 0 — HEADER
                 ========================================================= -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Nút Trang chủ pill glass -->
                <Button Grid.Column="0"
                        Command="{Binding BackCommand}"
                        Padding="16,10"
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        ToolTip="Về trang chủ">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{StaticResource HomeGlassFill}"
                                    BorderBrush="{StaticResource HomeGlassBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background"
                                            Value="{StaticResource HomeGlassFillHover}"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#66FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconArrowLeft}"
                              Width="14" Height="14"
                              Stroke="{StaticResource HomeTextOnDark}"
                              StrokeThickness="1.6"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"/>
                        <TextBlock Text="Trang chủ"
                                   FontFamily="{StaticResource FontSans}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource HomeTextOnDark}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Tiêu đề + phụ đề -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Phòng chơi Multiplayer"
                               FontFamily="{StaticResource FontSans}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource HomeTextOnDark}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black"
                                              BlurRadius="12"
                                              ShadowDepth="0"
                                              Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="Chọn một phòng để vào, hoặc tạo phòng mới."
                               FontFamily="{StaticResource FontSans}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource HomeTextOnDarkMuted}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Chip trạng thái kết nối -->
                <Border Grid.Column="2"
                        Padding="12,6"
                        CornerRadius="12"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#26FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Background" Value="#2634D399"/>
                                    <Setter Property="BorderBrush" Value="#8034D399"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Background" Value="#26F87171"/>
                                    <Setter Property="BorderBrush" Value="#80F87171"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource HomeTextOnDarkMuted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="#34D399"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Fill" Value="#F87171"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource HomeTextOnDark}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- =========================================================
                 ROW 1 — TOOLBAR: 3 nút + Refresh
                 ========================================================= -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Command="{Binding CreateRoomCommand}"
                            Style="{StaticResource DkButtonPrimary}"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconAdd}"
                                  Width="14" Height="14"
                                  Stroke="{Binding Foreground,
                                           RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Tạo phòng" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding JoinRoomCommand}"
                            Style="{StaticResource DkButtonSecondary}"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconChevronRight}"
                                  Width="14" Height="14"
                                  Stroke="{Binding Foreground,
                                           RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Vào phòng" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding JoinSelectedCommand}"
                            Style="{StaticResource DkButtonPrimary}"
                            Content="Vào phòng đã chọn"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Đang tải..."
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{StaticResource HomeTextOnDarkMuted}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Visibility="{Binding IsBusy,
                                            Converter={StaticResource BoolToVisibility}}"/>

                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource DkButtonSecondary}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}"
                                  Width="14" Height="14"
                                  Stroke="{Binding Foreground,
                                           RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Làm mới" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- =========================================================
                 ROW 2 — FILTER: chips độ khó + search + checkbox
                 (Banner KHÔNG còn nằm ở đây — xem Row 3)
                 ========================================================= -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="Tất cả"
                                 GroupName="LobbyDiff"
                                 Style="{StaticResource DkPillRadio}"
                                 IsChecked="{Binding IsFilterAll, Mode=TwoWay}"/>

                    <RadioButton GroupName="LobbyDiff"
                                 Tag="Easy"
                                 Style="{StaticResource DkPillRadio}"
                                 IsChecked="{Binding IsFilterEasy, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLeaf}"
                                  Width="12" Height="12"
                                  Stroke="{Binding Foreground,
                                           RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"/>
                            <TextBlock Text="Dễ" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="LobbyDiff"
                                 Tag="Medium"
                                 Style="{StaticResource DkPillRadio}"
                                 IsChecked="{Binding IsFilterMedium, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconScale}"
                                  Width="12" Height="12"
                                  Stroke="{Binding Foreground,
                                           RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"/>
                            <TextBlock Text="Bình thường" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="LobbyDiff"
                                 Tag="Hard"
                                 Style="{StaticResource DkPillRadio}"
                                 IsChecked="{Binding IsFilterHard, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFlame}"
                                  Width="12" Height="12"
                                  Stroke="{Binding Foreground,
                                           RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"/>
                            <TextBlock Text="Khó" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <TextBox Grid.Column="1"
                         Style="{StaticResource DkTextBox}"
                         Margin="12,0"
                         Height="36"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Tìm theo mã phòng, chủ phòng hoặc bộ đề"
                         VerticalAlignment="Center"/>

                <CheckBox Grid.Column="2"
                          Style="{DynamicResource InputCheckBox}"
                          Content="Hiện cả phòng đang chơi"
                          IsChecked="{Binding ShowPlaying, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Foreground="{StaticResource HomeTextOnDark}"/>
            </Grid>

            <!-- =========================================================
                 ROW 3 — BANNER (tách riêng, KHÔNG đè filter)
                 Info (xanh) + Error (đỏ) chồng nhau, mỗi cái tự ẩn/hiện
                 theo HasInfo / HasError.
                 ========================================================= -->
            <Grid Grid.Row="3" Margin="0,0,0,12" MinHeight="42">

                <!-- Info banner -->
                <Border Style="{StaticResource DkToastInfo}"
                        VerticalAlignment="Top"
                        Visibility="{Binding HasInfo,
                                     Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCheck}"
                              Width="14" Height="14"
                              Stroke="#34D399"
                              StrokeThickness="2.2"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding InfoMessage}"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="#6EE7B7"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Error banner (đè lên info nếu cả 2 cùng có) -->
                <Border Style="{StaticResource DkToastError}"
                        VerticalAlignment="Top"
                        Visibility="{Binding HasError,
                                     Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconWarning}"
                              Width="14" Height="14"
                              Stroke="#F87171"
                              StrokeThickness="2.0"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="#FCA5A5"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- =========================================================
                 (Row 4 — DataGrid + Empty state nằm ở PHẦN 2/2)
                 ========================================================= -->
            <!-- =========================================================
                 ROW 4 — DANH SÁCH PHÒNG
                 Khung glass bo 14 + drop shadow. DataGrid tông tối
                 (DkListHeader / LobbyRow / DkListCell) với 2 hàng xen kẽ.
                 ========================================================= -->
            <Border Grid.Row="4"
                    Background="{StaticResource HomeGlassFill}"
                    BorderBrush="{StaticResource HomeGlassBorder}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="Black"
                                      BlurRadius="24"
                                      ShadowDepth="0"
                                      Opacity="0.4"/>
                </Border.Effect>

                <Grid>
                    <DataGrid ItemsSource="{Binding Rooms}"
                              SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              CanUserResizeColumns="False"
                              AlternationCount="2"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="56"
                              FontSize="{DynamicResource FontSizeBody}"
                              Foreground="{StaticResource HomeTextOnDark}"
                              ColumnHeaderStyle="{StaticResource DkListHeader}"
                              RowStyle="{StaticResource LobbyRow}"
                              CellStyle="{StaticResource DkListCell}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding JoinSelectedCommand}"/>
                        </DataGrid.InputBindings>

                        <DataGrid.Columns>

                            <!-- ============== MÃ PHÒNG ============== -->
                            <DataGridTemplateColumn Header="MÃ PHÒNG" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RoomCode}"
                                                   FontFamily="{DynamicResource FontMono}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource HomeTextOnDark}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ============== CHỦ PHÒNG (avatar + username) ============== -->
                            <DataGridTemplateColumn Header="CHỦ PHÒNG" Width="200" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Avatar tròn 30x30 với chữ cái đầu. -->
                                            <Border Width="30" Height="30" CornerRadius="15"
                                                    Background="{StaticResource LbAvatarBg}"
                                                    BorderBrush="{StaticResource LbAvatarBorder}"
                                                    BorderThickness="1"
                                                    Margin="0,0,10,0">
                                                <TextBlock Text="{Binding AvatarInitial}"
                                                           FontFamily="{DynamicResource FontSans}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource HomeTextOnDark}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding HostUsername}"
                                                       FontFamily="{DynamicResource FontSans}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       Foreground="{StaticResource HomeTextOnDark}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ============== BỘ ĐỀ ============== -->
                            <DataGridTemplateColumn Header="BỘ ĐỀ" Width="*" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SetName}"
                                                   FontFamily="{DynamicResource FontSans}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Foreground="{StaticResource HomeTextOnDarkMuted}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ============== ĐỘ KHÓ (chip màu) ============== -->
                            <DataGridTemplateColumn Header="ĐỘ KHÓ" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,3"
                                                CornerRadius="10"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#26FFFFFF"/>
                                                    <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DifficultyKey}" Value="Easy">
                                                            <Setter Property="Background" Value="#2634D399"/>
                                                            <Setter Property="BorderBrush" Value="#8034D399"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DifficultyKey}" Value="Medium">
                                                            <Setter Property="Background" Value="#26FBBF24"/>
                                                            <Setter Property="BorderBrush" Value="#80FBBF24"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DifficultyKey}" Value="Hard">
                                                            <Setter Property="Background" Value="#26F87171"/>
                                                            <Setter Property="BorderBrush" Value="#80F87171"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <TextBlock Text="{Binding DifficultyText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontFamily" Value="{DynamicResource FontSans}"/>
                                                        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="{StaticResource HomeTextOnDark}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DifficultyKey}" Value="Easy">
                                                                <Setter Property="Foreground" Value="#6EE7B7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DifficultyKey}" Value="Medium">
                                                                <Setter Property="Foreground" Value="#FCD34D"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DifficultyKey}" Value="Hard">
                                                                <Setter Property="Foreground" Value="#FCA5A5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ============== THỜI GIAN ============== -->
                            <DataGridTemplateColumn Header="THỜI GIAN" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TimeLimitText}"
                                                   FontFamily="{DynamicResource FontMono}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{StaticResource HomeTextOnDarkMuted}"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ============== NGƯỜI (2/4 + capacity bar) ============== -->
                            <DataGridTemplateColumn Header="NGƯỜI" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PlayerCountText}"
                                                       FontFamily="{DynamicResource FontMono}"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource HomeTextOnDark}"
                                                       HorizontalAlignment="Left"
                                                       Margin="0,0,0,4"/>
                                            <ProgressBar Style="{StaticResource MiniCapacityBar}"
                                                         Value="{Binding CapacityPercent, Mode=OneWay}"
                                                         Width="100"
                                                         HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ============== TRẠNG THÁI (chip) ============== -->
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource LobbyStatusChip}">
                                            <TextBlock Text="{Binding StatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontFamily" Value="{DynamicResource FontSans}"/>
                                                        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="#6EE7B7"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusKey}" Value="Waiting">
                                                                <Setter Property="Foreground" Value="#6EE7B7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKey}" Value="Playing">
                                                                <Setter Property="Foreground" Value="#FCD34D"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKey}" Value="Full">
                                                                <Setter Property="Foreground" Value="#FCA5A5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKey}" Value="Finished">
                                                                <Setter Property="Foreground" Value="{StaticResource HomeTextOnDarkMuted}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- =========================================================
                         EMPTY STATE — hiện khi Rooms.Count == 0 và !IsBusy.
                         Icon gamepad + câu mời + nút "Tạo phòng" ngay giữa.
                         ========================================================= -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,40,0,40">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Rooms.Count}" Value="0"/>
                                            <Condition Binding="{Binding IsBusy}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Path Data="{DynamicResource IconGamepad}"
                              Width="56" Height="56"
                              Stroke="{StaticResource HomeTextOnDarkMuted}"
                              StrokeThickness="1.3"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Opacity="0.55"/>

                        <TextBlock Text="Chưa có phòng nào đang hoạt động"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource HomeTextOnDark}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0"/>

                        <TextBlock Text="Hãy là người đầu tiên tạo phòng và mời bạn bè cùng chơi."
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{StaticResource HomeTextOnDarkMuted}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="380"
                                   Margin="0,6,0,16"/>

                        <Button Command="{Binding CreateRoomCommand}"
                                Style="{StaticResource DkButtonPrimary}"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconAdd}"
                                      Width="14" Height="14"
                                      Stroke="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="Tạo phòng" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>