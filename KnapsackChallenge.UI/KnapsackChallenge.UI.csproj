<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\icon.ico" />
    <None Remove="Fonts\IBMPlexMono-Regular.ttf" />
    <None Remove="Fonts\IBMPlexMono-SemiBold.ttf" />
    <None Remove="Fonts\IBMPlexSans-Regular.ttf" />
    <None Remove="Fonts\IBMPlexSans-SemiBold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
	  <!-- Công tắc Azure/Local dùng chung (file ở thư mục gốc solution). Không bao giờ đóng gói vào bản publish. -->
	  <Content Include="..\appsettings.env.json" Link="appsettings.env.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Condition="Exists('..\appsettings.env.json')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KnapsackChallenge.Core\KnapsackChallenge.Core.csproj" />
    <ProjectReference Include="..\KnapsackChallenge.Data\KnapsackChallenge.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
	  
    <Resource Include="Fonts\IBMPlexMono-Regular.ttf" />
    <Resource Include="Fonts\IBMPlexMono-SemiBold.ttf" />
    <Resource Include="Fonts\IBMPlexSans-Regular.ttf" />
    <Resource Include="Fonts\IBMPlexSans-SemiBold.ttf" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Assets\Backgrounds\" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\Backgrounds\*.jpg" />
	</ItemGroup>
	
</Project>