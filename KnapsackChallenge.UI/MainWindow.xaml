<Window x:Class="KnapsackChallenge.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KnapsackChallenge.UI"
        xmlns:auth="clr-namespace:KnapsackChallenge.UI.Features.Auth"
        xmlns:admin="clr-namespace:KnapsackChallenge.UI.Features.Admin"
        xmlns:player="clr-namespace:KnapsackChallenge.UI.Features.Player"
        xmlns:views="clr-namespace:KnapsackChallenge.UI.Features.Admin"
        Title="Knapsack Challenge"
        Background="Black"
        Height="600" Width="900"
        MinHeight="520" MinWidth="700"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type auth:LoginViewModel}">
            <auth:LoginView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type auth:RegisterViewModel}">
            <auth:RegisterView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type player:SoloGameViewModel}">
            <player:SoloGameView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type admin:ItemManagementViewModel}">
            <admin:ItemManagementView />
        </DataTemplate>
        
    </Window.Resources>

    <Grid>
        <ContentControl Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>