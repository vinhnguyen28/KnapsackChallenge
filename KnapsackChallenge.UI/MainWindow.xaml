<Window Icon="Assets/icon.ico"
        x:Class="KnapsackChallenge.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KnapsackChallenge.UI"
        xmlns:auth="clr-namespace:KnapsackChallenge.UI.Features.Auth"
        xmlns:admin="clr-namespace:KnapsackChallenge.UI.Features.Admin"
        xmlns:player="clr-namespace:KnapsackChallenge.UI.Features.Player"
        Title="Knapsack Challenge"
        Background="{DynamicResource BrushBackground}"
        WindowStartupLocation="CenterScreen"
        Width="900" Height="620" MinWidth="760" MinHeight="540">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Ánh xạ ViewModel -> View cấp Window.
             DataTemplate của các trang CON của Player được khai báo trong MainPlayerView.xaml. -->
        <DataTemplate DataType="{x:Type auth:LoginViewModel}">
            <auth:LoginView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type auth:RegisterViewModel}">
            <auth:RegisterView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type admin:MainAdminViewModel}">
            <admin:MainAdminView />
        </DataTemplate>

        <!-- Player giờ đi qua vỏ MainPlayer, không phải SoloGameView trực tiếp. -->
        <DataTemplate DataType="{x:Type player:MainPlayerViewModel}">
            <player:MainPlayerView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ContentControl Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>