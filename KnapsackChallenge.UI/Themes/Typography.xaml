<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- =========================================================
         FONT FAMILIES — nhúng IBM Plex, fallback về Segoe UI / Consolas
         (WPF tự fallback nếu pack URI không resolve được)
         ========================================================= -->
    <FontFamily x:Key="FontSans">Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Consolas</FontFamily>

    <!-- =========================================================
         SIZES (đơn vị px)
         ========================================================= -->
    <sys:Double x:Key="FontSizeDisplay">22</sys:Double>
    <sys:Double x:Key="FontSizeTitle">18</sys:Double>
    <sys:Double x:Key="FontSizeHeading">14</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeCaption">11</sys:Double>

    <!-- =========================================================
         TEXT STYLES — tiêu đề SemiBold, sentence case, cỡ 18/14/12
         ========================================================= -->
    <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushInk}"/>
    </Style>

    <Style x:Key="TitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DisplayTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}"/>
    </Style>

    <Style x:Key="HeadingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DisplayTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}"/>
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushInk}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushInkMuted}"/>
    </Style>

    <!-- Mono: bắt buộc dùng cho MỌI số liệu (ID, weight, value, score, time) -->
    <Style x:Key="MonoTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushInk}"/>
    </Style>

    <Style x:Key="MonoSmallTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MonoTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
    </Style>

</ResourceDictionary>