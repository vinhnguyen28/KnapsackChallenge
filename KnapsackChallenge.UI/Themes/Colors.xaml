<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================
         CARGO MANIFEST — Palette (định nghĩa duy nhất ở đây)
         ========================================================= -->
    <Color x:Key="ColorBackground">#EFEBE3</Color>
    <Color x:Key="ColorSurface">#F8F6F1</Color>
    <Color x:Key="ColorSurfaceAlt">#E6E1D6</Color>
    <Color x:Key="ColorInk">#1C1B19</Color>
    <Color x:Key="ColorInkMuted">#6B665C</Color>
    <Color x:Key="ColorRule">#CFC8B8</Color>

    <Color x:Key="ColorAccent">#E8590C</Color>
    <Color x:Key="ColorAccentSoft">#FBE7DA</Color>
    <Color x:Key="ColorSuccess">#2F6B3F</Color>
    <Color x:Key="ColorSuccessSoft">#E2EEE5</Color>
    <Color x:Key="ColorDanger">#B3261E</Color>
    <Color x:Key="ColorDangerSoft">#F7DEDC</Color>
    <Color x:Key="ColorWarning">#B7791F</Color>
    <Color x:Key="ColorWarningSoft">#F7EAD1</Color>

    <Color x:Key="ColorOnAccent">#FFFFFF</Color>

    <!-- =========================================================
         Brushes
         ========================================================= -->
    <SolidColorBrush x:Key="BrushBackground"   Color="{StaticResource ColorBackground}"/>
    <SolidColorBrush x:Key="BrushSurface"      Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="BrushSurfaceAlt"   Color="{StaticResource ColorSurfaceAlt}"/>
    <SolidColorBrush x:Key="BrushInk"          Color="{StaticResource ColorInk}"/>
    <SolidColorBrush x:Key="BrushInkMuted"     Color="{StaticResource ColorInkMuted}"/>
    <SolidColorBrush x:Key="BrushRule"         Color="{StaticResource ColorRule}"/>

    <SolidColorBrush x:Key="BrushAccent"       Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="BrushAccentSoft"   Color="{StaticResource ColorAccentSoft}"/>
    <SolidColorBrush x:Key="BrushSuccess"      Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="BrushSuccessSoft"  Color="{StaticResource ColorSuccessSoft}"/>
    <SolidColorBrush x:Key="BrushDanger"       Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="BrushDangerSoft"   Color="{StaticResource ColorDangerSoft}"/>
    <SolidColorBrush x:Key="BrushWarning"      Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="BrushWarningSoft"  Color="{StaticResource ColorWarningSoft}"/>
    <SolidColorBrush x:Key="BrushOnAccent"     Color="{StaticResource ColorOnAccent}"/>

    <!-- =========================================================
         Legacy brush aliases — để các View chưa viết lại vẫn chạy.
         (Tên cũ, giá trị mới theo palette Cargo Manifest.)
         ========================================================= -->
    <SolidColorBrush x:Key="CardBg"           Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="CardBorder"       Color="{StaticResource ColorRule}"/>
    <SolidColorBrush x:Key="InputBg"          Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="TextMain"         Color="{StaticResource ColorInk}"/>
    <SolidColorBrush x:Key="TextMuted"        Color="{StaticResource ColorInkMuted}"/>
    <SolidColorBrush x:Key="Accent"           Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="AccentCyan"       Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="PrimaryGradient"  Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="SuccessGradient"  Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource ColorBackground}"/>

</ResourceDictionary>