<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================
         CARGO MANIFEST - Palette
         Dung SolidColorBrush voi hex truc tiep, KHONG dung the <Color>
         de tranh moi van de deferred-resource khi merge dictionary.
         ========================================================= -->

    <!-- Nen / chu / duong ke -->
    <SolidColorBrush x:Key="BrushBackground"  Color="#EFEBE3"/>
    <SolidColorBrush x:Key="BrushBackgroundAlt" Color="#E4DDC8"/>
    <SolidColorBrush x:Key="BrushSurface"     Color="#F8F6F1"/>
    <SolidColorBrush x:Key="BrushSurfaceAlt"  Color="#E6E1D6"/>
    <SolidColorBrush x:Key="BrushInk"         Color="#1C1B19"/>
    <SolidColorBrush x:Key="BrushInkMuted"    Color="#6B665C"/>
    <SolidColorBrush x:Key="BrushRule"        Color="#CFC8B8"/>

    <!-- Accent / trang thai -->
    <SolidColorBrush x:Key="BrushAccent"      Color="#E8590C"/>
    <SolidColorBrush x:Key="BrushAccentSoft"  Color="#FBE7DA"/>
    <SolidColorBrush x:Key="BrushSuccess"     Color="#2F6B3F"/>
    <SolidColorBrush x:Key="BrushSuccessSoft" Color="#E2EEE5"/>
    <SolidColorBrush x:Key="BrushDanger"      Color="#B3261E"/>
    <SolidColorBrush x:Key="BrushDangerSoft"  Color="#F7DEDC"/>
    <SolidColorBrush x:Key="BrushWarning"     Color="#B7791F"/>
    <SolidColorBrush x:Key="BrushWarningSoft" Color="#F7EAD1"/>
    <SolidColorBrush x:Key="BrushOnAccent"    Color="#FFFFFF"/>

    <!-- Legacy aliases -->
    <SolidColorBrush x:Key="CardBg"             Color="#F8F6F1"/>
    <SolidColorBrush x:Key="CardBorder"         Color="#CFC8B8"/>
    <SolidColorBrush x:Key="InputBg"            Color="#F8F6F1"/>
    <SolidColorBrush x:Key="TextMain"           Color="#1C1B19"/>
    <SolidColorBrush x:Key="TextMuted"          Color="#6B665C"/>
    <SolidColorBrush x:Key="Accent"             Color="#E8590C"/>
    <SolidColorBrush x:Key="AccentCyan"         Color="#E8590C"/>
    <SolidColorBrush x:Key="PrimaryGradient"    Color="#E8590C"/>
    <SolidColorBrush x:Key="SuccessGradient"    Color="#2F6B3F"/>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EFEBE3"/>

    <!-- =========================================================
         HOME (Player) — bo brush rieng cho trang chu Player.
         Dung chung cho ca man Bang xep hang (dong bo tong toi).
         ========================================================= -->

    <LinearGradientBrush x:Key="HomeBackdropFallback"
                         StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0F172A" Offset="0"/>
        <GradientStop Color="#1E1B4B" Offset="0.5"/>
        <GradientStop Color="#3B1D5A" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HomeOverlay"
                         StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CC0B1020" Offset="0"/>
        <GradientStop Color="#B3141B3A" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HomeGlassFill"      Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="HomeGlassBorder"    Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="HomeGlassFillHover" Color="#2EFFFFFF"/>

    <SolidColorBrush x:Key="HomeTextOnDark"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HomeTextOnDarkMuted"  Color="#C7CCE0"/>

    <LinearGradientBrush x:Key="HomeSoloGradient"
                         StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF9A3D" Offset="0"/>
        <GradientStop Color="#E8590C" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HomeMultiGradient"
                         StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C6CFF" Offset="0"/>
        <GradientStop Color="#3B82F6" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HomeGold"       Color="#FBBF24"/>
    <SolidColorBrush x:Key="HomeSilver"     Color="#CBD5E1"/>
    <SolidColorBrush x:Key="HomeBronze"     Color="#D97706"/>
    <SolidColorBrush x:Key="HomeOnlineDot"  Color="#34D399"/>

    <!-- Header (Player shell) -->
    <LinearGradientBrush x:Key="HeaderBackground"
                         StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0F172A" Offset="0"/>
        <GradientStop Color="#1E1B4B" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeaderBorder"        Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="HeaderPillFill"      Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="HeaderPillFillHover" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="HeaderIcon"          Color="#FFFFFF"/>

    <!-- Heart badge -->
    <SolidColorBrush x:Key="HeartFill"         Color="#FF4D6D"/>
    <SolidColorBrush x:Key="HeartLow"          Color="#FBBF24"/>
    <SolidColorBrush x:Key="HeartEmpty"        Color="#EF4444"/>
    <SolidColorBrush x:Key="TooltipBackground" Color="#F20F172A"/>

    <!-- =========================================================
         NEW — LEADERBOARD (tông tối, đồng bộ Home)

         Vì toàn bộ màn BXH giờ đặt trên nền gradient tối
         (HomeBackdropFallback + HomeOverlay), mọi brush dưới đây
         đều là bán trong suốt để khi chồng lên nền tối cho ra
         đúng hiệu ứng "glass" giống Home.

         Đơn vị alpha: 2 ký tự đầu của mã #AARRGGBB.
         ========================================================= -->

    <!-- Ba huy hiệu hạng 1/2/3 — dùng cho badge tròn + thanh nhấn trái.
         Đây là brush ĐẶC (không trong suốt) vì badge cần nổi khối. -->
    <SolidColorBrush x:Key="LbGold"     Color="#D4A017"/>
    <SolidColorBrush x:Key="LbSilver"   Color="#9AA1B0"/>
    <SolidColorBrush x:Key="LbBronze"   Color="#B87333"/>

    <!-- Nền header của bảng: tối hơn body 1 chút để tạo tầng -->
    <SolidColorBrush x:Key="LbGlassHeaderBg" Color="#33000000"/>

    <!-- Đường kẻ giữa hàng: trắng mờ 10% -->
    <SolidColorBrush x:Key="LbRowDivider"    Color="#1FFFFFFF"/>
    <!-- Zebra rất nhẹ cho hàng lẻ -->
    <SolidColorBrush x:Key="LbRowZebra"      Color="#0AFFFFFF"/>
    <!-- Hover / Selected -->
    <SolidColorBrush x:Key="LbRowHover"      Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="LbRowSelected"   Color="#26FFFFFF"/>

    <!-- Tint cho hàng top 1/2/3 — bán trong suốt để hài hoà nền tối -->
    <SolidColorBrush x:Key="LbRowGoldBg"     Color="#26FBBF24"/>
    <SolidColorBrush x:Key="LbRowSilverBg"   Color="#1FCBD5E1"/>
    <SolidColorBrush x:Key="LbRowBronzeBg"   Color="#26D97706"/>
    <!-- Hàng của mình — tint accent cam -->
    <SolidColorBrush x:Key="LbRowMeBg"       Color="#33E8590C"/>

    <!-- Popup ComboBox: nền navy gần đục để chữ nổi rõ -->
    <SolidColorBrush x:Key="LbPopupBg"       Color="#F01E1B4B"/>

    <!-- Chip trên nền tối — mặc định (không màu) -->
    <SolidColorBrush x:Key="LbChipBg"        Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="LbChipBorder"    Color="#33FFFFFF"/>

    <!-- Chip "Lv X" — cam accent -->
    <SolidColorBrush x:Key="LbChipLevelBg"     Color="#33FF9A3D"/>
    <SolidColorBrush x:Key="LbChipLevelBorder" Color="#80FF9A3D"/>
    <SolidColorBrush x:Key="LbChipLevelText"   Color="#FFB981"/>

    <!-- Chip độ khó -->
    <SolidColorBrush x:Key="LbChipEasyBg"      Color="#2634D399"/>
    <SolidColorBrush x:Key="LbChipEasyBorder"  Color="#8034D399"/>
    <SolidColorBrush x:Key="LbChipEasyText"    Color="#6EE7B7"/>

    <SolidColorBrush x:Key="LbChipMedBg"       Color="#26FBBF24"/>
    <SolidColorBrush x:Key="LbChipMedBorder"   Color="#80FBBF24"/>
    <SolidColorBrush x:Key="LbChipMedText"     Color="#FCD34D"/>

    <SolidColorBrush x:Key="LbChipHardBg"      Color="#26F87171"/>
    <SolidColorBrush x:Key="LbChipHardBorder"  Color="#80F87171"/>
    <SolidColorBrush x:Key="LbChipHardText"    Color="#FCA5A5"/>

    <!-- Chip hạng (Đồng / Bạc / Vàng) -->
    <SolidColorBrush x:Key="LbChipGoldBg"      Color="#33FBBF24"/>
    <SolidColorBrush x:Key="LbChipGoldBorder"  Color="#80FBBF24"/>
    <SolidColorBrush x:Key="LbChipGoldText"    Color="#FCD34D"/>

    <SolidColorBrush x:Key="LbChipSilverBg"    Color="#33CBD5E1"/>
    <SolidColorBrush x:Key="LbChipSilverBorder" Color="#80CBD5E1"/>
    <SolidColorBrush x:Key="LbChipSilverText"  Color="#E2E8F0"/>

    <SolidColorBrush x:Key="LbChipBronzeBg"    Color="#33D97706"/>
    <SolidColorBrush x:Key="LbChipBronzeBorder" Color="#80D97706"/>
    <SolidColorBrush x:Key="LbChipBronzeText"  Color="#FBBF9A"/>

    <!-- Avatar trên nền tối -->
    <SolidColorBrush x:Key="LbAvatarBg"        Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="LbAvatarBorder"    Color="#33FFFFFF"/>

    <!-- =========================================================
         NEW (GĐ1) — DIFFICULTY THEMES
         Bổ sung brush cho từng độ khó: Easy / Medium / Hard.
         KHÔNG sửa bất kỳ key cũ nào ở trên.

         Quy ước tên:
           Diff<Level>Backdrop     — gradient nền dự phòng
           Diff<Level>Overlay      — lớp phủ tối (đặt trên ảnh)
           Diff<Level>Accent       — màu nhấn chính (đặc)
           Diff<Level>AccentSoft   — màu nhấn mờ (~15% alpha)
           Diff<Level>Glow         — màu glow cho DropShadowEffect
           Diff<Level>Border       — màu viền (50% alpha)

         Dùng cho:
           - DifficultyBackdrop (Shared/Controls)
           - Chip độ khó (DkChip + Tag="Easy|Medium|Hard")
           - Nút nhấn trong phòng (DkButtonPrimary + Tag)
           - Thẻ chọn độ khó ở dialog Lobby / SetSelection
         ========================================================= -->

    <!-- ================= EASY — rừng đêm / ngọc lục bảo ================= -->
    <LinearGradientBrush x:Key="DiffEasyBackdrop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#04201C" Offset="0"/>
        <GradientStop Color="#063B30" Offset="0.55"/>
        <GradientStop Color="#0B5A45" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DiffEasyOverlay" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#6602211B" Offset="0"/>
        <GradientStop Color="#B30A2018" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="DiffEasyAccent"     Color="#34D399"/>
    <SolidColorBrush x:Key="DiffEasyAccentSoft" Color="#2634D399"/>
    <SolidColorBrush x:Key="DiffEasyGlow"       Color="#CC34D399"/>
    <SolidColorBrush x:Key="DiffEasyBorder"     Color="#8034D399"/>

    <!-- ================= MEDIUM — hoàng hôn hổ phách ================= -->
    <LinearGradientBrush x:Key="DiffMediumBackdrop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1F1505" Offset="0"/>
        <GradientStop Color="#3A2A08" Offset="0.55"/>
        <GradientStop Color="#5A3E0C" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DiffMediumOverlay" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66261B08" Offset="0"/>
        <GradientStop Color="#B33A260A" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="DiffMediumAccent"     Color="#FBBF24"/>
    <SolidColorBrush x:Key="DiffMediumAccentSoft" Color="#26FBBF24"/>
    <SolidColorBrush x:Key="DiffMediumGlow"       Color="#CCFBBF24"/>
    <SolidColorBrush x:Key="DiffMediumBorder"     Color="#80FBBF24"/>

    <!-- ================= HARD — lò rèn / dung nham đỏ thẫm ================= -->
    <LinearGradientBrush x:Key="DiffHardBackdrop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A0505" Offset="0"/>
        <GradientStop Color="#3B0A0A" Offset="0.55"/>
        <GradientStop Color="#5C0F12" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DiffHardOverlay" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#661F0505" Offset="0"/>
        <GradientStop Color="#B33A0A0A" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="DiffHardAccent"     Color="#F87171"/>
    <SolidColorBrush x:Key="DiffHardAccentSoft" Color="#26F87171"/>
    <SolidColorBrush x:Key="DiffHardGlow"       Color="#CCF87171"/>
    <SolidColorBrush x:Key="DiffHardBorder"     Color="#80F87171"/>

</ResourceDictionary>