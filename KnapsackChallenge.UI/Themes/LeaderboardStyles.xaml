<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================
         LEADERBOARD STYLES — tông tối, đồng bộ Home Player.
         Mọi key có tiền tố "Lb" để không đụng style dùng chung
         (FilterTabRadio, InputComboBox, GridRow...) của Admin/Lobby.
         File này được merge trong App.xaml SAU Layout.xaml.
         ========================================================= -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
        <ResourceDictionary Source="Typography.xaml"/>
        <ResourceDictionary Source="Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- =========================================================
         1) LbTabRadio — tab lớn ("Cấp độ (EXP)" / "Theo bộ đề").
         Tông tối: nền glass trong suốt + viền trắng mờ.
         Khi được chọn: chuyển sang gradient cam (đồng bộ nút Solo
         ở Home) + chữ trắng + đổ bóng cam nhẹ.
         ========================================================= -->
    <Style x:Key="LbTabRadio" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource HomeTextOnDark}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd"
                            CornerRadius="18"
                            Background="{StaticResource HomeGlassFill}"
                            BorderBrush="{StaticResource HomeGlassBorder}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{StaticResource HomeGlassFillHover}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#66FFFFFF"/>
                        </Trigger>
                        <!-- Chọn: gradient cam, đồng bộ nút hero "Chơi Solo" ở Home.
                             Dùng LinearGradientBrush inline để không phải thêm key mới. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF9A3D" Offset="0"/>
                                        <GradientStop Color="#E8590C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="bd" Property="BorderBrush"
                                    Value="#66FF9A3D"/>
                            <Setter TargetName="bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FF9A3D"
                                                      BlurRadius="14"
                                                      ShadowDepth="0"
                                                      Opacity="0.55"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground"
                                    Value="{StaticResource HomeTextOnDark}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         2) LbPillRadio — pill nhỏ cho nhóm lọc độ khó.
         Cùng chất liệu glass; khi chọn đổi viền cam + nền cam nhạt
         (nhẹ hơn tab để không "chọi" với tab đang active).
         ========================================================= -->
    <Style x:Key="LbPillRadio" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource HomeTextOnDarkMuted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd"
                            CornerRadius="16"
                            Background="{StaticResource HomeGlassFill}"
                            BorderBrush="{StaticResource HomeGlassBorder}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{StaticResource HomeGlassFillHover}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource HomeTextOnDark}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{StaticResource LbChipLevelBg}"/>
                            <Setter TargetName="bd" Property="BorderBrush"
                                    Value="{StaticResource LbChipLevelBorder}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource HomeTextOnDark}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         3) LbComboBox — ComboBox glass, popup navy.

         FIX BUG ToString: template vẫn dùng SelectionBoxItemTemplate,
         nên View PHẢI cung cấp ItemTemplate tường minh cho từng
         ComboBox (đã làm trong LeaderboardView.xaml). Nếu thiếu
         ItemTemplate, WPF sẽ fallback ToString() lên record.

         Popup navy gần đục (#F01E1B4B) để chữ trắng nổi rõ trên
         mọi nền phía sau.
         ========================================================= -->
    <Style x:Key="LbComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource HomeTextOnDark}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid>
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="8"
                                Margin="4,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <!-- Dấu check khi item được chọn -->
                        <Path x:Name="check"
                              Data="{StaticResource IconCheck}"
                              Stroke="{StaticResource HomeGold}"
                              StrokeThickness="1.8"
                              Width="12" Height="12"
                              Stretch="Uniform"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="#1FFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="#33E8590C"/>
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LbComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{StaticResource HomeTextOnDark}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource LbComboItem}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="shell"
                                            Background="{StaticResource HomeGlassFill}"
                                            BorderBrush="{StaticResource HomeGlassBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <Path HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"
                                              Data="{StaticResource IconChevronDown}"
                                              Stroke="{StaticResource HomeTextOnDarkMuted}"
                                              StrokeThickness="1.5"
                                              Width="10" Height="10"
                                              Stretch="Uniform"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="shell" Property="Background"
                                                    Value="{StaticResource HomeGlassFillHover}"/>
                                            <Setter TargetName="shell" Property="BorderBrush"
                                                    Value="#66FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="shell" Property="BorderBrush"
                                                    Value="#80FF9A3D"/>
                                            <Setter TargetName="shell" Property="BorderThickness"
                                                    Value="2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Ô hiển thị item đang chọn: render từ ItemTemplate
                             do View cung cấp. Padding trái 12 khớp popup item. -->
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="12,0,32,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource LbPopupBg}"
                                    BorderBrush="#33FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="0,4"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="260"
                                    Margin="0,4,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16"
                                                      ShadowDepth="2"
                                                      Opacity="0.5"
                                                      Color="Black"/>
                                </Border.Effect>
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         4) LbGridHeader* — 3 biến thể căn lề cho header.
         Header và cell dùng CÙNG Padding="16,0" để chữ thẳng cột.
         Chiều cao cố định 42, nền tối hơn body 1 chút, chữ mono
         in hoa màu muted trắng.
         ========================================================= -->
    <Style x:Key="LbGridHeaderBase" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource LbGlassHeaderBg}"/>
        <Setter Property="Foreground" Value="{StaticResource HomeTextOnDarkMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource LbRowDivider}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LbGridHeaderLeft" TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource LbGridHeaderBase}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style x:Key="LbGridHeaderCenter" TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource LbGridHeaderBase}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="LbGridHeaderRight" TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource LbGridHeaderBase}">
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <!-- =========================================================
         5) LbGridCell — padding ngang 16 khớp header, nội dung do
         CellTemplate tự căn lề. Foreground kế thừa từ DataGridRow
         (đã set trắng trong LbGridRow).
         ========================================================= -->
    <Style x:Key="LbGridCell" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground"
                Value="{Binding Foreground,
                        RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="16,0">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         6) LbGridRow — row cho cả 2 tab (EXP + Bộ đề).

         Thứ tự trigger quan trọng (sau thắng trước):
             zebra → hover → selected → gold → silver → bronze → IsMe
         → top 3 và IsMe sẽ không "nháy" khi hover (hành vi chủ đích).
         → IsMe luôn thắng top 1/2/3 (đặt sau cùng).

         Thanh nhấn trái 4px: mặc định trong suốt, đổi màu theo
         DataTrigger (gold/silver/bronze/accent).
         ========================================================= -->
    <Style x:Key="LbGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource HomeTextOnDark}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource LbRowDivider}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Border x:Name="accentBar"
                                    Width="4"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    IsHitTestVisible="False"/>
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    SnapsToDevicePixels="True"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>

                        <!-- Zebra hàng lẻ (cần AlternationCount=2 ở DataGrid) -->
                        <Trigger Property="AlternationIndex" Value="1">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{StaticResource LbRowZebra}"/>
                        </Trigger>

                        <!-- Hover hàng thường -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{StaticResource LbRowHover}"/>
                        </Trigger>

                        <!-- Selected -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{StaticResource LbRowSelected}"/>
                        </Trigger>

                        <!-- Top 1 — tint gold -->
                        <DataTrigger Binding="{Binding Rank}" Value="1">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{StaticResource LbRowGoldBg}"/>
                            <Setter TargetName="accentBar" Property="Background"
                                    Value="{StaticResource LbGold}"/>
                        </DataTrigger>

                        <!-- Top 2 — tint silver -->
                        <DataTrigger Binding="{Binding Rank}" Value="2">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{StaticResource LbRowSilverBg}"/>
                            <Setter TargetName="accentBar" Property="Background"
                                    Value="{StaticResource LbSilver}"/>
                        </DataTrigger>

                        <!-- Top 3 — tint bronze -->
                        <DataTrigger Binding="{Binding Rank}" Value="3">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{StaticResource LbRowBronzeBg}"/>
                            <Setter TargetName="accentBar" Property="Background"
                                    Value="{StaticResource LbBronze}"/>
                        </DataTrigger>

                        <!-- IsMe — đặt SAU CÙNG để luôn thắng top 1/2/3 -->
                        <DataTrigger Binding="{Binding IsMe}" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{StaticResource LbRowMeBg}"/>
                            <Setter TargetName="accentBar" Property="Background"
                                    Value="{StaticResource BrushAccent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         7) LbAvatar — vòng tròn glass chứa chữ cái đầu username.
         ========================================================= -->
    <Style x:Key="LbAvatar" TargetType="Border">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="{StaticResource LbAvatarBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LbAvatarBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <!-- =========================================================
         8) LbRankBadge* — huy hiệu tròn cho top 1/2/3.
         Gradient theo chiều dọc để có chiều sâu; chữ số bên trong
         là màu trắng (do CellTemplate set).
         ========================================================= -->
    <Style x:Key="LbRankBadgeBase" TargetType="Border">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="LbRankBadgeGold" TargetType="Border"
           BasedOn="{StaticResource LbRankBadgeBase}">
        <Setter Property="BorderBrush" Value="#FFE9A93B"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F5D77A" Offset="0"/>
                    <GradientStop Color="#D4A017" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LbRankBadgeSilver" TargetType="Border"
           BasedOn="{StaticResource LbRankBadgeBase}">
        <Setter Property="BorderBrush" Value="#FFE2E8F0"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#D8DDE6" Offset="0"/>
                    <GradientStop Color="#9AA1B0" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LbRankBadgeBronze" TargetType="Border"
           BasedOn="{StaticResource LbRankBadgeBase}">
        <Setter Property="BorderBrush" Value="#FFE3B583"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E3B583" Offset="0"/>
                    <GradientStop Color="#B87333" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         9) LbChip — "tem" glass cho các cột nhãn (CẤP/HẠNG/ĐỘ KHÓ).
         Biến thể màu ở Colors.xaml (LbChipLevelBg, LbChipEasyBg...).
         ========================================================= -->
    <Style x:Key="LbChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource LbChipBorder}"/>
        <Setter Property="Background" Value="{StaticResource LbChipBg}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Chip "Lv X" — nền cam nhạt, viền cam mờ, chữ cam sáng -->
    <Style x:Key="LbChipLevel" TargetType="Border"
           BasedOn="{StaticResource LbChip}">
        <Setter Property="Background" Value="{StaticResource LbChipLevelBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LbChipLevelBorder}"/>
    </Style>

    <!-- Chip "Bạn" — nền gradient cam đặc, chữ trắng, nhỏ gọn -->
    <Style x:Key="LbChipMe" TargetType="Border"
           BasedOn="{StaticResource LbChip}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF9A3D" Offset="0"/>
                    <GradientStop Color="#E8590C" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#66FF9A3D"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

</ResourceDictionary>