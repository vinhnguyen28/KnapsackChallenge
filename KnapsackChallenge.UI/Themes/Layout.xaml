<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
        <ResourceDictionary Source="Typography.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- =========================================================
         CARD — Surface + Rule border, radius 2, KHÔNG shadow
         ========================================================= -->
    <Style x:Key="CardPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushRule}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource CardPanel}"/>

    <!-- =========================================================
         FIELD LABEL
         ========================================================= -->
    <Style x:Key="FieldLabelBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushInkMuted}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelBase}"/>

    <!-- =========================================================
         BANNERS (Info = Success, Error = Danger)
         ========================================================= -->
    <Style x:Key="BannerBase" TargetType="Border">
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="Banner" TargetType="Border" BasedOn="{StaticResource BannerBase}"/>

    <Style x:Key="BannerSuccess" TargetType="Border" BasedOn="{StaticResource BannerBase}">
        <Setter Property="Background" Value="{StaticResource BrushSuccessSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding InfoMessage}" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding InfoMessage}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BannerDanger" TargetType="Border" BasedOn="{StaticResource BannerBase}">
        <Setter Property="Background" Value="{StaticResource BrushDangerSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InfoBanner" TargetType="Border" BasedOn="{StaticResource BannerSuccess}"/>
    <Style x:Key="ErrorBanner" TargetType="Border" BasedOn="{StaticResource BannerDanger}"/>

    <!-- =========================================================
         STAMP — "tem" trạng thái: viền 1px, nền trong, chữ mono 11px
         Dùng: <Border Style="{StaticResource StampOnline}">
                   <TextBlock Text="ONLINE" Style="{StaticResource MonoCaptionTextStyle}"/>
               </Border>
         ========================================================= -->
    <Style x:Key="StampBase" TargetType="Border">
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="StampOnline" TargetType="Border" BasedOn="{StaticResource StampBase}">
        <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}"/>
    </Style>

    <Style x:Key="StampOffline" TargetType="Border" BasedOn="{StaticResource StampBase}">
        <Setter Property="BorderBrush" Value="{StaticResource BrushInkMuted}"/>
    </Style>

    <Style x:Key="StampBanned" TargetType="Border" BasedOn="{StaticResource StampBase}">
        <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
    </Style>

    <Style x:Key="StampNeutral" TargetType="Border" BasedOn="{StaticResource StampBase}">
        <Setter Property="BorderBrush" Value="{StaticResource BrushRule}"/>
    </Style>

    <!-- Chữ cho stamp -->
    <Style x:Key="MonoCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushInk}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- =========================================================
         SECTION HEADER (mảnh, có rule dưới)
         ========================================================= -->
    <Style x:Key="SectionHeaderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource BrushRule}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,0,0,8"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

</ResourceDictionary>